---
import Base from '../builder/layouts/Base.astro';
import Breadcrumbs from '../builder/components/Breadcrumbs.astro';
import { brand } from '../builder/lib/brand';

const title = `Search — ${brand.name}`;
const description = `Search articles on ${brand.name}.`;
---
<Base title={title} description={description} indexable={false} skipTarget="#main">
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>
  <main id="main" class="container search-page">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Search' }]} />
    <section
      class="search-page__panel"
      data-section-type="search-panel"
      data-section-label="Search panel"
      data-section-variants="A:Default,B:Hero"
    >
      <h1 class="search-page__title">Search</h1>
      <form class="search-page__form" role="search" data-search-form>
        <label class="search-page__label" for="search-input">Search articles</label>
        <input
          type="search"
          id="search-input"
          name="q"
          autocomplete="off"
          autofocus
          placeholder="Type to search…"
          data-search-input
        />
      </form>
      <p class="search-page__status" data-search-status>Loading index…</p>
      <ol class="search-page__results" data-search-results></ol>
    </section>
  </main>

  <script>
    import MiniSearch from 'minisearch';

    const formEl   = document.querySelector('[data-search-form]');
    const inputEl  = document.querySelector('[data-search-input]');
    const statusEl = document.querySelector('[data-search-status]');
    const resultsEl= document.querySelector('[data-search-results]');

    let mini = null;
    let docs = [];

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    function highlight(text, terms) {
      if (!terms.length) return escapeHtml(text);
      const escaped = escapeHtml(text);
      const safeTerms = terms.map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
      const re = new RegExp(`(${safeTerms.join('|')})`, 'gi');
      return escaped.replace(re, '<mark>$1</mark>');
    }

    async function init() {
      try {
        const res = await fetch('/search.json');
        docs = await res.json();
        /* Tokenize on hyphens too so "the-fed" matches "fed", "tech-and-ai" matches "ai", etc.
         * MiniSearch's default tokenizer splits on whitespace + punctuation but
         * preserves hyphens inside compound tokens. We replace hyphens with spaces
         * before splitting so each segment becomes its own indexable token. */
        const tokenize = (text) => String(text).toLowerCase().replace(/[-]/g, ' ').split(/[\s.,;:!?()[\]{}'"]+/).filter(Boolean);
        mini = new MiniSearch({
          fields: ['title', 'excerpt', 'tags', 'body', 'categoryName'],
          storeFields: ['id', 'title', 'url', 'excerpt', 'category', 'categoryName', 'tags', 'date'],
          tokenize,
          searchOptions: {
            prefix: true,
            fuzzy: 0.2,
            combineWith: 'AND',
            boost: { title: 3, excerpt: 2, tags: 2, categoryName: 1, body: 1 },
          },
        });
        mini.addAll(docs.map((d) => ({ ...d, tags: (d.tags || []).join(' ') })));
        statusEl.textContent = `Type to search across ${docs.length} article${docs.length === 1 ? '' : 's'}.`;

        const params = new URLSearchParams(location.search);
        const q = params.get('q') ?? '';
        if (q) {
          inputEl.value = q;
          run(q);
        }
      } catch (err) {
        statusEl.textContent = 'Search index unavailable. Try again later.';
        console.error('search init failed', err);
      }
    }

    let timer = null;
    function debounced(fn, wait) {
      return (...args) => {
        clearTimeout(timer);
        timer = setTimeout(() => fn(...args), wait);
      };
    }

    function run(q) {
      if (!mini) return;
      const trimmed = q.trim();
      if (!trimmed) {
        resultsEl.innerHTML = '';
        statusEl.textContent = `Type to search across ${docs.length} article${docs.length === 1 ? '' : 's'}.`;
        return;
      }
      const hits = mini.search(trimmed);
      const total = hits.length;
      const capped = hits.slice(0, 50);
      const terms = trimmed.split(/\s+/).filter(Boolean);
      if (total === 0) {
        statusEl.textContent = `No results for "${trimmed}".`;
        resultsEl.innerHTML = '';
        return;
      }
      const overflow = total > 50 ? ' (refine your query to narrow further)' : '';
      statusEl.textContent = `Showing ${capped.length} of ${total} result${total === 1 ? '' : 's'} for "${trimmed}"${overflow}.`;
      resultsEl.innerHTML = capped.map((h) => `
        <li class="search-result">
          <a class="search-result__link" href="${h.url}">
            <h2 class="search-result__title">${highlight(h.title, terms)}</h2>
            <p class="search-result__meta"><span class="search-result__category">${escapeHtml(h.categoryName || h.category)}</span> · <time>${h.date}</time></p>
            <p class="search-result__excerpt">${highlight(h.excerpt || '', terms)}</p>
          </a>
        </li>
      `).join('');
    }

    formEl.addEventListener('submit', (e) => {
      e.preventDefault();
      run(inputEl.value);
    });

    const updateUrl = debounced((q) => {
      const u = new URL(location.href);
      if (q.trim()) u.searchParams.set('q', q.trim()); else u.searchParams.delete('q');
      history.replaceState({}, '', u.toString());
    }, 150);

    inputEl.addEventListener('input', debounced(() => {
      run(inputEl.value);
      updateUrl(inputEl.value);
    }, 150));

    init();
  </script>
</Base>
