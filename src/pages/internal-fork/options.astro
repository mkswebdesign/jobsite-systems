      background:
        radial-gradient(ellipse 70% 60% at 18% 0%, rgba(255, 255, 255, 0.3), transparent 60%),
        radial-gradient(ellipse 60% 50% at 85% 100%, rgba(0, 0, 0, 0.22), transparent 55%);
