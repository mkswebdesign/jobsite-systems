    /* ---- Final CTA preview (Section · CTA) ---- */
    #opt-root [class^="opt-ctapv-"] { box-sizing: border-box; }
    #opt-root .opt-ctapv-a, #opt-root .opt-ctapv-b, #opt-root .opt-ctapv-c {
      position: relative;
      height: 96px;
      padding: 10px;
      overflow: hidden;
