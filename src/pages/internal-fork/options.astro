    }
    #opt-root .grv-timeline-event[data-kind="restored"]::before {
      border-color: #22c55e;
      box-shadow: 0 0 8px rgba(34, 197, 94, .35);
    }
    #opt-root .grv-timeline-event[data-latest="1"]::before {
      background: var(--accent);
      border-color: var(--accent);
    }
    #opt-root .grv-timeline-line {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: .25rem .5rem;
      font-size: .85rem;
      color: var(--text-primary);
    }
    #opt-root .grv-timeline-kind {
      font: 700 .68rem/1 ui-monospace, Menlo, monospace;
      letter-spacing: .12em;
      text-transform: uppercase;
      padding: .2rem .45rem;
      border-radius: 999px;
      background: var(--bg-secondary);
      color: var(--text-muted);
    }
    #opt-root .grv-timeline-event[data-kind="removed"] .grv-timeline-kind { color: #f87171; background: color-mix(in srgb, #f43f5e 14%, var(--bg-secondary)); }
    #opt-root .grv-timeline-event[data-kind="restored"] .grv-timeline-kind { color: #4ade80; background: color-mix(in srgb, #22c55e 14%, var(--bg-secondary)); }
    #opt-root .grv-timeline-where code {
      font: inherit;
      font-family: ui-monospace, Menlo, monospace;
      font-size: .8rem;
      color: var(--text-secondary);
      background: var(--bg-secondary);
      padding: .1rem .35rem;
      border-radius: 4px;
    }
    #opt-root .grv-timeline-when {
      font: .72rem ui-monospace, Menlo, monospace;
      color: var(--text-muted);
    }
    #opt-root .grv-timeline-empty {
      color: var(--text-muted);
      font-size: .85rem;
      font-style: italic;
    }
    /* Snapshot bar — appears under a lifecycle event when it carries a
       `priorSection`. Lets the user roll back to that earlier shape of
       the section instead of the entry's current `section` (which is
       the latest snapshot). */
    #opt-root .grv-timeline-snapshot {
      display: flex;
      align-items: center;
      gap: .55rem;
      flex-wrap: wrap;
      margin-top: .35rem;
      padding: .35rem .55rem;
      background: color-mix(in srgb, var(--accent) 8%, transparent);
      border: 1px dashed color-mix(in srgb, var(--accent) 35%, var(--border));
      border-radius: 6px;
    }
    #opt-root .grv-timeline-snapshot-note {
      font: .72rem/1.3 ui-sans-serif, system-ui, sans-serif;
      color: var(--text-secondary);
      flex: 1 1 auto;
      min-width: 0;
    }
    #opt-root .grv-timeline-snapshot-btn {
      font: 600 .72rem ui-sans-serif, system-ui, sans-serif;
      color: var(--text-primary);
      background: var(--bg-card);
      border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--border));
      border-radius: 999px;
      padding: .3rem .65rem;
      cursor: pointer;
      transition: background 120ms ease, color 120ms ease, border-color 120ms ease;
      flex: 0 0 auto;
    }
    #opt-root .grv-timeline-snapshot-btn:hover {
      background: color-mix(in srgb, var(--accent) 18%, var(--bg-card));
      border-color: var(--accent);
    }
    #opt-root .grv-timeline-snapshot-btn.is-copied {
      background: color-mix(in srgb, var(--accent) 25%, var(--bg-card));
      color: var(--accent);
    }

    /* Dependencies block — snapshot of brand-collection items the
       section referenced at remove time. Grouped by collection name,
       items rendered as compact summary lines (most informative field
       first) with a "Show all fields" details toggle. */
    #opt-root .grv-modal-deps {
      border-top: 1px dashed var(--border);
      padding-top: .85rem;
    }
    #opt-root .grv-modal-deps-meta {
      font-weight: 600;
      letter-spacing: .04em;
      color: #fcd34d;
      background: color-mix(in srgb, #fbbf24 12%, transparent);
      border: 1px solid color-mix(in srgb, #fbbf24 35%, var(--border));
      padding: .1rem .4rem;
      border-radius: 999px;
      font-size: .7rem;
      margin-left: .35rem;
    }
    #opt-root .grv-modal-deps-help {
      margin: 0 0 .65rem;
      color: var(--text-muted);
      font-size: .78rem;
      line-height: 1.5;
    }
    #opt-root .grv-modal-deps-help strong { color: var(--text-primary); }
    #opt-root .grv-modal-deps-body {
      display: flex;
      flex-direction: column;
      gap: .6rem;
    }
    #opt-root .grv-modal-deps-group {
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--bg-secondary);
      padding: .55rem .7rem;
    }
    #opt-root .grv-modal-deps-group-name {
      margin: 0 0 .35rem;
      font: 700 .68rem/1 ui-monospace, Menlo, monospace;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--accent);
    }
    #opt-root .grv-modal-deps-group-name code {
      font: inherit;
      font-family: ui-monospace, Menlo, monospace;
      color: var(--text-muted);
      letter-spacing: 0;
      text-transform: none;
      margin-left: .35rem;
    }
    #opt-root .grv-modal-deps-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: .35rem;
    }
    #opt-root .grv-modal-deps-item {
      display: grid;
      grid-template-columns: max-content 1fr;
      gap: .55rem;
      align-items: baseline;
      padding: .4rem .55rem;
      background: var(--bg-primary);
      border: 1px solid var(--border);
      border-radius: 6px;
      font-size: .8rem;
      color: var(--text-primary);
    }
    #opt-root .grv-modal-deps-item-id {
      font: 700 .65rem/1 ui-monospace, Menlo, monospace;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--text-muted);
    }
    #opt-root .grv-modal-deps-item-summary {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    #opt-root .grv-modal-deps-item-fields {
      grid-column: 1 / -1;
      margin-top: .35rem;
    }
    #opt-root .grv-modal-deps-item-fields summary {
      cursor: pointer;
      font: .7rem ui-sans-serif, system-ui, sans-serif;
      color: var(--text-muted);
      list-style: none;
      padding: .1rem 0;
    }
    #opt-root .grv-modal-deps-item-fields summary::before {
      content: '▸';
      display: inline-block;
      margin-right: .3rem;
      transition: transform .15s ease;
    }
    #opt-root .grv-modal-deps-item-fields[open] summary::before { transform: rotate(90deg); }
    #opt-root .grv-modal-deps-item-fields pre {
      margin: .3rem 0 0;
      padding: .45rem .55rem;
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 6px;
      font: 11px/1.5 ui-monospace, Menlo, monospace;
      color: var(--text-secondary);
      max-height: 160px;
      overflow-y: auto;
      white-space: pre;
    }

    /* ---- Detail modal ---- */
    #opt-root .grv-modal[hidden] { display: none; }
    #opt-root .grv-modal {
      position: fixed;
      inset: 0;
      z-index: 9000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem 1rem;
    }
    #opt-root .grv-modal-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, .55);
      backdrop-filter: blur(4px);
    }
    #opt-root .grv-modal-panel {
      position: relative;
      width: min(720px, 100%);
      max-height: calc(100vh - 4rem);
      display: flex;
      flex-direction: column;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 14px;
      box-shadow: 0 30px 80px rgba(0,0,0,.5);
      overflow: hidden;
      animation: grv-modal-in .14s ease;
    }
    @keyframes grv-modal-in {
      from { opacity: 0; transform: translateY(8px) scale(.985); }
      to   { opacity: 1; transform: none; }
    }
    #opt-root .grv-modal-head {
      display: flex;
      align-items: flex-start;
      gap: .75rem;
      padding: 1.1rem 1.25rem .75rem;
      border-bottom: 1px solid var(--border);
    }
    #opt-root .grv-modal-eyebrow {
      margin: 0 0 .2rem;
      font: 700 .65rem/1 ui-monospace, Menlo, monospace;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--text-muted);
    }
    #opt-root .grv-modal-eyebrow code {
      color: var(--text-secondary);
      font-family: ui-monospace, Menlo, monospace;
      text-transform: none;
      letter-spacing: 0;
    }
    #opt-root .grv-modal-title {
      flex: 1;
      margin: 0;
      font: 700 1.1rem/1.25 ui-sans-serif, system-ui, sans-serif;
      letter-spacing: -.01em;
      color: var(--text-primary);
    }
    #opt-root .grv-modal-close {
      flex: 0 0 auto;
      background: transparent;
      border: 0;
      color: var(--text-muted);
      font-size: 22px;
      line-height: 1;
      padding: .15rem .4rem;
      border-radius: 6px;
      cursor: pointer;
    }
    #opt-root .grv-modal-close:hover {
      background: var(--bg-secondary);
      color: var(--text-primary);
    }
    #opt-root .grv-modal-body {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      padding: 1rem 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    #opt-root .grv-modal-preview { display: flex; flex-direction: column; gap: .65rem; }
    #opt-root .grv-modal-preview img.grv-preview-bg {
      display: block;
      width: 100%;
      height: 180px;
      object-fit: cover;
      border-radius: 8px;
      border: 1px solid var(--border);
    }
    #opt-root .grv-preview-eyebrow {
      margin: 0;
      font: 700 .68rem/1 ui-sans-serif, system-ui, sans-serif;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--accent);
    }
    #opt-root .grv-preview-heading {
      margin: 0;
      font: 700 1.5rem/1.2 ui-sans-serif, system-ui, sans-serif;
      letter-spacing: -.01em;
      color: var(--text-primary);
      white-space: pre-wrap;
    }
    #opt-root .grv-preview-subtext {
      margin: 0;
      color: var(--text-secondary);
      font-size: .92rem;
      line-height: 1.55;
    }
    #opt-root .grv-preview-cta {
      display: inline-flex;
      align-items: baseline;
      gap: .5rem;
      align-self: flex-start;
      padding: .35rem .65rem .35rem .85rem;
      background: color-mix(in srgb, var(--accent) 15%, var(--bg-secondary));
      border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border));
      border-radius: 999px;
      font: 600 .85rem ui-sans-serif, system-ui, sans-serif;
      color: var(--text-primary);
    }
    #opt-root .grv-preview-cta code {
      font: inherit;
      font-family: ui-monospace, Menlo, monospace;
      font-size: .72rem;
      color: var(--text-muted);
      background: color-mix(in srgb, var(--bg-primary) 35%, transparent);
      padding: .15rem .4rem;
      border-radius: 4px;
    }
    /* StatRibbon preview — proof points laid out as a small grid that
       echoes the live section without competing with surrounding modal
       chrome. Renders inside the graveyard modal and the card preview. */
    #opt-root .grv-preview-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(140px, 100%), 1fr));
      gap: .85rem;
      margin: 0;
      padding: .35rem 0;
    }
    #opt-root .grv-preview-stat {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: .15rem;
      min-width: 0;
    }
    #opt-root .grv-preview-stat-value {
      font: 800 1.45rem/1 ui-sans-serif, system-ui, sans-serif;
      letter-spacing: -.02em;
      color: var(--accent);
      font-variant-numeric: tabular-nums;
    }
    #opt-root .grv-preview-stat-label {
      font-size: .78rem;
      font-weight: 600;
      line-height: 1.3;
      color: var(--text-primary);
    }
    #opt-root .grv-preview-stat-sublabel {
      font-size: .68rem;
      font-weight: 500;
      color: var(--text-muted);
    }
    /* Generic key-value list — fallback preview for any unknown section type. */
    #opt-root .grv-preview-kv {
      display: grid;
      grid-template-columns: max-content 1fr;
      gap: .35rem .85rem;
      align-items: baseline;
      margin: 0;
      padding: .75rem 0 0;
      border-top: 1px dashed var(--border);
    }
    #opt-root .grv-preview-kv dt {
      font: 700 .7rem/1.3 ui-monospace, Menlo, monospace;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: .08em;
      white-space: nowrap;
    }
    #opt-root .grv-preview-kv dd {
      margin: 0;
      color: var(--text-primary);
      font-size: .88rem;
      line-height: 1.45;
      word-break: break-word;
    }
    #opt-root .grv-preview-kv dd.is-complex {
      font: .8rem ui-monospace, Menlo, monospace;
      color: var(--text-secondary);
      background: var(--bg-secondary);
      padding: .35rem .55rem;
      border-radius: 6px;
      max-height: 120px;
      overflow-y: auto;
      white-space: pre;
    }
    #opt-root .grv-modal-json-wrap {
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--bg-secondary);
    }
    #opt-root .grv-modal-json-wrap > summary {
      cursor: pointer;
      padding: .55rem .75rem;
      font: 600 .8rem ui-sans-serif, system-ui, sans-serif;
      color: var(--text-secondary);
      list-style: none;
    }
    #opt-root .grv-modal-json-wrap > summary::before {
      content: '▸';
      display: inline-block;
      margin-right: .4rem;
      transition: transform .15s ease;
      color: var(--text-muted);
    }
    #opt-root .grv-modal-json-wrap[open] > summary::before { transform: rotate(90deg); }
    #opt-root .grv-modal-json-wrap > summary:hover { color: var(--text-primary); }
    #opt-root .grv-modal-json {
      margin: 0;
      padding: .65rem .8rem;
      background: var(--bg-primary);
      border-top: 1px solid var(--border);
      font: 11.5px/1.55 ui-monospace, Menlo, monospace;
      color: var(--text-secondary);
      overflow-x: auto;
      max-height: 320px;
      overflow-y: auto;
      white-space: pre;
    }
    #opt-root .grv-modal-restore-status {
      margin: 0;
      padding: .55rem .75rem;
      background: color-mix(in srgb, var(--accent) 12%, var(--bg-secondary));
      border: 1px dashed color-mix(in srgb, var(--accent) 50%, var(--border));
      border-radius: 7px;
      font-size: .82rem;
      color: var(--text-primary);
      line-height: 1.45;
    }
    #opt-root .grv-modal-restore-status a {
      color: var(--accent);
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    #opt-root .grv-modal-foot {
      display: flex;
      justify-content: flex-end;
      gap: .4rem;
      padding: .85rem 1.25rem;
      border-top: 1px solid var(--border);
      background: color-mix(in srgb, var(--bg-primary) 55%, var(--bg-card));
    }
    #opt-root .grv-modal-foot .grv-act { flex: 0 0 auto; }

    /* ---- Toolbar (sticky top bar: filters, search, actions) ---- */
    #opt-root .opt-toolbar {
      position: sticky;
      top: 72px;
      z-index: 50;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: .6rem .75rem;
      padding: .85rem 1rem;
      margin-bottom: 1.5rem;
      background: color-mix(in srgb, var(--bg-primary) 92%, transparent);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: 0 4px 18px -10px rgba(0,0,0,.35);
    }
    #opt-root .opt-filters {
      display: flex;
      gap: .3rem;
      flex-wrap: wrap;
    }
    #opt-root .opt-filter-pill {
      padding: .4rem .85rem;
      font: 700 .72rem/1 ui-monospace, Menlo, monospace;
      letter-spacing: .1em;
      text-transform: uppercase;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 999px;
      color: var(--text-muted);
      cursor: pointer;
      transition: color .15s ease, border-color .15s ease, background .15s ease;
    }
    #opt-root .opt-filter-pill:hover { color: var(--text-primary); border-color: var(--accent); }
    #opt-root .opt-filter-pill[aria-pressed="true"] {
      background: color-mix(in srgb, var(--accent) 14%, var(--bg-card));
      border-color: var(--accent);
      color: var(--text-primary);
    }
    #opt-root .opt-search-wrap {
      position: relative;
      flex: 0 1 180px;
      min-width: 140px;
      display: flex;
      transition: flex-basis .22s ease, flex-grow .22s ease;
    }
    #opt-root .opt-search-wrap:focus-within {
      flex: 1 1 280px;
    }
    #opt-root .opt-search {
      flex: 1;
      min-width: 0;
      padding: .55rem 2.25rem .55rem .85rem;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text-primary);
      font: inherit;
      font-size: .9rem;
    }
    #opt-root .opt-search:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 28%, transparent);
    }
    #opt-root .opt-search-clear {
      position: absolute;
      right: .4rem;
      top: 50%;
      transform: translateY(-50%);
      width: 22px;
      height: 22px;
      border-radius: 50%;
      border: none;
      background: var(--bg-secondary);
      color: var(--text-muted);
      font: 700 14px/1 ui-monospace, Menlo, monospace;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      transition: background .15s ease, color .15s ease;
    }
    #opt-root .opt-search-clear:hover {
      background: var(--border);
      color: var(--text-primary);
    }
    #opt-root .opt-actions {
      display: flex;
      align-items: center;
      gap: .4rem;
      flex-wrap: wrap;
      margin-left: auto;
    }
    /* Compact toolbar buttons — global .btn padding is page-CTA sized */
    #opt-root .opt-actions .btn {
      padding: .5rem .9rem;
      font-size: .82rem;
      border-radius: 8px;
      height: 34px;
      line-height: 1;
    }
    #opt-root .opt-actions .btn-primary {
      box-shadow: 0 2px 10px -2px rgba(var(--accent-rgb),.35);
    }
    #opt-root .opt-actions .btn-primary:hover {
      transform: none;
      box-shadow: 0 4px 14px -2px rgba(var(--accent-rgb),.45);
    }
    /* Apply → icon-only check. Minimal footprint in every state. */
    #opt-root .opt-actions .opt-apply-btn {
      width: 34px;
      padding: 0;
      flex: 0 0 auto;
      font-size: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    #opt-root .opt-apply-icon {
      display: inline-block;
      font: 900 18px/1 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      color: inherit;
    }
    #opt-root .opt-actions .opt-apply-btn:disabled { opacity: .45; cursor: not-allowed; }
    /* Real .btn-ghost — base.css only ships .btn / .btn-primary / .btn-secondary,
       so without this Reload/Default render as bare text on the translucent toolbar. */
    #opt-root .btn-ghost {
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: var(--text-primary);
      transition: color .15s ease, border-color .15s ease, background .15s ease;
    }
    #opt-root .btn-ghost:hover,
    #opt-root .btn-ghost:focus-visible {
      border-color: var(--accent);
      background: color-mix(in srgb, var(--accent) 8%, var(--bg-card));
      color: var(--text-primary);
    }
    #opt-root .opt-dice-btn {
      border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
      color: var(--accent);
    }
    #opt-root .opt-dice-btn:hover {
      border-color: var(--accent);
      background: color-mix(in srgb, var(--accent) 10%, transparent);
      color: var(--accent);
    }

    /* Collapse/expand toggle — shrinks the toolbar to just its top row.
       Sits at the end of .opt-actions; visual divider keeps it from reading
       as a caret on the Default button. */
    #opt-root .opt-collapse-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      padding: 0;
      margin-left: .35rem;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text-muted);
      cursor: pointer;
      position: relative;
      transition: color .15s ease, border-color .15s ease, background .15s ease;
    }
    #opt-root .opt-collapse-btn::before {
      content: '';
      position: absolute;
      left: -.4rem;
      top: 6px;
      bottom: 6px;
      width: 1px;
      background: var(--border);
    }
    #opt-root .opt-collapse-btn:hover { color: var(--text-primary); border-color: var(--accent); }
    #opt-root .opt-collapse-caret {
      display: inline-block;
      font: 700 .85rem/1 ui-monospace, Menlo, monospace;
      transition: transform .2s ease;
    }
    #opt-root .opt-toolbar:not(.is-collapsed) .opt-collapse-caret { transform: rotate(180deg); }
    #opt-root .opt-toolbar.is-collapsed > .opt-subfilters,
    #opt-root .opt-toolbar.is-collapsed > .opt-meta {
      display: none !important;
    }
    #opt-root .opt-dice-btn.is-rolling {
      animation: optDiceRoll .55s cubic-bezier(.5,1.4,.4,1);
    }
    @keyframes optDiceRoll {
      0%   { transform: rotate(0) scale(1); }
      40%  { transform: rotate(180deg) scale(1.08); }
      80%  { transform: rotate(340deg) scale(.96); }
      100% { transform: rotate(360deg) scale(1); }
    }

    /* ---- Mobile polish ---------------------------------------------------
       Goal: single tight sticky row on small screens; dice stays out at all
       times; collapsed state is one compact line (search + dice + apply +
       caret) so the panel never eats more than ~52px of vertical room.    */
    @media (max-width: 720px) {
      #opt-root .opt-toolbar {
        top: 60px;
        padding: .45rem .55rem;
        gap: .35rem .4rem;
        margin-bottom: 1rem;
        border-radius: 12px;
        box-shadow: 0 6px 22px -12px rgba(0,0,0,.5);
      }
      #opt-root .opt-filters {
        order: 2;
        flex: 1 1 100%;
        gap: .25rem;
      }
      #opt-root .opt-filter-pill {
        padding: .3rem .6rem;
        font-size: .62rem;
        letter-spacing: .08em;
      }
      #opt-root .opt-search-wrap {
        order: 1;
        flex: 1 1 100%;
        min-width: 0;
      }
      #opt-root .opt-search {
        padding: .45rem 2rem .45rem .65rem;
        font-size: .82rem;
      }
      #opt-root .opt-actions {
        order: 3;
        flex: 1 1 100%;
        margin-left: 0;
        gap: .3rem;
      }
      #opt-root .opt-actions .btn {
        padding: .4rem .65rem;
        height: 32px;
        font-size: .72rem;
      }
      #opt-root .opt-actions .opt-apply-btn {
        width: 32px;
        height: 32px;
        padding: 0;
        flex: 0 0 auto;
      }
      #opt-root .opt-apply-icon { font-size: 16px; }
      #opt-root .opt-collapse-btn {
        width: 32px;
        height: 32px;
        margin-left: .25rem;
      }
      /* Dice → icon-only square, accent-tinted, always present on every
         collapsed/expanded state so a single tap is never more than a thumb
         away. */
      #opt-root .opt-dice-btn {
        width: 32px;
        padding: 0;
        font-size: 0;
        flex: 0 0 auto;
      }
      #opt-root .opt-dice-btn::after {
        content: '\2684';
        display: block;
        font-size: 18px;
        line-height: 1;
        color: var(--accent);
      }

      /* Collapsed state on mobile: drop filter row + secondary actions so
         only search · dice · apply · caret remain on a single line.
         Search shrinks to ~search-icon width and grows on focus-within. */
      #opt-root .opt-toolbar.is-collapsed > .opt-filters { display: none; }
      #opt-root .opt-toolbar.is-collapsed .opt-search-wrap {
        flex: 0 1 44px;
        min-width: 44px;
        transition: flex-basis .22s ease, flex-grow .22s ease;
      }
      #opt-root .opt-toolbar.is-collapsed .opt-search-wrap:focus-within {
        flex: 1 1 0;
      }
      #opt-root .opt-toolbar.is-collapsed .opt-actions {
        flex: 0 0 auto;
      }
      #opt-root .opt-toolbar.is-collapsed #opt-reload,
      #opt-root .opt-toolbar.is-collapsed #opt-default { display: none; }
    }

    /* Sub-filter pills — deeper tag level under Sections / Pages */
    #opt-root .opt-subfilters {
      flex-basis: 100%;
      display: flex;
      flex-wrap: wrap;
      gap: .3rem;
      padding-top: .55rem;
      margin-top: .1rem;
      border-top: 1px dashed var(--border);
    }
    #opt-root .opt-subfilter-pill {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      padding: .32rem .75rem;
      font: 700 .68rem/1 ui-monospace, Menlo, monospace;
      letter-spacing: .1em;
      text-transform: uppercase;
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 999px;
      color: var(--text-muted);
      cursor: pointer;
      transition: color .15s ease, border-color .15s ease, background .15s ease;
    }
    #opt-root .opt-subfilter-pill:hover { color: var(--text-primary); border-color: var(--border-light); }
    #opt-root .opt-subfilter-pill[aria-pressed="true"] {
      background: color-mix(in srgb, var(--accent) 12%, var(--bg-card));
      border-color: var(--accent);
      color: var(--text-primary);
    }
    #opt-root .opt-subfilter-pill[data-modified="true"]::before {
      content: '';
      width: 5px; height: 5px; border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 6px var(--accent);
    }
    #opt-root .opt-subfilter-count {
      opacity: .55;
      font-size: .7em;
      font-weight: 700;
    }

    /* Meta row (toggles, clear, count, status) */
    #opt-root .opt-meta {
      flex-basis: 100%;
      display: flex;
      align-items: center;
      gap: .85rem;
      padding-top: .55rem;
      flex-wrap: wrap;
    }
    #opt-root .opt-toggle {
      display: inline-flex;
      align-items: center;
      gap: .45rem;
      font-size: .78rem;
      color: var(--text-muted);
      cursor: pointer;
      user-select: none;
    }
    #opt-root .opt-toggle input[type="checkbox"] {
      appearance: none;
      -webkit-appearance: none;
      width: 30px;
      height: 16px;
      border-radius: 999px;
      background: var(--border);
      position: relative;
      cursor: pointer;
      margin: 0;
      transition: background .15s ease;
    }
    #opt-root .opt-toggle input[type="checkbox"]::after {
      content: '';
      position: absolute;
      left: 2px;
      top: 2px;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--bg-primary);
      transition: transform .15s ease;
    }
    #opt-root .opt-toggle input[type="checkbox"]:checked { background: var(--accent); }
    #opt-root .opt-toggle input[type="checkbox"]:checked::after { transform: translateX(14px); }
    #opt-root .opt-toggle:hover { color: var(--text-primary); }
    #opt-root .opt-clear-filters {
      background: none;
      border: none;
      color: var(--accent);
      font: 600 .78rem/1 inherit;
      cursor: pointer;
      padding: .35rem .55rem;
      border-radius: 6px;
    }
    #opt-root .opt-clear-filters:hover { background: color-mix(in srgb, var(--accent) 10%, transparent); }
    #opt-root .opt-count {
      font-size: .78rem;
      color: var(--text-muted);
      font-variant-numeric: tabular-nums;
    }
    #opt-root .opt-status {
      flex: 1 1 100%;
      font-size: .78rem;
      color: var(--text-muted);
      padding-top: .15rem;
    }
    #opt-root .opt-status.is-ok { color: #10b981; }

    /* ---- Grid ---- */
    #opt-root .opt-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.25rem;
      margin: 0 0 2rem;
    }
    #opt-root .opt-card {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding: 1.25rem;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      cursor: pointer;
      text-align: left;
      color: inherit;
      font: inherit;
      transition: border-color .18s ease, transform .18s ease, box-shadow .18s ease;
    }
    #opt-root .opt-card[hidden] { display: none !important; }
    #opt-root .opt-card:hover { border-color: var(--accent); transform: translateY(-2px); }
    #opt-root .opt-card[aria-checked="true"] {
      border-color: var(--accent);
      box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 35%, transparent);
    }
    #opt-root .opt-kind-label {
      position: absolute;
      top: .65rem;
      left: .75rem;
      font: 700 .6rem ui-monospace, Menlo, monospace;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--text-muted);
      opacity: .65;
      pointer-events: none;
    }
    #opt-root .opt-current {
      position: absolute;
      top: .65rem;
      right: .75rem;
      font-size: .65rem;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--accent);
      opacity: 0;
      transition: opacity .18s ease;
    }
    #opt-root .opt-card.is-current .opt-current { opacity: 1; }
    #opt-root .opt-card-preview {
      height: 84px;
      margin-top: .75rem;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--bg-secondary);
      padding: 0 .75rem;
      display: flex;
      align-items: center;
      gap: .5rem;
      overflow: hidden;
    }
    #opt-root .opt-pv-logo {
      font: 700 10px ui-monospace, Menlo, monospace;
      color: var(--text-primary);
      letter-spacing: .12em;
    }
    #opt-root .opt-pv-links { display: flex; gap: .35rem; align-items: center; flex: 1; justify-content: flex-end; }
    #opt-root .opt-pv-links > span:not(.opt-pv-cta) {
      width: 22px; height: 4px; border-radius: 2px;
      background: var(--text-muted); opacity: .55;
    }
    #opt-root .opt-pv-cta {
      font: 700 9px ui-monospace, Menlo, monospace;
      letter-spacing: .1em;
      padding: .25rem .55rem;
      border-radius: 4px;
      background: var(--accent);
      color: var(--bg-primary);
    }
    /* Variant B preview — Spotlight (full-bleed glass bar) */
    #opt-root .opt-preview-b {
      padding: 0;
      position: relative;
      background:
        linear-gradient(135deg, color-mix(in srgb, var(--accent) 9%, transparent), transparent 60%),
        var(--bg-secondary);
    }
    #opt-root .opt-pv-bar {
      position: relative;
      display: flex; align-items: center; gap: .55rem;
      width: 100%; height: 100%;
      padding: 0 .85rem;
      background: color-mix(in srgb, var(--bg-primary) 55%, transparent);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-bottom: 1px solid color-mix(in srgb, var(--accent) 18%, transparent);
    }
    #opt-root .opt-pv-underline {
      position: absolute; left: 50%; bottom: -1px;
      transform: translateX(-50%);
      width: 60px; height: 1px;
      background: linear-gradient(90deg, transparent, var(--accent), transparent);
      opacity: .9;
    }
    #opt-root .opt-pv-cta-bold {
      letter-spacing: .12em;
      box-shadow: 0 4px 10px -2px rgba(var(--accent-rgb), .55);
    }
    /* Variant C preview — Capsule (floating pill) */
    #opt-root .opt-preview-c { justify-content: center; padding: 0; }
    #opt-root .opt-pv-pill {
      display: flex; align-items: center; gap: .5rem;
      padding: .3rem .55rem .3rem .75rem;
      background: color-mix(in srgb, var(--bg-card) 80%, transparent);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1px solid color-mix(in srgb, var(--text-primary) 8%, transparent);
      border-radius: 999px;
      box-shadow: 0 8px 22px -8px rgba(0,0,0,.4), inset 0 1px 0 rgba(255,255,255,.06);
    }
    #opt-root .opt-pv-links-tight { gap: .35rem; flex: 0 0 auto; }
    #opt-root .opt-pv-links-tight > span { width: 14px; }

    /* Capsule (C) wide variant */
    #opt-root .opt-pv-pill-wide {
      width: 100%;
      padding-left: .85rem; padding-right: .55rem;
      justify-content: space-between;
    }
    #opt-root .opt-pv-pill-wide .opt-pv-links { flex: 1; justify-content: center; }

    /* Variant D preview — Atlas (wide sidebar, horizontal text) */
    #opt-root .opt-preview-d { padding: 0; align-items: stretch; position: relative; }
    #opt-root .opt-pv-rail {
      display: flex; flex-direction: column;
      align-items: stretch; justify-content: flex-start;
      width: 78px; height: 100%;
      padding: .55rem .5rem;
      gap: .4rem;
      background: color-mix(in srgb, var(--bg-primary) 94%, transparent);
      border-right: 1px solid var(--border);
      flex: 0 0 auto;
    }
    #opt-root .opt-pv-rail .opt-pv-logo {
      font-size: 8px;
      letter-spacing: .12em;
      padding: .15rem .25rem;
    }
    #opt-root .opt-pv-rail-links {
      display: flex; flex-direction: column;
      gap: .2rem;
      flex: 1;
      align-items: stretch;
    }
    #opt-root .opt-pv-rail-link {
      position: relative;
      height: 5px;
      border-radius: 2px;
      background: var(--text-muted);
      opacity: .35;
    }
    #opt-root .opt-pv-rail-link.is-active {
      background: color-mix(in srgb, var(--accent) 80%, transparent);
      opacity: .9;
    }
    #opt-root .opt-pv-rail-link.is-active::before {
      content: '';
      position: absolute;
      left: -.5rem; top: 50%;
      transform: translateY(-50%);
      width: 2px; height: 70%;
      background: var(--accent);
      border-radius: 1px;
    }
    #opt-root .opt-pv-cta-rail {
      writing-mode: horizontal-tb;
      padding: .25rem .35rem;
      font-size: 7px;
      text-align: center;
      margin-top: auto;
    }
    #opt-root .opt-pv-rail-body {
      flex: 1;
      display: flex; flex-direction: column;
      gap: .35rem; padding: .65rem .8rem;
      background:
        linear-gradient(135deg, color-mix(in srgb, var(--accent) 6%, transparent), transparent 60%),
        var(--bg-secondary);
    }
    #opt-root .opt-pv-rail-bodyline {
      height: 4px; border-radius: 2px;
      background: var(--text-muted); opacity: .35;
    }
    #opt-root .opt-pv-rail-bodyline-short { width: 60%; }

    /* Variant E preview — Reveal (minimal + overlay) */
    #opt-root .opt-preview-e { position: relative; justify-content: space-between; gap: 0; }
    #opt-root .opt-preview-e .opt-pv-spacer { flex: 1; }
    #opt-root .opt-pv-burger {
      width: 22px; height: 16px;
      display: flex; flex-direction: column; justify-content: space-between;
      flex: 0 0 auto;
    }
    #opt-root .opt-pv-burger > span {
      display: block;
      width: 100%; height: 2px;
      background: var(--text-primary);
      border-radius: 2px;
    }
    #opt-root .opt-pv-overlay-hint {
      position: absolute;
      inset: 0;
      display: flex; align-items: center; justify-content: center;
      font: 700 9px ui-monospace, Menlo, monospace;
      letter-spacing: .25em;
      color: var(--text-muted);
      opacity: 0;
      background: color-mix(in srgb, var(--bg-primary) 88%, transparent);
      backdrop-filter: blur(4px);
      transition: opacity .25s ease;
      border-radius: inherit;
    }
    #opt-root .opt-card:hover .opt-preview-e .opt-pv-overlay-hint { opacity: 1; }

    /* Variant F preview — Dock (bottom capsule) */
    #opt-root .opt-preview-f {
      align-items: flex-end;
      justify-content: center;
      padding-bottom: .55rem;
    }
    #opt-root .opt-pv-pill-bottom { /* shares .opt-pv-pill */
      box-shadow:
        0 -2px 8px -2px rgba(0, 0, 0, .15),
        0 8px 22px -8px rgba(0, 0, 0, .4),
        inset 0 1px 0 rgba(255, 255, 255, .06);
    }

    /* Variant G preview — Mega Menu (bar + dropdown panel hint) */
    #opt-root .opt-preview-g {
      align-items: flex-start;
      justify-content: flex-start;
      flex-direction: column;
      gap: .35rem;
      padding: .55rem .6rem;
    }
    #opt-root .opt-preview-g .opt-pv-bar {
      display: flex; align-items: center; gap: .5rem;
      width: 100%;
    }
    #opt-root .opt-pv-links-mega { gap: .55rem; }
    #opt-root .opt-pv-link-mega {
      font-size: 8px;
      color: var(--text-muted);
      display: inline-flex;
      align-items: center;
      gap: 2px;
      opacity: .85;
    }
    #opt-root .opt-pv-link-mega::before {
      content: '';
      width: 14px; height: 2px;
      background: var(--text-muted);
      opacity: .5;
      border-radius: 2px;
      margin-right: 2px;
    }
    #opt-root .opt-pv-megapanel {
      align-self: center;
      display: flex;
      gap: .35rem;
      padding: .35rem .4rem;
      border-radius: 6px;
      background: color-mix(in srgb, var(--accent) 12%, transparent);
      border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
      width: 55%;
    }
    #opt-root .opt-pv-megacol {
      flex: 1;
      height: 18px;
      border-radius: 3px;
      background: repeating-linear-gradient(
        to bottom,
        color-mix(in srgb, var(--text-muted) 35%, transparent) 0 2px,
        transparent 2px 5px
      );
      opacity: .8;
    }
    #opt-root .opt-card:hover .opt-preview-g .opt-pv-megapanel {
      background: color-mix(in srgb, var(--accent) 22%, transparent);
    }

    /* ---- Footer preview shared ---- */
    #opt-root [class^="opt-fpv-"] { box-sizing: border-box; }
    #opt-root .opt-fpv-a, #opt-root .opt-fpv-b, #opt-root .opt-fpv-c {
      height: auto; min-height: 84px;
      padding: .75rem .85rem;
      flex-direction: column;
      align-items: stretch;
      justify-content: space-between;
      gap: .55rem;
    }
    #opt-root .opt-fpv-h {
      width: 28px; height: 4px; border-radius: 2px;
      background: color-mix(in srgb, var(--accent) 80%, transparent);
      opacity: .85;
    }
    #opt-root .opt-fpv-line {
      width: 100%; height: 3px; border-radius: 2px;
      background: var(--text-muted); opacity: .35;
    }
    #opt-root .opt-fpv-line-short { width: 60%; }
    #opt-root .opt-fpv-baseline {
      height: 1px; background: var(--border);
      margin-top: .3rem;
    }
    #opt-root .opt-fpv-logo {
      font: 700 9px ui-monospace, Menlo, monospace;
      color: var(--text-primary);
      letter-spacing: .14em;
    }
    /* A · Estate — 4-col grid */
    #opt-root .opt-fpv-grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
      gap: .55rem;
      align-items: start;
    }
    #opt-root .opt-fpv-brand,
    #opt-root .opt-fpv-col {
      display: flex; flex-direction: column; gap: .25rem;
    }
    #opt-root .opt-fpv-brand .opt-fpv-line { width: 80%; }
    /* B · Marquee — big brand on top, centered cols */
    #opt-root .opt-fpv-b { padding: .55rem .85rem .7rem; gap: .45rem; }
    #opt-root .opt-fpv-marquee {
      font: 900 22px ui-sans-serif, system-ui, sans-serif;
      letter-spacing: -.04em;
      line-height: 1;
      text-align: center;
      background: linear-gradient(180deg, var(--text-primary), color-mix(in srgb, var(--text-primary) 35%, transparent));
      -webkit-background-clip: text; background-clip: text;
      color: transparent; -webkit-text-fill-color: transparent;
      margin-top: .15rem;
    }
    #opt-root .opt-fpv-stack {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: .35rem .55rem;
    }
    #opt-root .opt-fpv-col-c { align-items: center; }
    #opt-root .opt-fpv-col-c .opt-fpv-h { margin: 0 auto; }
    #opt-root .opt-fpv-col-c .opt-fpv-line { width: 70%; margin: 0 auto; }
    /* C · Compact — single inline row */
    #opt-root .opt-fpv-c { min-height: 64px; }
    #opt-root .opt-fpv-row {
      display: flex; align-items: center; gap: .85rem;
      flex-wrap: wrap;
    }
    #opt-root .opt-fpv-inline {
      display: flex; gap: .4rem; align-items: center;
    }
    #opt-root .opt-fpv-inline-r { margin-left: auto; }
    #opt-root .opt-fpv-pip {
      width: 18px; height: 3px; border-radius: 2px;
      background: var(--text-muted); opacity: .45;
    }

    /* D · Beacon — CTA-first */
    #opt-root .opt-fpv-d { padding: .65rem .75rem; min-height: 100px; }
    #opt-root .opt-fpv-d-grid {
      display: grid;
      grid-template-columns: 1fr 1.1fr;
      grid-template-rows: auto auto;
      gap: .55rem .75rem;
      align-items: start;
    }
    #opt-root .opt-fpv-d-brand {
      display: flex; flex-direction: column; gap: .3rem;
    }
    #opt-root .opt-fpv-d-brand .opt-fpv-line { width: 80%; }
    #opt-root .opt-fpv-d-cta {
      grid-column: 2; grid-row: 1;
      display: flex; flex-direction: column; gap: .4rem;
      padding: .5rem .55rem;
      background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 14%, var(--bg-card)), var(--bg-card));
      border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--border));
      border-radius: 8px;
    }
    #opt-root .opt-fpv-d-email {
      font: 800 11px ui-sans-serif, system-ui, sans-serif;
      letter-spacing: -.01em;
      color: var(--text-primary);
    }
    #opt-root .opt-fpv-d-pill {
      align-self: flex-start;
      font: 700 8px ui-monospace, Menlo, monospace;
      letter-spacing: .14em;
      padding: .2rem .45rem;
      background: var(--accent);
      color: #fff;
      border-radius: 999px;
    }
    #opt-root .opt-fpv-d-strip {
      grid-column: 1 / -1; grid-row: 2;
      display: flex; gap: .35rem; align-items: center;
      padding-top: .4rem;
      border-top: 1px solid var(--border);
    }

    /* E · Mosaic — bento tiles */
    #opt-root .opt-fpv-e {
      padding: .55rem;
      min-height: 100px;
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr;
      grid-template-rows: 1fr 1fr;
      gap: .35rem;
    }
    #opt-root .opt-fpv-tile {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: .35rem .45rem;
      display: flex; flex-direction: column; gap: .25rem;
      justify-content: flex-start;
    }
    #opt-root .opt-fpv-tile-brand {
      grid-column: 1; grid-row: 1 / 3;
      background:
        radial-gradient(ellipse 80% 50% at 0% 0%, color-mix(in srgb, var(--accent) 25%, transparent), transparent 60%),
        var(--bg-card);
      border-color: color-mix(in srgb, var(--accent) 28%, var(--border));
      justify-content: center; align-items: center;
    }
    #opt-root .opt-fpv-tile-wide {
      grid-column: 2 / 4; grid-row: 1;
    }
    #opt-root .opt-fpv-tile-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: .2rem .4rem;
    }
    #opt-root .opt-fpv-tile-grid .opt-fpv-line { width: 100%; }

    /* F · Horizon — full-bleed accent banner */
    #opt-root .opt-fpv-f {
      padding: 0;
      min-height: 100px;
      position: relative;
      border: 0;
      border-radius: 8px;
