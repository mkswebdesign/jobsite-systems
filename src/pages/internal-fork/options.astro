    #opt-root .opt-cpv-f-body {
      display: flex; flex-direction: column;
      padding: 8px 10px;
      gap: 3px;
    }
    #opt-root .opt-cpv-f-row {
      display: flex; align-items: center; gap: 4px;
    }
    #opt-root .opt-cpv-f-prompt {
