    #opt-root .opt-ctapv-a-h {
      height: 4px; width: 60%; border-radius: 2px;
      background: var(--text-primary); opacity: 0.9;
    }
    #opt-root .opt-ctapv-a-line {
      height: 3px; width: 50%; border-radius: 2px;
      background: var(--text-muted); opacity: 0.5;
    }
    #opt-root .opt-ctapv-a-btns {
