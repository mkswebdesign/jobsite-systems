    #opt-root .opt-wpv-d-body .opt-wpv-h {
      height: 3px; width: 70%;
      background: var(--text-primary); opacity: 0.9;
    }
    #opt-root .opt-wpv-d-body .opt-wpv-line {
      height: 2px; width: 85%;
      background: var(--text-muted); opacity: 0.5;
    }

    /* E · Canvas */
    #opt-root .opt-wpv-e {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 4px;
      padding: 7px;
    }
    #opt-root .opt-wpv-e-tile {
      position: relative;
      display: flex; flex-direction: column; gap: 3px;
      padding: 6px 6px;
      background: linear-gradient(135deg,
        color-mix(in srgb, var(--accent) 78%, #000) 0%,
