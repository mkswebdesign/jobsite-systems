---
/**
 * Editor options page — prototype for runtime UI variants.
 *
 * Reached from the green dot in the GOMKS editor panel. Same gating posture as
 * /internal-fork/: noindex + obscurity, plus a client-side IP check that hides
 * the panel from non-allowlisted visitors. Static-only — selection lives in
 * localStorage and Base.astro's pre-paint script applies it on load.
 */
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../../builder/layouts/Base.astro';
import { brand, BRAND_ROOT_DIR } from '../../builder/lib/brand';

const editorAllowlist = brand.editor?.allowlist ?? ['162.202.41.44', '172.59.75.74'];

// Graveyard — sections the agent has removed via the editor's
// "Remove" chip. Persisted at the brand level so removals survive
// rebuilds and are visible across all editor users on the brand.
// Missing file is fine — first removal materializes it.
type GraveyardLifecycleEvent = {
  kind: 'removed' | 'restored';
  at: string;
  from?: string;
  to?: string;
  originalFile?: string;
};
type GraveyardEntry = {
  id: string;
  removedAt: string;
  removedFrom?: {
    page?: string;
    pageSlug?: string;
    originalFile?: string;
  };
  type: string;
  section: Record<string, any>;
  /** Optional snapshot of brand-collection items the section referenced
   *  at remove time (testimonials, services, work, faq, etc.). Captured
   *  by the agent for reference-heavy section types so a later restore
   *  can detect drift if the brand collection has changed since archive.
   *  Each key is the collection name, each value is an array of items
   *  with their full original fields. See PAYLOAD_INSTRUCTIONS for the
   *  per-type capture rules. */
  dependencies?: Record<string, any[]>;
  lifecycle?: GraveyardLifecycleEvent[];
  currentlyLive?: { page?: string; since?: string } | null;
};
let graveyard: GraveyardEntry[] = [];
try {
  const path = join(BRAND_ROOT_DIR, 'graveyard.json');
  if (existsSync(path)) {
    const parsed = JSON.parse(readFileSync(path, 'utf-8'));
    if (Array.isArray(parsed)) graveyard = parsed;
  }
} catch (_) {}
// Newest first — recent removals are the most likely to be restored.
graveyard.sort((a, b) => (b.removedAt || '').localeCompare(a.removedAt || ''));

// Normalize: legacy entries (pre-lifecycle) get a synthetic single-event
// log so the modal timeline always has something to show.
graveyard.forEach((e) => {
  if (!Array.isArray(e.lifecycle) || e.lifecycle.length === 0) {
    e.lifecycle = [{
      kind: 'removed',
      at: e.removedAt || '',
      from: e.removedFrom?.page,
      originalFile: e.removedFrom?.originalFile,
    }];
  }
  if (e.currentlyLive === undefined) e.currentlyLive = null;
});

// Type-agnostic helpers so the card layout stays the same shape no matter
// which section type lands in the graveyard. Add a "known type" branch in
// the modal preview renderer (client-side) when a section type wants a
// richer preview than the generic key/value list.
function typeLabelFor(t: string): string {
  if (!t) return 'Section';
  return t
    .replace(/[-_]/g, ' ')
    .replace(/([a-z])([A-Z])/g, '$1 $2')
    .replace(/\b\w/g, (c) => c.toUpperCase())
    .trim();
}
function bestPreviewLineFor(section: Record<string, any>): string {
  if (!section || typeof section !== 'object') return '';
  // 1) Direct string headings — the cheapest, most-common case.
  const stringCandidates = ['heading', 'title', 'name', 'label', 'h1', 'h2', 'text', 'lead', 'subtext', 'summary'];
  for (const k of stringCandidates) {
    const v = section[k];
    if (typeof v === 'string' && v.trim()) return v.trim();
  }
  // 2) Known array shapes — sections without a heading still carry
  //    structured content the user wants to recognize at a glance.
  //    SR: stats[{value,label}] → "20+ Years building websites · 50+ Sites shipped"
  //    CS body[]: first paragraph
  //    Generic cards/items[{title}|{label}]: comma-joined titles
  if (Array.isArray(section.stats) && section.stats.length) {
    const parts = section.stats
      .filter((s: any) => s && (s.value || s.label))
      .map((s: any) => [s.value, s.label].filter(Boolean).join(' ').trim())
      .filter(Boolean);
    if (parts.length) return parts.join(' · ');
  }
  if (Array.isArray(section.body) && section.body.length) {
    const first = section.body.find((p: any) => typeof p === 'string' && p.trim());
    if (first) return String(first).trim();
  }
  for (const arrKey of ['cards', 'items', 'pairs', 'logos', 'quotes', 'steps']) {
    const arr = section[arrKey];
    if (Array.isArray(arr) && arr.length) {
      const titles = arr
        .map((x: any) => (x && (x.title || x.label || x.heading || x.name)) || '')
        .filter((t: string) => typeof t === 'string' && t.trim());
      if (titles.length) return titles.join(', ');
    }
  }
  // 3) Last resort — first non-trivial string field anywhere in the
  //    section payload (skips type/id/slug/variant/sectionLabel which
  //    aren't user-facing previews).
  const skip = new Set(['type', 'id', 'slug', 'variant', 'sectionLabel']);
  for (const [k, v] of Object.entries(section)) {
    if (skip.has(k)) continue;
    if (typeof v === 'string' && v.trim()) return v.trim();
  }
  // 4) Absolute last resort — fall back to sectionLabel (skipped above
  //    because it's usually present alongside a richer heading, but if
  //    nothing else exists it's still better than "(no preview text)").
  if (typeof section.sectionLabel === 'string' && section.sectionLabel.trim()) {
    return section.sectionLabel.trim();
  }
  return '(no preview text)';
}
function relativeTime(iso: string): string {
  if (!iso) return '';
  const t = new Date(iso).getTime();
  if (!isFinite(t)) return iso;
  const diff = Date.now() - t;
  const min = 60 * 1000, hr = 60 * min, day = 24 * hr;
  if (diff < min) return 'just now';
  if (diff < hr) return `${Math.floor(diff / min)}m ago`;
  if (diff < day) return `${Math.floor(diff / hr)}h ago`;
  if (diff < 30 * day) return `${Math.floor(diff / day)}d ago`;
  return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<Base
  title="Internal — Editor Options"
  description="Internal."
  indexable={false}
>
  <section class="section" id="opt-root">
    <div class="container" style="max-width:1200px">

      <div id="opt-gate" class="opt-gate" hidden>
        <h1>Checking access…</h1>
        <p class="opt-gate-msg">Verifying network identity.</p>
      </div>

      <div id="opt-content" hidden>

        <div class="opt-tabs" role="tablist" aria-label="Editor options sections">
          <button class="opt-tab" type="button" role="tab" data-tab="graveyard" aria-selected="true" aria-controls="opt-tab-graveyard" id="opt-tab-btn-graveyard">
            <span class="opt-tab-icon" aria-hidden="true">⚰</span>
            <span class="opt-tab-label">Graveyard</span>
            <span class="opt-tab-count" data-tab-count="graveyard">{graveyard.length}</span>
          </button>
          <button class="opt-tab" type="button" role="tab" data-tab="variants" aria-selected="false" aria-controls="opt-tab-variants" id="opt-tab-btn-variants">
            <span class="opt-tab-icon" aria-hidden="true">▦</span>
            <span class="opt-tab-label">Variants</span>
          </button>
        </div>

        <div id="opt-tab-graveyard" class="opt-tab-panel" role="tabpanel" aria-labelledby="opt-tab-btn-graveyard" data-tab-panel="graveyard">
          <div class="grv-head">
            <div class="grv-head-text">
              <h2 class="grv-head-title">Graveyard</h2>
              <p class="grv-head-sub">Sections you removed via the editor land here, full-section JSON intact, in case you want to restore one or copy it elsewhere.</p>
            </div>
            <div class="grv-head-meta">
              <span class="grv-head-count">{graveyard.length}</span>
              <span class="grv-head-count-label">{graveyard.length === 1 ? 'entry' : 'entries'}</span>
            </div>
          </div>

          {graveyard.length > 0 && (
            <div class="grv-toolbar" role="toolbar" aria-label="Graveyard tools">
              {graveyard.length > 1 && (
                <div class="grv-search-wrap">
                  <input
                    id="grv-search"
                    class="grv-search"
                    type="search"
                    placeholder="Filter by heading, type, or page…"
                    autocomplete="off"
                    aria-label="Filter graveyard entries"
                  />
                  <button id="grv-search-clear" class="grv-search-clear" type="button" aria-label="Clear filter" hidden>×</button>
                </div>
              )}
              {graveyard.length > 1 && (
                <>
                  <label class="grv-sort-label" for="grv-sort">Sort</label>
                  <select id="grv-sort" class="grv-sort-select" aria-label="Sort graveyard entries">
                    <option value="recent-desc">Newest first</option>
                    <option value="recent-asc">Oldest first</option>
                    <option value="type-asc">Type A→Z</option>
                    <option value="page-asc">Page A→Z</option>
                    <option value="heading-asc">Heading A→Z</option>
                  </select>
                  <span class="grv-toolbar-sep" aria-hidden="true"></span>
                </>
              )}
              <label class="grv-select-all">
                <input type="checkbox" id="grv-select-all" />
                <span>Select all</span>
              </label>
              <span class="grv-selected-count" data-role="grv-selected-count" aria-live="polite">0 selected</span>
              <button type="button" id="grv-restore-btn" class="grv-act grv-act-restore" disabled data-role="grv-restore-btn">
                Restore selected
              </button>
              <button type="button" id="grv-delete-btn" class="grv-act grv-act-danger" disabled data-role="grv-delete-btn">
                Delete permanently
              </button>
            </div>
          )}

          {graveyard.length === 0 ? (
            <div class="grv-empty">
              <div class="grv-empty-icon" aria-hidden="true">⚰</div>
              <strong>The graveyard is empty.</strong>
              <span>Click <em>Remove</em> on any section in the live editor — it will be archived here when the patch ships.</span>
            </div>
          ) : (
            <ul class="grv-list" role="list">
              {graveyard.map((entry) => {
                const sec = (entry.section || {}) as any;
                const fromLabel = entry.removedFrom?.page ?? entry.removedFrom?.pageSlug ?? 'unknown';
                const restoreTargetPage = entry.removedFrom?.page || '/';
                const previewLine = bestPreviewLineFor(sec);
                const previewShort = previewLine.length > 110 ? previewLine.slice(0, 107) + '…' : previewLine;
                const when = relativeTime(entry.removedAt || '');
                const whenAbs = entry.removedAt
                  ? new Date(entry.removedAt).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' })
                  : '';
                const jsonStr = JSON.stringify(entry.section ?? {}, null, 2);
                const lifecycleStr = JSON.stringify(entry.lifecycle ?? []);
                const live = entry.currentlyLive && entry.currentlyLive.page ? entry.currentlyLive : null;
                const liveSince = live && live.since ? relativeTime(live.since) : '';
                // Dependencies — snapshots of brand-collection items the
                // section referenced at remove time. Sum across all keys
                // for the card-level count badge; full payload goes into
                // a hidden script block so the modal can render details.
                const deps = (entry.dependencies && typeof entry.dependencies === 'object') ? entry.dependencies : null;
                const depsCount = deps
                  ? Object.values(deps).reduce((n: number, arr: any) => n + (Array.isArray(arr) ? arr.length : 0), 0)
                  : 0;
                const depsStr = deps ? JSON.stringify(deps) : '';
                return (
                  <li
                    class={`grv-card${live ? ' is-live' : ''}`}
                    data-grv-id={entry.id}
                    data-grv-type={entry.type}
                    data-grv-restore-page={restoreTargetPage}
                    data-grv-type-label={typeLabelFor(entry.type)}
                    data-grv-removed-at={entry.removedAt || ''}
                    data-grv-heading={previewLine.toLowerCase()}
                    data-grv-live-page={live?.page ?? ''}
                    data-grv-live-since={live?.since ?? ''}
                  >
                    <label class="grv-card-check" title="Select for permanent deletion">
                      <input type="checkbox" class="grv-card-check-input" data-grv-check={entry.id} aria-label={`Select ${typeLabelFor(entry.type)} from ${fromLabel}`} />
                    </label>
                    <button class="grv-card-open" type="button" data-grv-act="open" data-grv-id={entry.id} aria-label={`Open details for ${typeLabelFor(entry.type)} from ${fromLabel}`}>
                      <span class="grv-card-meta">
                        <span class="grv-card-type">{typeLabelFor(entry.type)}</span>
                        <span class="grv-card-meta-sep" aria-hidden="true">·</span>
                        <code class="grv-card-from" title={fromLabel}>{fromLabel}</code>
                        <span class="grv-card-meta-sep" aria-hidden="true">·</span>
                        <span class="grv-card-when" title={whenAbs}>{when}</span>
                        {depsCount > 0 && (
                          <>
                            <span class="grv-card-meta-sep" aria-hidden="true">·</span>
                            <span class="grv-card-deps" title={`Includes ${depsCount} archived dependency item${depsCount === 1 ? '' : 's'} (referenced collection data captured at remove time — see modal)`}>deps: {depsCount}</span>
                          </>
                        )}
                      </span>
                      <span class="grv-card-preview" title={previewLine}>{previewShort}</span>
                      {live && (
                        <span class="grv-card-live" title={`Currently live on ${live.page} since ${live.since || 'unknown'}`}>
                          <span class="grv-card-live-dot" aria-hidden="true"></span>
                          <span>LIVE on </span>
                          <code>{live.page}</code>
                          {liveSince && <span class="grv-card-live-since"> · {liveSince}</span>}
                        </span>
                      )}
                    </button>
                    <div class="grv-card-actions">
                      {live ? (
                        <a class="grv-act grv-act-jump" href={live.page} target="_blank" rel="noopener" data-grv-act="jump" title={`Open ${live.page} in a new tab`}>↗ View live</a>
                      ) : (
                        <button class="grv-act grv-act-restore" type="button" data-grv-act="restore" data-grv-id={entry.id} title={`Stage this section for re-insertion on ${restoreTargetPage}`}>Restore</button>
                      )}
                      <button class="grv-act grv-act-view" type="button" data-grv-act="open" data-grv-id={entry.id}>Details</button>
                    </div>
                    <p class="grv-card-restore-status" data-grv-restore-status={entry.id} hidden></p>
                    <pre class="grv-card-json" data-grv-json={entry.id} hidden>{jsonStr}</pre>
                    <script type="application/json" data-grv-lifecycle={entry.id} set:html={lifecycleStr}></script>
                    {depsCount > 0 && (
                      <script type="application/json" data-grv-deps={entry.id} set:html={depsStr}></script>
                    )}
                  </li>
                );
              })}
            </ul>
          )}
        </div>

        <div class="grv-modal" id="grv-delete-modal" hidden role="dialog" aria-modal="true" aria-labelledby="grv-delete-modal-title">
          <div class="grv-modal-backdrop" data-grv-act="close-delete-modal" aria-hidden="true"></div>
          <div class="grv-modal-panel" role="document">
            <header class="grv-modal-head">
              <p class="grv-modal-eyebrow">Permanent deletion</p>
              <h3 class="grv-modal-title" id="grv-delete-modal-title" data-role="grv-delete-title">Delete entries</h3>
              <button class="grv-modal-close" type="button" data-grv-act="close-delete-modal" aria-label="Close">×</button>
            </header>
            <div class="grv-modal-body">
              <p class="grv-delete-warn">
                <strong>This is destructive and not reversible.</strong>
                These graveyard entries — including their full archived section JSON and lifecycle log — will be removed by the agent the next time it processes the request. Any sections currently restored will stay live; only the graveyard archives are deleted.
              </p>
              <ul class="grv-delete-list" data-role="grv-delete-list" role="list"></ul>
              <details class="grv-modal-json-wrap" open>
                <summary>Request JSON (copy this to chat)</summary>
                <pre class="grv-modal-json" data-role="grv-delete-json"></pre>
              </details>
            </div>
            <footer class="grv-modal-foot">
              <button class="grv-act grv-act-danger" type="button" data-grv-act="grv-delete-copy">Copy delete JSON</button>
              <button class="grv-act" type="button" data-grv-act="close-delete-modal">Cancel</button>
            </footer>
          </div>
        </div>

        <div class="grv-modal" id="grv-modal" hidden role="dialog" aria-modal="true" aria-labelledby="grv-modal-title">
          <div class="grv-modal-backdrop" data-grv-act="close-modal" aria-hidden="true"></div>
          <div class="grv-modal-panel" role="document">
            <header class="grv-modal-head">
              <p class="grv-modal-eyebrow" data-role="modal-eyebrow"></p>
              <h3 class="grv-modal-title" id="grv-modal-title" data-role="modal-title"></h3>
              <button class="grv-modal-close" type="button" data-grv-act="close-modal" aria-label="Close">×</button>
            </header>
            <div class="grv-modal-body">
              <div class="grv-modal-preview" data-role="modal-preview"></div>
              <div class="grv-modal-lifecycle" data-role="modal-lifecycle">
                <p class="grv-modal-lifecycle-title">Lifecycle</p>
                <ol class="grv-timeline" data-role="modal-timeline" role="list"></ol>
              </div>
              <div class="grv-modal-deps" data-role="modal-deps" hidden>
                <p class="grv-modal-lifecycle-title">Dependencies <span class="grv-modal-deps-meta" data-role="modal-deps-meta"></span></p>
                <p class="grv-modal-deps-help">
                  Snapshot of brand-collection items this section referenced at remove time. Captured so a later restore can detect drift if the collection has changed since archive. Items below are <strong>copies</strong> — the live collection files are untouched.
                </p>
                <div class="grv-modal-deps-body" data-role="modal-deps-body"></div>
              </div>
              <details class="grv-modal-json-wrap">
                <summary>Raw JSON</summary>
                <pre class="grv-modal-json" data-role="modal-json"></pre>
              </details>
              <p class="grv-modal-restore-status" data-role="modal-restore-status" hidden></p>
            </div>
            <footer class="grv-modal-foot">
              <button class="grv-act grv-act-restore" type="button" data-grv-act="modal-restore">Restore</button>
              <button class="grv-act" type="button" data-grv-act="modal-copy">Copy JSON</button>
              <button class="grv-act" type="button" data-grv-act="close-modal">Close</button>
            </footer>
          </div>
        </div>

        <div id="opt-tab-variants" class="opt-tab-panel" role="tabpanel" aria-labelledby="opt-tab-btn-variants" data-tab-panel="variants" hidden>

        <div class="opt-toolbar" role="toolbar" aria-label="Variant browser controls">
          <div class="opt-filters" role="group" aria-label="Filter by part">
            <button class="opt-filter-pill" type="button" data-filter="all" aria-pressed="true">All</button>
            <button class="opt-filter-pill" type="button" data-filter="nav" aria-pressed="false">Header</button>
            <button class="opt-filter-pill" type="button" data-filter="footer" aria-pressed="false">Footer</button>
            <button class="opt-filter-pill" type="button" data-filter="section" aria-pressed="false">Sections</button>
            <button class="opt-filter-pill" type="button" data-filter="page" aria-pressed="false">Pages</button>
          </div>
          <div class="opt-search-wrap">
            <input
              id="opt-search"
              class="opt-search"
              type="search"
              placeholder="Search variants, names, descriptions…    /"
              autocomplete="off"
              aria-label="Search variants (press / to focus)"
            />
            <button id="opt-search-clear" class="opt-search-clear" type="button" aria-label="Clear search" hidden>&times;</button>
          </div>
          <div class="opt-actions">
            <button id="opt-apply" class="btn btn-primary opt-apply-btn" type="button" disabled aria-label="Apply and reload" title="Apply changes and reload"><span class="opt-apply-icon" aria-hidden="true">✓</span></button>
            <button id="opt-dice" class="btn btn-ghost opt-dice-btn" type="button" title="Roll a random variant for every part and reload">Dice</button>
            <button id="opt-reload" class="btn btn-ghost" type="button" title="Reload without applying">Reload</button>
            <button id="opt-default" class="btn btn-ghost" type="button" title="Restore the original design — every part back to A">Default</button>
            <button id="opt-collapse" class="opt-collapse-btn" type="button" aria-expanded="false" aria-controls="opt-subfilters" title="Expand toolbar"><span class="opt-collapse-caret" aria-hidden="true">▾</span></button>
          </div>

          <div id="opt-subfilters" class="opt-subfilters" role="group" aria-label="Filter by section or page" hidden></div>

          <div class="opt-meta">
            <label class="opt-toggle" title="Only show parts where a non-default variant is applied or pending">
              <input type="checkbox" id="opt-modified-only" />
              <span>Modified only</span>
            </label>
            <button id="opt-clear-filters" class="opt-clear-filters" type="button" hidden>Clear filters</button>
            <span id="opt-count" class="opt-count"></span>
            <span id="opt-status" class="opt-status" aria-live="polite"></span>
          </div>
        </div>

        <div class="opt-grid" id="opt-grid" role="radiogroup" aria-label="Variants">

          <!-- ============ HEADER VARIANTS ============ -->
          <button class="opt-card" type="button" role="radio" data-kind="nav" data-group="nav" data-variant="A" aria-checked="false">
            <span class="opt-kind-label">Header</span>
            <div class="opt-card-preview opt-preview-a" aria-hidden="true">
              <span class="opt-pv-logo">LOGO</span>
              <span class="opt-pv-links">
                <span></span><span></span><span></span>
              </span>
              <span class="opt-pv-cta">CTA</span>
            </div>
            <div class="opt-card-meta">
              <strong>A · Anchor</strong>
              <span>The grounded default. Logo left, links + CTA right. Translucent on hero, blurred on scroll.</span>
            </div>
            <span class="opt-current">In use</span>
          </button>

          <button class="opt-card" type="button" role="radio" data-kind="nav" data-group="nav" data-variant="B" aria-checked="false">
            <span class="opt-kind-label">Header</span>
            <div class="opt-card-preview opt-preview-b" aria-hidden="true">
              <span class="opt-pv-bar">
                <span class="opt-pv-logo">LOGO</span>
                <span class="opt-pv-links">
                  <span></span><span></span><span></span>
                </span>
                <span class="opt-pv-cta opt-pv-cta-bold">CTA</span>
                <span class="opt-pv-underline" aria-hidden="true"></span>
              </span>
            </div>
            <div class="opt-card-meta">
              <strong>B · Aurora</strong>
              <span>Premium full-bleed glass bar. Tightens on scroll with a luminescent accent line. CTA reads as a primary call.</span>
            </div>
            <span class="opt-current">In use</span>
          </button>

          <button class="opt-card" type="button" role="radio" data-kind="nav" data-group="nav" data-variant="C" aria-checked="false">
            <span class="opt-kind-label">Header</span>
            <div class="opt-card-preview opt-preview-c" aria-hidden="true">
              <span class="opt-pv-pill opt-pv-pill-wide">
                <span class="opt-pv-logo">LOGO</span>
                <span class="opt-pv-links">
                  <span></span><span></span><span></span>
                </span>
                <span class="opt-pv-cta">CTA</span>
              </span>
            </div>
            <div class="opt-card-meta">
              <strong>C · Drift</strong>
              <span>Wide floating glass capsule, container-width. Auto-hides on scroll-down, reveals on scroll-up. Stays out of content's way.</span>
            </div>
            <span class="opt-current">In use</span>
          </button>

          <button class="opt-card" type="button" role="radio" data-kind="nav" data-group="nav" data-variant="D" aria-checked="false">
            <span class="opt-kind-label">Header</span>
