    #opt-root .opt-wpv-f-body .opt-wpv-line {
      height: 2px; width: 80%;
      background: var(--text-muted); opacity: 0.45;
    }

    /* G · Aurora — gradient tile preview with halo'd icon, numbered counter,
       and a top accent rule. Mirrors the live variant's identity at thumb size. */
    #opt-root .opt-wpv-g {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      padding: 10px;
      align-items: stretch;
    }
    #opt-root .opt-wpv-g-tile {
      position: relative;
      display: grid;
      grid-template-columns: auto 1fr;
      grid-template-rows: auto auto;
      column-gap: 6px;
      row-gap: 4px;
      padding: 8px 8px 7px;
      border-radius: 7px;
      border: 1px solid color-mix(in srgb, var(--accent) 22%, var(--border));
      background:
        radial-gradient(120% 80% at 0% 0%, color-mix(in srgb, var(--accent) 20%, transparent) 0%, transparent 60%),
        radial-gradient(120% 80% at 100% 100%, color-mix(in srgb, var(--accent) 12%, transparent) 0%, transparent 65%),
        var(--bg-card);
      overflow: hidden;
