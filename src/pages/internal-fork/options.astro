    }
    #opt-root .opt-cpv-e-form .opt-cpv-line {
      height: 7px; border-radius: 2px;
      background: var(--bg-card);
      border: 1px solid var(--border);
    }
    #opt-root .opt-cpv-e-form .opt-cpv-btn {
      margin-top: 3px;
      align-self: flex-start;
      width: 40px; height: 9px; border-radius: 2px;
      background: var(--accent);
