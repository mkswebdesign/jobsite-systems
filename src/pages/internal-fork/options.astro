        color-mix(in srgb, var(--accent) 82%, #000) 100%);
      border-radius: 4px;
      overflow: hidden;
    }
    #opt-root .opt-wpv-e-glow {
      position: absolute; inset: 0; pointer-events: none;
      background:
        radial-gradient(ellipse 70% 60% at 18% 0%, rgba(255, 255, 255, 0.3), transparent 60%),
