    #opt-root .opt-wpv-f-row {
      display: grid;
      grid-template-columns: 14px 1fr;
      column-gap: 8px;
      align-items: center;
      padding: 5px 0;
      border-bottom: 1px solid var(--border);
    }
    #opt-root .opt-wpv-f-row:last-child { border-bottom: none }
    #opt-root .opt-wpv-f-icon {
      width: 12px; height: 12px;
      border-radius: 3px;
      background: color-mix(in srgb, var(--accent) 22%, transparent);
