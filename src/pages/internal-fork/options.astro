    /* D · Columns */
    #opt-root .opt-fqpv-d {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      padding: 8px 12px;
      justify-content: stretch;
    }
    #opt-root .opt-fqpv-d-col {
      display: flex; flex-direction: column;
    }
    #opt-root .opt-fqpv-d-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      padding: 5px 0;
      border-bottom: 1px solid var(--border);
    }
    #opt-root .opt-fqpv-d-row:last-child { border-bottom: none }
    #opt-root .opt-fqpv-d-row .opt-fqpv-text {
      max-width: 72%;
      height: 3px;
    }

    /* E · Timeline */
    #opt-root .opt-fqpv-e {
      position: relative;
      padding: 6px 10px 6px 24px;
      justify-content: center;
      gap: 0;
    }
    #opt-root .opt-fqpv-e-line {
      position: absolute;
      left: 14px;
      top: 14px;
      bottom: 14px;
      width: 2px;
      background: linear-gradient(180deg, var(--accent), color-mix(in srgb, var(--accent) 25%, transparent));
      opacity: 0.7;
    }
    #opt-root .opt-fqpv-e-row {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      padding: 7px 0;
      border-bottom: 1px solid var(--border);
