    }
    #opt-root .opt-wpv-icon {
      width: 10px; height: 10px; border-radius: 2px;
      background: var(--accent);
      opacity: 0.8;
    }
    #opt-root .opt-wpv-h {
      height: 4px; width: 70%; border-radius: 2px;
      background: var(--text-primary); opacity: 0.9;
    }
    #opt-root .opt-wpv-line {
      height: 2px; width: 100%; border-radius: 1px;
      background: var(--text-muted); opacity: 0.4;
    }

    /* A · Pillars */
    #opt-root .opt-wpv-a {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 6px;
    }
    #opt-root .opt-wpv-a-card {
      display: flex; flex-direction: column; gap: 4px;
      padding: 7px 6px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 4px;
