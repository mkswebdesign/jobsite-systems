    #opt-root .opt-hpv-f-lead {
      height: 3px; width: 90px; border-radius: 1px;
      background: var(--text-muted); opacity: 0.55;
    }
    #opt-root .opt-hpv-f-cta {
      width: 36px; height: 9px; margin-top: 3px;
      background: var(--accent); border-radius: 2px;
