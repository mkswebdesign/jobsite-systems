    #opt-root .opt-wpv-b-body .opt-wpv-h { height: 3px; width: 70%; }
    #opt-root .opt-wpv-b-body .opt-wpv-line { height: 2px; width: 55%; }

    /* C · Facets */
    #opt-root .opt-wpv-c {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px;
    }
    #opt-root .opt-wpv-c-tile {
      position: relative;
      display: flex; flex-direction: column; gap: 4px;
      padding: 8px 9px;
      background: linear-gradient(135deg, var(--bg-card), color-mix(in srgb, var(--accent) 10%, var(--bg-card)));
