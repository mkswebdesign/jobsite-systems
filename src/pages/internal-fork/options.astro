      border: 1px solid var(--border);
      border-radius: 4px;
    }
    #opt-root .opt-wpv-d-row-rev {
      grid-template-columns: 1fr 20px;
      text-align: right;
    }
    #opt-root .opt-wpv-d-ring {
      width: 18px; height: 18px;
      border-radius: 50%;
