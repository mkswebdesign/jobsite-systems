      padding: 3rem 1.25rem;
      color: var(--text-muted);
      border: 1px dashed var(--border);
      border-radius: var(--radius);
      margin: 0 0 2rem;
    }
    #opt-root .opt-empty strong { color: var(--text-primary); font-size: 1rem; }
    #opt-root .opt-empty span { font-size: .85rem; }
  </style>

  <script is:inline define:vars={{ allowlist: editorAllowlist, brandId: brand.id }}>
    (function () {
      var gate = document.getElementById('opt-gate');
      var content = document.getElementById('opt-content');
      var denied = document.getElementById('opt-denied');
      var status = document.getElementById('opt-status');
      var applyBtn = document.getElementById('opt-apply');
      var reloadBtn = document.getElementById('opt-reload');
      var defaultBtn = document.getElementById('opt-default');
      var diceBtn = document.getElementById('opt-dice');
      var search = document.getElementById('opt-search');
      var searchClearBtn = document.getElementById('opt-search-clear');
      var empty = document.getElementById('opt-empty');
      var pills = Array.prototype.slice.call(document.querySelectorAll('.opt-filter-pill'));
      var cards = Array.prototype.slice.call(document.querySelectorAll('.opt-card'));
      var subfiltersEl = document.getElementById('opt-subfilters');
      var modifiedOnlyInput = document.getElementById('opt-modified-only');
      var clearFiltersBtn = document.getElementById('opt-clear-filters');
      var countEl = document.getElementById('opt-count');
      var toolbarEl = document.querySelector('#opt-content .opt-toolbar');
      var collapseBtn = document.getElementById('opt-collapse');

      function reveal() {
        gate.hidden = true;
        denied.hidden = true;
        content.hidden = false;
        wireTabs();
        wireGraveyard();
        wireOptions();
      }

      // -------- Tabs ----------
      var TAB_KEY = 'aed:opt-active-tab';
      function readActiveTab() {
        try {
          var v = localStorage.getItem(TAB_KEY);
          if (v === 'graveyard' || v === 'variants') return v;
        } catch (_) {}
        return 'graveyard';
      }
      function setActiveTab(tab) {
        if (tab !== 'graveyard' && tab !== 'variants') tab = 'graveyard';
        var tabs = document.querySelectorAll('.opt-tab');
        var panels = document.querySelectorAll('.opt-tab-panel');
        tabs.forEach(function (t) {
          t.setAttribute('aria-selected', t.dataset.tab === tab ? 'true' : 'false');
        });
        panels.forEach(function (p) {
          p.hidden = p.dataset.tabPanel !== tab;
        });
        try { localStorage.setItem(TAB_KEY, tab); } catch (_) {}
      }
      function wireTabs() {
        var tabs = document.querySelectorAll('.opt-tab');
        tabs.forEach(function (t) {
          t.addEventListener('click', function () { setActiveTab(t.dataset.tab); });
        });
        // Restore last active tab. Defaults to "graveyard" (priority).
        setActiveTab(readActiveTab());
      }

      // -------- Graveyard sorting (client-side reorder, persisted) ----
      // Reads the current sort key from localStorage, applies it on load
      // and on every change to the select. Pure DOM reorder — the grid
      // and modal data flow are untouched.
      var GRV_SORT_KEY = 'aed:opt-grv-sort';
      var GRV_SORT_DEFAULT = 'recent-desc';
      var GRV_SORTERS = {
        'recent-desc': function (a, b) { return cmpRemovedAt(b, a); },
        'recent-asc':  function (a, b) { return cmpRemovedAt(a, b); },
        'type-asc':    function (a, b) {
          var t = cmpAttr(a, b, 'data-grv-type-label');
          return t !== 0 ? t : cmpRemovedAt(b, a);
        },
        'page-asc':    function (a, b) {
          var p = cmpAttr(a, b, 'data-grv-restore-page');
          return p !== 0 ? p : cmpRemovedAt(b, a);
        },
        'heading-asc': function (a, b) { return cmpAttr(a, b, 'data-grv-heading'); },
      };
      function cmpAttr(a, b, attr) {
        var av = (a.getAttribute(attr) || '').toLowerCase();
        var bv = (b.getAttribute(attr) || '').toLowerCase();
        if (av < bv) return -1;
        if (av > bv) return 1;
        return 0;
      }
      function cmpRemovedAt(a, b) {
        // ISO strings sort lexicographically as time order, so string
        // compare is correct (no parse needed). Empty strings sink last.
        var av = a.getAttribute('data-grv-removed-at') || '';
        var bv = b.getAttribute('data-grv-removed-at') || '';
        if (!av && !bv) return 0;
        if (!av) return 1;
        if (!bv) return -1;
        if (av < bv) return -1;
        if (av > bv) return 1;
        return 0;
      }
      function readGrvSort() {
        try {
          var v = localStorage.getItem(GRV_SORT_KEY);
          if (v && GRV_SORTERS[v]) return v;
        } catch (_) {}
        return GRV_SORT_DEFAULT;
      }
      function applyGrvSort(panel, key) {
        var list = panel.querySelector('.grv-list');
        if (!list) return;
        var sorter = GRV_SORTERS[key] || GRV_SORTERS[GRV_SORT_DEFAULT];
        var cards = Array.prototype.slice.call(list.querySelectorAll(':scope > .grv-card'));
        cards.sort(sorter);
        // Re-append in the new order. appendChild moves existing nodes,
        // preserving event listeners + state.
        cards.forEach(function (c) { list.appendChild(c); });
      }
      function wireGraveyardSort(panel) {
        var select = panel.querySelector('#grv-sort');
        if (!select) return; // hidden when 0 or 1 entry — nothing to sort
        var initial = readGrvSort();
        select.value = initial;
        applyGrvSort(panel, initial);
        select.addEventListener('change', function () {
          var key = select.value;
          if (!GRV_SORTERS[key]) key = GRV_SORT_DEFAULT;
          try { localStorage.setItem(GRV_SORT_KEY, key); } catch (_) {}
          applyGrvSort(panel, key);
        });
      }

      // -------- Graveyard interactions (Restore + View modal) ----
      // Card-level: View opens the modal; Restore stages an injection.
      // Modal-level: Restore + Copy JSON + Close. Esc closes too.
      var grvModal = null;
      var grvModalEntry = null; // { id, jsonStr, type, typeLabel, page, when }
      var grvDeleteModal = null;
      var grvDeletePayload = null; // last-built deletion request, for Copy

      // -------- Bulk-delete selection (checkboxes + Delete button) ----
      // Selection is in-memory only — refresh clears it. Clicking the
      // Delete button opens a confirmation modal that lists the entries
      // and the JSON the user pastes into chat for the agent to apply.
      function wireGraveyardSelection(panel) {
        var selectAllEl = document.getElementById('grv-select-all');
        var deleteBtn = document.getElementById('grv-delete-btn');
        var restoreBtn = document.getElementById('grv-restore-btn');
        var checkboxes = panel.querySelectorAll('[data-grv-check]');
        if (!checkboxes.length) return;

        // Returns checkboxes for cards currently VISIBLE under the
        // active filter. Select-all + counters operate on this set so
        // a search like "hero" + Select-all selects only matching cards.
        function visibleCheckboxes() {
          var out = [];
          checkboxes.forEach(function (cb) {
            var card = cb.closest('.grv-card');
            if (card && !card.hidden) out.push(cb);
          });
          return out;
        }
        function selectedIds() {
          var ids = [];
          // Walk only visible — hidden cards may be checked but the user
          // can't see them, so don't bulk-act on them.
          visibleCheckboxes().forEach(function (cb) {
            if (cb.checked) ids.push(cb.getAttribute('data-grv-check'));
          });
          return ids;
        }
        function refresh() {
          var ids = selectedIds();
          var n = ids.length;
          // Card visual state — apply to ALL checked checkboxes (visible
          // or not) so the selection pill stays accurate.
          checkboxes.forEach(function (cb) {
            var card = cb.closest('.grv-card');
            if (card) card.classList.toggle('is-marked-delete', cb.checked && !card.hidden);
          });
          var counter = panel.querySelector('[data-role="grv-selected-count"]');
          if (counter) counter.textContent = n + ' selected';
          if (deleteBtn) {
            deleteBtn.disabled = n === 0;
            deleteBtn.textContent = n > 0 ? ('Delete ' + n + ' permanently') : 'Delete permanently';
          }
          if (restoreBtn) {
            // Count how many of the selection are actually restorable
            // (skip currently-live entries — restoring them would create
            // duplicates of sections that still exist on the page).
            var restorable = ids.filter(function (id) {
              var card = panel.querySelector('.grv-card[data-grv-id="' + id + '"]');
              return card && !card.classList.contains('is-live');
            });
            restoreBtn.disabled = restorable.length === 0;
            restoreBtn.textContent = restorable.length > 0
              ? ('Restore ' + restorable.length + ' selected')
              : 'Restore selected';
          }
          // Select-all tri-state, scoped to visible cards.
          if (selectAllEl) {
            var visible = visibleCheckboxes();
            var visibleSelected = visible.filter(function (cb) { return cb.checked; }).length;
            if (visible.length === 0) {
              selectAllEl.checked = false;
              selectAllEl.indeterminate = false;
              selectAllEl.disabled = true;
            } else {
              selectAllEl.disabled = false;
              if (visibleSelected === 0) {
                selectAllEl.checked = false;
                selectAllEl.indeterminate = false;
              } else if (visibleSelected === visible.length) {
                selectAllEl.checked = true;
                selectAllEl.indeterminate = false;
              } else {
                selectAllEl.checked = false;
                selectAllEl.indeterminate = true;
              }
            }
          }
        }
        // Expose for the search-filter wiring to call after each input.
        grvSelectionRefresh = refresh;

        checkboxes.forEach(function (cb) { cb.addEventListener('change', refresh); });
        if (selectAllEl) {
          selectAllEl.addEventListener('change', function () {
            var on = selectAllEl.checked;
            visibleCheckboxes().forEach(function (cb) { cb.checked = on; });
            refresh();
          });
        }
        if (deleteBtn) {
          deleteBtn.addEventListener('click', function () {
            var ids = selectedIds();
            if (!ids.length) return;
            openGrvDeleteModal(panel, ids);
          });
        }
        if (restoreBtn) {
          restoreBtn.addEventListener('click', function () {
            var ids = selectedIds();
            if (!ids.length) return;
            doBulkRestore(panel, ids);
          });
        }

        if (grvDeleteModal) {
          grvDeleteModal.addEventListener('click', function (ev) {
            var btn = ev.target && ev.target.closest && ev.target.closest('[data-grv-act]');
            if (!btn) return;
            var act = btn.getAttribute('data-grv-act');
            if (act === 'close-delete-modal') closeGrvDeleteModal();
            else if (act === 'grv-delete-copy') copyGrvDeletePayload(btn);
          });
        }

        wireGraveyardSearch(panel);
        refresh();
      }

      // Bulk restore — iterates selected ids, calls the (refactored)
      // doRestore for each (skipping currently-live entries which would
      // create duplicates), and surfaces a single rolled-up status.
      // Uncheckes selected after staging since the action is one-shot.
      var grvBulkStatusEl = null;
      function doBulkRestore(panel, ids) {
        var staged = 0;
        var skipped = 0;
        var failed = 0;
        var pages = new Set();
        ids.forEach(function (id) {
          var card = panel.querySelector('.grv-card[data-grv-id="' + id + '"]');
          if (card && card.classList.contains('is-live')) { skipped++; return; }
          var result = doRestore(panel, null, id, false);
          if (result && result.ok) {
            staged++;
            if (result.targetPage) pages.add(result.targetPage);
          } else {
            failed++;
          }
        });
        // Uncheck after staging — selection is now spent.
        ids.forEach(function (id) {
          var cb = panel.querySelector('[data-grv-check="' + id + '"]');
          if (cb) cb.checked = false;
        });
        if (typeof grvSelectionRefresh === 'function') grvSelectionRefresh();
        // Surface status above the grid (creates the element if needed).
        var msg = '';
        if (staged > 0) {
          var pageList = Array.from(pages).slice(0, 3).join(', ');
          var more = pages.size > 3 ? ' + ' + (pages.size - 3) + ' more' : '';
          msg = 'Staged ' + staged + ' restoration' + (staged === 1 ? '' : 's') + ' across ' + pages.size + ' page' + (pages.size === 1 ? '' : 's') + ' (' + pageList + more + '). Open Copy Patch in the editor to ship.';
        }
        if (skipped > 0) {
          msg += (msg ? ' · ' : '') + 'Skipped ' + skipped + ' already-live entr' + (skipped === 1 ? 'y' : 'ies');
        }
        if (failed > 0) {
          msg += (msg ? ' · ' : '') + failed + ' failed';
        }
        showBulkRestoreStatus(panel, msg, staged === 0);
      }
      function showBulkRestoreStatus(panel, html, isError) {
        if (!grvBulkStatusEl) {
          grvBulkStatusEl = document.createElement('p');
          grvBulkStatusEl.className = 'grv-bulk-status';
          var toolbar = panel.querySelector('.grv-toolbar');
          if (toolbar && toolbar.parentNode) {
            toolbar.parentNode.insertBefore(grvBulkStatusEl, toolbar.nextSibling);
          } else {
            panel.insertBefore(grvBulkStatusEl, panel.firstChild);
          }
        }
        grvBulkStatusEl.innerHTML = html;
        grvBulkStatusEl.classList.toggle('is-error', !!isError);
        grvBulkStatusEl.hidden = !html;
      }

      // Search filter — debounced text input; matches against the
      // already-stamped data-grv-heading (lowercased preview) plus
      // type label and target page. Hides non-matching cards via
      // the standard `hidden` attribute so flex/grid layout collapses
      // them and Select-all naturally scopes to visible.
      var grvSelectionRefresh = null;
      function wireGraveyardSearch(panel) {
        var input = document.getElementById('grv-search');
        var clearBtn = document.getElementById('grv-search-clear');
        if (!input) return;

        function applyFilter() {
          var q = (input.value || '').trim().toLowerCase();
          var anyVisible = false;
          panel.querySelectorAll('.grv-card').forEach(function (card) {
            if (!q) {
              card.hidden = false;
              anyVisible = true;
              return;
            }
            var heading = (card.getAttribute('data-grv-heading') || '');
            var type = (card.getAttribute('data-grv-type') || '').toLowerCase();
            var typeLabel = (card.getAttribute('data-grv-type-label') || '').toLowerCase();
            var page = (card.getAttribute('data-grv-restore-page') || '').toLowerCase();
            var match = heading.indexOf(q) >= 0
              || type.indexOf(q) >= 0
              || typeLabel.indexOf(q) >= 0
              || page.indexOf(q) >= 0;
            card.hidden = !match;
            if (match) anyVisible = true;
          });
          if (clearBtn) clearBtn.hidden = q === '';
          // Refresh selection counts since visibility changed.
          if (typeof grvSelectionRefresh === 'function') grvSelectionRefresh();
          // Show/hide the empty-results message.
          renderGrvSearchEmpty(panel, q, anyVisible);
        }
        input.addEventListener('input', applyFilter);
        input.addEventListener('keydown', function (ev) {
          if (ev.key === 'Escape' && input.value) {
            input.value = '';
            applyFilter();
          }
        });
        if (clearBtn) {
          clearBtn.addEventListener('click', function () {
            input.value = '';
            input.focus();
            applyFilter();
          });
        }
      }
      var grvSearchEmptyEl = null;
      function renderGrvSearchEmpty(panel, q, anyVisible) {
        if (anyVisible || !q) {
          if (grvSearchEmptyEl) grvSearchEmptyEl.hidden = true;
          return;
        }
        if (!grvSearchEmptyEl) {
          grvSearchEmptyEl = document.createElement('div');
          grvSearchEmptyEl.className = 'grv-search-empty';
          var list = panel.querySelector('.grv-list');
          if (list && list.parentNode) list.parentNode.insertBefore(grvSearchEmptyEl, list.nextSibling);
          else panel.appendChild(grvSearchEmptyEl);
        }
        grvSearchEmptyEl.innerHTML = 'No graveyard entries match <strong>“' + escapeHtmlText(q) + '”</strong>.';
        grvSearchEmptyEl.hidden = false;
      }

      function openGrvDeleteModal(panel, ids) {
        if (!grvDeleteModal) return;
        // Build the entry detail list + JSON envelope from ids.
        var entries = ids.map(function (id) {
          var card = panel.querySelector('.grv-card[data-grv-id="' + id + '"]');
          if (!card) return null;
          var pre = panel.querySelector('[data-grv-json="' + id + '"]');
          var section = {};
          try { section = JSON.parse(pre ? pre.textContent || '{}' : '{}'); } catch (_) {}
          var type = card.getAttribute('data-grv-type') || 'unknown';
          var typeLabel = card.getAttribute('data-grv-type-label') || type;
          var heading = (section && section.heading)
            ? String(section.heading).replace(/\s+/g, ' ').trim()
            : (card.querySelector('.grv-card-preview') ? card.querySelector('.grv-card-preview').textContent.trim() : '');
          var removedFrom = card.getAttribute('data-grv-restore-page') || '';
          return { id: id, type: type, typeLabel: typeLabel, sectionHeading: heading, removedFrom: removedFrom };
        }).filter(Boolean);

        // Detail list (visible) — strip the typeLabel/removedFrom keys
        // when rendering the list rows but keep them in the JSON so the
        // agent has full context for verification.
        var listEl = grvDeleteModal.querySelector('[data-role="grv-delete-list"]');
        if (listEl) {
          listEl.innerHTML = '';
          entries.forEach(function (e) {
            var li = document.createElement('li');
            li.className = 'grv-delete-list-item';
            var typeEl = document.createElement('span');
            typeEl.className = 'grv-delete-list-type';
            typeEl.textContent = e.typeLabel;
            var headingEl = document.createElement('span');
            headingEl.className = 'grv-delete-list-heading';
            headingEl.title = e.sectionHeading;
            headingEl.textContent = e.sectionHeading || '(no heading)';
            li.appendChild(typeEl);
            li.appendChild(headingEl);
            listEl.appendChild(li);
          });
        }

        // Title + JSON envelope
        var titleEl = grvDeleteModal.querySelector('[data-role="grv-delete-title"]');
        if (titleEl) {
          titleEl.textContent = 'Delete ' + entries.length + ' graveyard entr'
            + (entries.length === 1 ? 'y' : 'ies') + '?';
        }
        grvDeletePayload = {
          kind: 'graveyardPermanentDelete',
          brand: brandId,
          at: new Date().toISOString(),
          deletions: entries.map(function (e) {
            var d = { id: e.id, type: e.type, sectionHeading: e.sectionHeading };
            if (e.removedFrom) d.removedFrom = e.removedFrom;
            return d;
          }),
        };
        var jsonEl = grvDeleteModal.querySelector('[data-role="grv-delete-json"]');
        if (jsonEl) jsonEl.textContent = JSON.stringify(grvDeletePayload, null, 2);

        grvDeleteModal.hidden = false;
        var copyBtn = grvDeleteModal.querySelector('[data-grv-act="grv-delete-copy"]');
        if (copyBtn && typeof copyBtn.focus === 'function') copyBtn.focus({ preventScroll: true });
      }

      function closeGrvDeleteModal() {
        if (!grvDeleteModal) return;
        grvDeleteModal.hidden = true;
        grvDeletePayload = null;
      }

      function copyGrvDeletePayload(btn) {
        if (!grvDeletePayload) return;
        var text = JSON.stringify(grvDeletePayload, null, 2);
        try {
          navigator.clipboard.writeText(text).then(function () {
            btn.classList.add('is-copied');
            var prev = btn.textContent;
            btn.textContent = 'Copied ✓ — paste into chat';
            setTimeout(function () {
              btn.classList.remove('is-copied');
              btn.textContent = prev;
            }, 2200);
          });
        } catch (_) {}
      }

      function wireGraveyard() {
        var panel = document.getElementById('opt-tab-graveyard');
        if (!panel) return;
        grvModal = document.getElementById('grv-modal');
        grvDeleteModal = document.getElementById('grv-delete-modal');

        wireGraveyardSort(panel);
        wireGraveyardSelection(panel);

        panel.addEventListener('click', function (ev) {
          var btn = ev.target && ev.target.closest && ev.target.closest('[data-grv-act]');
          if (!btn) return;
          var act = btn.getAttribute('data-grv-act');
          var id = btn.getAttribute('data-grv-id');
          if (act === 'open' && id) {
            ev.preventDefault();
            openGrvModal(panel, id);
          } else if (act === 'restore' && id) {
            ev.preventDefault();
            if (claimGrvClick(btn)) doRestore(panel, btn, id, false);
          }
        });

        if (grvModal) {
          grvModal.addEventListener('click', function (ev) {
            var btn = ev.target && ev.target.closest && ev.target.closest('[data-grv-act]');
            if (!btn) return;
            var act = btn.getAttribute('data-grv-act');
            if (act === 'close-modal') closeGrvModal();
            else if (act === 'modal-restore') {
              if (!grvModalEntry) return;
              if (claimGrvClick(btn)) doRestore(document.getElementById('opt-tab-graveyard'), btn, grvModalEntry.id, true);
            } else if (act === 'modal-copy') {
              if (!grvModalEntry) return;
              try {
                navigator.clipboard.writeText(grvModalEntry.jsonStr || '').then(function () {
                  btn.classList.add('is-copied');
                  var prev = btn.textContent;
                  btn.textContent = 'Copied ✓';
                  setTimeout(function () {
                    btn.classList.remove('is-copied');
                    btn.textContent = prev;
                  }, 1400);
                });
              } catch (_) {}
            }
          });
        }

        document.addEventListener('keydown', function (ev) {
          if (ev.key !== 'Escape') return;
          if (grvDeleteModal && !grvDeleteModal.hidden) {
            ev.preventDefault();
            closeGrvDeleteModal();
            return;
          }
          if (grvModal && !grvModal.hidden) {
            ev.preventDefault();
            closeGrvModal();
          }
        });
      }

      function openGrvModal(panel, id) {
        if (!grvModal) return;
        var card = panel.querySelector('.grv-card[data-grv-id="' + id + '"]');
        var pre = panel.querySelector('[data-grv-json="' + id + '"]');
        if (!card || !pre) return;
        var jsonStr = pre.textContent || '{}';
        var section;
        try { section = JSON.parse(jsonStr); } catch (_) { section = {}; }
        var typeLabel = card.getAttribute('data-grv-type-label') || 'Section';
        var type = card.getAttribute('data-grv-type') || '';
        var page = card.getAttribute('data-grv-restore-page') || '/';
        var whenEl = card.querySelector('.grv-card-when');
        var when = whenEl ? (whenEl.getAttribute('title') || whenEl.textContent || '') : '';

        grvModalEntry = { id: id, jsonStr: jsonStr, type: type, typeLabel: typeLabel, page: page };

        var titleEl = grvModal.querySelector('[data-role="modal-title"]');
        var eyebrowEl = grvModal.querySelector('[data-role="modal-eyebrow"]');
        var previewEl = grvModal.querySelector('[data-role="modal-preview"]');
        var jsonEl = grvModal.querySelector('[data-role="modal-json"]');
        var statusEl = grvModal.querySelector('[data-role="modal-restore-status"]');
        var restoreBtn = grvModal.querySelector('[data-grv-act="modal-restore"]');
        var timelineEl = grvModal.querySelector('[data-role="modal-timeline"]');

        var livePage = card.getAttribute('data-grv-live-page') || '';
        var liveSince = card.getAttribute('data-grv-live-since') || '';
        var isLive = !!livePage;

        if (titleEl) titleEl.textContent = typeLabel;
        if (eyebrowEl) {
          var liveSuffix = isLive
            ? ' · <span class="grv-card-live" style="font-size:9.5px;padding:.18rem .4rem"><span class="grv-card-live-dot"></span>LIVE on <code>' + escapeHtmlText(livePage) + '</code></span>'
            : '';
          eyebrowEl.innerHTML = 'first removed from <code>' + escapeHtmlText(page) + '</code>'
            + (when ? ' · ' + escapeHtmlText(when) : '')
            + liveSuffix;
        }
        if (previewEl) {
          previewEl.innerHTML = '';
          previewEl.appendChild(renderGrvPreview(type, section));
        }
        if (jsonEl) jsonEl.textContent = jsonStr;
        if (statusEl) { statusEl.hidden = true; statusEl.innerHTML = ''; }
        if (restoreBtn) {
          restoreBtn.classList.remove('is-copied');
          if (isLive) {
            restoreBtn.textContent = 'Already live on ' + livePage;
            restoreBtn.disabled = true;
            restoreBtn.title = 'This section is currently live — remove it from the page first if you want to re-restore.';
          } else {
            restoreBtn.textContent = 'Restore to ' + page;
            restoreBtn.disabled = false;
            restoreBtn.removeAttribute('title');
          }
        }
        if (timelineEl) renderGrvTimeline(panel, id, timelineEl);
        renderGrvDependencies(panel, id);

        grvModal.hidden = false;
        // Focus management: send focus into the modal panel.
        var closeBtn = grvModal.querySelector('.grv-modal-close');
        if (closeBtn && typeof closeBtn.focus === 'function') closeBtn.focus({ preventScroll: true });
      }

      // Reads the hidden <script data-grv-deps="<id>"> block (only
      // emitted when entry.dependencies is non-empty) and renders a
      // grouped summary in the modal. Each group shows the collection
      // name + item count, then per-item rows with a one-line summary
      // (most informative field first) + a Show all fields toggle.
      function renderGrvDependencies(panel, id) {
        if (!grvModal) return;
        var depsBlock = grvModal.querySelector('[data-role="modal-deps"]');
        var depsBody = grvModal.querySelector('[data-role="modal-deps-body"]');
        var depsMeta = grvModal.querySelector('[data-role="modal-deps-meta"]');
        if (!depsBlock || !depsBody) return;
        depsBody.innerHTML = '';

        var src = panel.querySelector('[data-grv-deps="' + id + '"]');
        var deps = null;
        if (src && src.textContent) {
          try {
            var parsed = JSON.parse(src.textContent);
            if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) deps = parsed;
          } catch (_) {}
        }
        if (!deps) {
          depsBlock.hidden = true;
          if (depsMeta) depsMeta.textContent = '';
          return;
        }
        depsBlock.hidden = false;

        var totalCount = 0;
        var groupCount = 0;
        Object.keys(deps).forEach(function (groupName) {
          var items = deps[groupName];
          if (!Array.isArray(items) || !items.length) return;
          groupCount++;
          totalCount += items.length;

          var groupEl = document.createElement('div');
          groupEl.className = 'grv-modal-deps-group';

          var nameEl = document.createElement('p');
          nameEl.className = 'grv-modal-deps-group-name';
          nameEl.textContent = groupName;
          var countCode = document.createElement('code');
          countCode.textContent = items.length + ' item' + (items.length === 1 ? '' : 's');
          nameEl.appendChild(countCode);
          groupEl.appendChild(nameEl);

          var listEl = document.createElement('ul');
          listEl.className = 'grv-modal-deps-list';
          items.forEach(function (item, i) {
            var li = document.createElement('li');
            li.className = 'grv-modal-deps-item';

            var idEl = document.createElement('span');
            idEl.className = 'grv-modal-deps-item-id';
            idEl.textContent = (item && (item.id || item.slug)) ? String(item.id || item.slug) : ('#' + (i + 1));

            var summaryEl = document.createElement('span');
            summaryEl.className = 'grv-modal-deps-item-summary';
            var summaryText = depItemSummary(item);
            summaryEl.textContent = summaryText;
            summaryEl.title = summaryText;

            li.appendChild(idEl);
            li.appendChild(summaryEl);

            // Show-all-fields details (collapsed by default)
            var details = document.createElement('details');
            details.className = 'grv-modal-deps-item-fields';
            var summaryToggle = document.createElement('summary');
            summaryToggle.textContent = 'Show all fields';
            var pre = document.createElement('pre');
            try { pre.textContent = JSON.stringify(item, null, 2); }
            catch (_) { pre.textContent = String(item); }
            details.appendChild(summaryToggle);
            details.appendChild(pre);
            li.appendChild(details);

            listEl.appendChild(li);
          });
          groupEl.appendChild(listEl);
          depsBody.appendChild(groupEl);
        });

        if (depsMeta) {
          depsMeta.textContent = totalCount + ' item' + (totalCount === 1 ? '' : 's')
            + ' across ' + groupCount + ' collection' + (groupCount === 1 ? '' : 's');
        }
      }

      // Picks the most identifying single string from a dependency
      // item — typically a quote/title/heading/name/text, fallback to
      // the first string-valued field.
      function depItemSummary(item) {
        if (!item || typeof item !== 'object') return String(item == null ? '' : item);
        var prefer = ['quote', 'title', 'heading', 'name', 'label', 'text', 'body', 'lead', 'question', 'answer'];
        for (var i = 0; i < prefer.length; i++) {
          var v = item[prefer[i]];
          if (typeof v === 'string' && v.trim()) {
            var t = v.trim();
            return t.length > 100 ? t.slice(0, 97) + '…' : t;
          }
        }
        var skip = ['id', 'slug', 'type'];
        var keys = Object.keys(item);
        for (var j = 0; j < keys.length; j++) {
          if (skip.indexOf(keys[j]) >= 0) continue;
          var val = item[keys[j]];
          if (typeof val === 'string' && val.trim()) {
            var s = val.trim();
            return s.length > 100 ? s.slice(0, 97) + '…' : s;
          }
        }
        return '(no summary)';
      }

      function closeGrvModal() {
        if (!grvModal) return;
        grvModal.hidden = true;
        grvModalEntry = null;
      }

      function escapeHtmlText(s) {
        return String(s == null ? '' : s)
          .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
      }

      // Type-aware preview registry. New types add a branch here; the
      // generic `renderKvList` is the safe fallback so any unknown shape
      // still renders cleanly.
      function renderGrvPreview(type, section) {
        var wrap = document.createElement('div');
        wrap.className = 'grv-preview-' + (type || 'unknown');
        if (type === 'designBreak') {
          renderDesignBreakPreview(wrap, section);
        } else if (type === 'contentSection') {
          renderContentSectionPreview(wrap, section);
        } else if (type === 'statRibbon') {
          renderStatRibbonPreview(wrap, section);
        } else {
          renderKvList(wrap, section);
        }
        return wrap;
      }

      function renderStatRibbonPreview(wrap, sec) {
        // Stats-led section — eyebrow + heading + a row of value/label
        // pairs + optional CTA + variant tag.
        if (sec.sectionLabel) {
          var eyebrow = document.createElement('p');
          eyebrow.className = 'grv-preview-eyebrow';
          eyebrow.textContent = String(sec.sectionLabel);
          wrap.appendChild(eyebrow);
        }
        if (sec.heading) {
          var h = document.createElement('h4');
          h.className = 'grv-preview-heading';
          h.textContent = String(sec.heading);
          wrap.appendChild(h);
        }
        if (Array.isArray(sec.stats) && sec.stats.length) {
          var row = document.createElement('div');
          row.className = 'grv-preview-stats';
          sec.stats.forEach(function (s) {
            if (!s || !s.value || !s.label) return;
            var item = document.createElement('div');
            item.className = 'grv-preview-stat';
            var v = document.createElement('span');
            v.className = 'grv-preview-stat-value';
            v.textContent = String(s.value);
            item.appendChild(v);
            var l = document.createElement('span');
            l.className = 'grv-preview-stat-label';
            l.textContent = String(s.label);
            item.appendChild(l);
            if (s.sublabel) {
              var sub = document.createElement('span');
              sub.className = 'grv-preview-stat-sublabel';
              sub.textContent = String(s.sublabel);
              item.appendChild(sub);
            }
            row.appendChild(item);
          });
          if (row.children.length) wrap.appendChild(row);
        }
        if (sec.cta && (sec.cta.label || sec.cta.href)) {
          var cta = document.createElement('span');
          cta.className = 'grv-preview-cta';
          cta.textContent = sec.cta.label || '(no label)';
          if (sec.cta.href) {
            var href = document.createElement('code');
            href.textContent = sec.cta.href;
            cta.appendChild(href);
          }
          wrap.appendChild(cta);
        }
        if (sec.variant) {
          var v2 = document.createElement('p');
          v2.className = 'grv-preview-eyebrow';
          v2.style.opacity = '.6';
          var variantLabel = ({ A: 'Compact', B: 'Display', C: 'Bordered' })[String(sec.variant)] || String(sec.variant);
          v2.textContent = 'variant: ' + String(sec.variant) + ' · ' + variantLabel;
          wrap.appendChild(v2);
        }
        if (!wrap.children.length) renderKvList(wrap, sec);
      }

      function renderContentSectionPreview(wrap, sec) {
        // Text-only section — no image rendering. Shows eyebrow +
        // heading + each paragraph + CTA + variant tag, in that order.
        if (sec.sectionLabel) {
          var eyebrow = document.createElement('p');
          eyebrow.className = 'grv-preview-eyebrow';
          eyebrow.textContent = String(sec.sectionLabel);
          wrap.appendChild(eyebrow);
        }
        if (sec.heading) {
          var h = document.createElement('h4');
          h.className = 'grv-preview-heading';
          h.textContent = String(sec.heading);
          wrap.appendChild(h);
        }
        // body may be a single string OR an array — render each as its
        // own paragraph so the modal preview reads like the live section.
        var paragraphs = [];
        if (Array.isArray(sec.body)) paragraphs = sec.body;
        else if (typeof sec.body === 'string' && sec.body) paragraphs = [sec.body];
        paragraphs.forEach(function (p) {
          var pEl = document.createElement('p');
          pEl.className = 'grv-preview-subtext';
          pEl.textContent = String(p);
          wrap.appendChild(pEl);
        });
        if (sec.cta && (sec.cta.label || sec.cta.href)) {
          var cta = document.createElement('span');
          cta.className = 'grv-preview-cta';
          cta.textContent = sec.cta.label || '(no label)';
          if (sec.cta.href) {
            var href = document.createElement('code');
            href.textContent = sec.cta.href;
            cta.appendChild(href);
          }
          wrap.appendChild(cta);
        }
        if (sec.variant) {
          var v = document.createElement('p');
          v.className = 'grv-preview-eyebrow';
          v.style.opacity = '.6';
          var variantLabel = ({ A: 'Standard', B: 'Centered', C: 'Editorial' })[String(sec.variant)] || String(sec.variant);
          v.textContent = 'variant: ' + String(sec.variant) + ' · ' + variantLabel;
          wrap.appendChild(v);
        }
        if (!wrap.children.length) renderKvList(wrap, sec);
      }

      function renderDesignBreakPreview(wrap, sec) {
        if (sec.backgroundImage) {
          var img = document.createElement('img');
          img.className = 'grv-preview-bg';
          img.src = String(sec.backgroundImage);
          img.alt = '';
          img.loading = 'lazy';
          img.onerror = function () { img.style.display = 'none'; };
          wrap.appendChild(img);
        }
        if (sec.sectionLabel) {
          var eyebrow = document.createElement('p');
          eyebrow.className = 'grv-preview-eyebrow';
          eyebrow.textContent = String(sec.sectionLabel);
          wrap.appendChild(eyebrow);
        }
        if (sec.heading) {
          var h = document.createElement('h4');
          h.className = 'grv-preview-heading';
          h.textContent = String(sec.heading);
          wrap.appendChild(h);
        }
        if (sec.subtext) {
          var sub = document.createElement('p');
          sub.className = 'grv-preview-subtext';
          sub.textContent = String(sec.subtext);
          wrap.appendChild(sub);
        }
        if (sec.cta && (sec.cta.label || sec.cta.href)) {
          var cta = document.createElement('span');
          cta.className = 'grv-preview-cta';
          cta.textContent = sec.cta.label || '(no label)';
          if (sec.cta.href) {
            var href = document.createElement('code');
            href.textContent = sec.cta.href;
            cta.appendChild(href);
          }
          wrap.appendChild(cta);
        }
        // If absolutely nothing rendered, fall back to kv-list so the
        // user still sees something useful.
        if (!wrap.children.length) renderKvList(wrap, sec);
      }

      // Lifecycle timeline — renders the append-only event log for a
      // graveyard entry. Reads the JSON cached in the card's
      // <script data-grv-lifecycle> tag (server-rendered) so it works
      // for any entry without re-fetching graveyard.json.
      function renderGrvTimeline(panel, id, listEl) {
        listEl.innerHTML = '';
        var src = panel.querySelector('[data-grv-lifecycle="' + id + '"]');
        var events = [];
        if (src && src.textContent) {
          try {
            var parsed = JSON.parse(src.textContent);
            if (Array.isArray(parsed)) events = parsed;
          } catch (_) {}
        }
        if (!events.length) {
          var li = document.createElement('li');
          li.className = 'grv-timeline-empty';
          li.textContent = 'No lifecycle events recorded for this entry.';
          listEl.appendChild(li);
          return;
        }
        events.forEach(function (ev, i) {
          var li = document.createElement('li');
          li.className = 'grv-timeline-event';
          li.setAttribute('data-kind', ev && ev.kind ? String(ev.kind) : 'unknown');
          if (i === events.length - 1) li.setAttribute('data-latest', '1');

          var line = document.createElement('div');
          line.className = 'grv-timeline-line';

          var kind = document.createElement('span');
          kind.className = 'grv-timeline-kind';
          kind.textContent = (ev && ev.kind) ? String(ev.kind) : 'event';
          line.appendChild(kind);

          var where = document.createElement('span');
          where.className = 'grv-timeline-where';
          var loc = (ev && (ev.from || ev.to)) || '';
          if (loc) {
            var prefix = ev.kind === 'restored' ? 'to ' : 'from ';
            var locCode = document.createElement('code');
            locCode.textContent = loc;
            where.append(prefix);
            where.appendChild(locCode);
          }
          line.appendChild(where);
          li.appendChild(line);

          if (ev && ev.at) {
            var when = document.createElement('span');
            when.className = 'grv-timeline-when';
            var rel = relativeTimeJs(ev.at);
            var abs = '';
            try {
              abs = new Date(ev.at).toLocaleString('en-US', {
                month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit',
              });
            } catch (_) {}
            when.textContent = rel + (abs ? ' · ' + abs : '');
            li.appendChild(when);
          }
          if (ev && ev.originalFile) {
            var file = document.createElement('span');
            file.className = 'grv-timeline-when';
            file.textContent = ev.originalFile;
            li.appendChild(file);
          }
          // Render a "Restore snapshot" button when this event preserved
          // a prior section snapshot. Clicking it stages a restoration
          // using the priorSection content instead of entry.section,
          // letting the user roll back to an earlier shape of the section.
          // The current entry.section stays as the default Restore target.
          if (ev && ev.priorSection && typeof ev.priorSection === 'object') {
            var snapBar = document.createElement('div');
            snapBar.className = 'grv-timeline-snapshot';
            var snapNote = document.createElement('span');
            snapNote.className = 'grv-timeline-snapshot-note';
            snapNote.textContent = 'Captured a prior version of this section.';
            snapBar.appendChild(snapNote);
            var snapBtn = document.createElement('button');
            snapBtn.type = 'button';
            snapBtn.className = 'grv-timeline-snapshot-btn';
            snapBtn.setAttribute('data-grv-snapshot-event-idx', String(i));
            snapBtn.setAttribute('data-grv-snapshot-entry-id', id);
            snapBtn.textContent = 'Restore this snapshot';
            snapBtn.addEventListener('click', function (e) {
              e.preventDefault();
              e.stopPropagation();
              if (!claimGrvClick(e.currentTarget)) return;
              doRestoreSnapshot(panel, e.currentTarget, id, parseInt(e.currentTarget.getAttribute('data-grv-snapshot-event-idx') || '-1', 10), true);
            });
            snapBar.appendChild(snapBtn);
            li.appendChild(snapBar);
          }
          listEl.appendChild(li);
        });
      }

      // Restores a section using a `priorSection` snapshot from the
      // lifecycle log instead of entry.section. The default Restore button
      // uses entry.section (latest); this lets the user pick an earlier
      // shape. Routes through the same per-type injection channels as
      // doRestore, but tags the staged entry with `fromSnapshot` so the
      // agent processing the restoration can record which snapshot was
      // picked on the new lifecycle event.
      function doRestoreSnapshot(panel, btn, entryId, eventIdx, fromModal) {
        if (!panel) panel = document.getElementById('opt-tab-graveyard');
        var card = panel ? panel.querySelector('.grv-card[data-grv-id="' + entryId + '"]') : null;
        var lifeEl = panel ? panel.querySelector('[data-grv-lifecycle="' + entryId + '"]') : null;
        if (!card || !lifeEl) return { ok: false, reason: 'not-found' };
        var lifecycle = [];
        try { lifecycle = JSON.parse(lifeEl.textContent || '[]'); } catch (_) {}
        var event = (Array.isArray(lifecycle) && eventIdx >= 0) ? lifecycle[eventIdx] : null;
        if (!event || !event.priorSection || typeof event.priorSection !== 'object') {
          showRestoreStatus(panel, entryId, fromModal, 'No snapshot found at this lifecycle event.', true);
          return { ok: false, reason: 'no-snapshot' };
        }
        var sectionJson = event.priorSection;
        var targetPage = card.getAttribute('data-grv-restore-page') || '/';
        var sectionType = card.getAttribute('data-grv-type') || sectionJson.type || '';
        var typeLabel = card.getAttribute('data-grv-type-label') || sectionType;
        var fromSnapshotMeta = { eventIdx: eventIdx, at: event.at || null, kind: event.kind || null };

        var storageKey, stageEntry, kindNoun;
        if (sectionType === 'designBreak') {
          storageKey = 'aed:db-inject:' + targetPage;
          stageEntry = { id: 'dbi-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 8), afterIndex: 999, props: sectionJson, restoredFromGraveyardId: entryId, fromSnapshot: fromSnapshotMeta };
          kindNoun = 'design break';
        } else if (sectionType === 'contentSection') {
          storageKey = 'aed:cs-inject:' + targetPage;
          stageEntry = { id: 'csi-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 8), afterIndex: 999, props: sectionJson, restoredFromGraveyardId: entryId, fromSnapshot: fromSnapshotMeta };
          kindNoun = 'content section';
        } else if (sectionType === 'statRibbon') {
          storageKey = 'aed:sr-inject:' + targetPage;
          stageEntry = { id: 'sri-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 8), afterIndex: 999, props: sectionJson, restoredFromGraveyardId: entryId, fromSnapshot: fromSnapshotMeta };
          kindNoun = 'stat ribbon';
        } else if (sectionType === 'photoGallery') {
          storageKey = 'aed:pg-inject:' + targetPage;
          stageEntry = { id: 'pgi-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 8), afterIndex: 999, props: sectionJson, restoredFromGraveyardId: entryId, fromSnapshot: fromSnapshotMeta };
          kindNoun = 'photo gallery';
        } else {
          storageKey = 'aed:sec-restore:' + targetPage;
          stageEntry = { id: 'srr-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 8), sectionType: sectionType, sectionTypeLabel: typeLabel, props: sectionJson, restoredFromGraveyardId: entryId, fromSnapshot: fromSnapshotMeta };
          kindNoun = typeLabel.toLowerCase();
        }

        var existing = [];
        try { var raw = localStorage.getItem(storageKey); if (raw) { var parsed = JSON.parse(raw); if (Array.isArray(parsed)) existing = parsed; } } catch (_) {}
        existing.push(stageEntry);
        try { localStorage.setItem(storageKey, JSON.stringify(existing)); }
        catch (_) {
          showRestoreStatus(panel, entryId, fromModal, 'localStorage write failed — your browser may be blocking storage.', true);
          return { ok: false, reason: 'storage-write-failed' };
        }

        if (btn) {
          btn.classList.add('is-copied');
          var prev = btn.textContent;
          btn.textContent = 'Snapshot staged ✓';
          setTimeout(function () { btn.classList.remove('is-copied'); btn.textContent = prev; }, 1600);
        }
        var snapWhen = event.at ? relativeTimeJs(event.at) : 'earlier';
        showRestoreStatus(
          panel, entryId, fromModal,
          'Snapshot from ' + snapWhen + ' (event #' + (eventIdx + 1) + ') staged for <a href="' + targetPage + '">' + targetPage + '</a>. Open that page in the editor and Copy Patch to ship.'
        );
        return { ok: true, kindNoun: kindNoun, targetPage: targetPage, fromSnapshot: fromSnapshotMeta };
      }

      // Per-button click cooldown — returns true ONCE per ~1.2s window,
      // false on any duplicate click in that window. Prevents the
      // double-stage bug where a fast double-click on Restore /
      // RestoreSnapshot adds the same entry to localStorage twice (each
      // copy then needs to be reconciled by the agent — see the duplicate
      // photoGalleryInjections incident in this brand's history).
      // Mark style: aria-busy + .is-busy class for CSS feedback if wanted.
      function claimGrvClick(btn) {
        if (!btn) return true;
        if (btn.getAttribute('aria-busy') === 'true') return false;
        btn.setAttribute('aria-busy', 'true');
        btn.classList.add('is-busy');
        setTimeout(function () {
          btn.removeAttribute('aria-busy');
          btn.classList.remove('is-busy');
        }, 1200);
        return true;
      }

      // Client-side mirror of the frontmatter relativeTime — used by the
      // timeline for events whose `at` only has an absolute ISO timestamp.
      function relativeTimeJs(iso) {
        if (!iso) return '';
        var t = new Date(iso).getTime();
        if (!isFinite(t)) return iso;
        var diff = Date.now() - t;
        var min = 60000, hr = 60 * min, day = 24 * hr;
        if (diff < min) return 'just now';
        if (diff < hr) return Math.floor(diff / min) + 'm ago';
        if (diff < day) return Math.floor(diff / hr) + 'h ago';
        if (diff < 30 * day) return Math.floor(diff / day) + 'd ago';
        try {
          return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        } catch (_) { return iso; }
      }

      // Generic key/value renderer — safe fallback for any section type.
      function renderKvList(wrap, sec) {
        var dl = document.createElement('dl');
        dl.className = 'grv-preview-kv';
        var keys = Object.keys(sec || {});
        if (!keys.length) {
          var note = document.createElement('p');
          note.className = 'grv-preview-subtext';
          note.textContent = '(empty section)';
          wrap.appendChild(note);
          return;
        }
        keys.forEach(function (k) {
          var dt = document.createElement('dt');
          dt.textContent = k;
          var dd = document.createElement('dd');
          var v = sec[k];
          if (v == null) dd.textContent = String(v);
          else if (typeof v === 'string' || typeof v === 'number' || typeof v === 'boolean') dd.textContent = String(v);
          else {
            dd.classList.add('is-complex');
            try { dd.textContent = JSON.stringify(v, null, 2); }
            catch (_) { dd.textContent = String(v); }
          }
          dl.appendChild(dt);
          dl.appendChild(dd);
        });
        wrap.appendChild(dl);
      }

      // Stages a graveyard entry for re-insertion in the editor's
      // localStorage, keyed to the original page. The storage prefix +
      // entry shape is type-routed so each section type goes through
      // the right channel:
      //   designBreak    → aed:db-inject:<page>  (props-only injection)
      //   contentSection → aed:cs-inject:<page>  (props-only injection)
      //   statRibbon     → aed:sr-inject:<page>  (props-only injection)
      //   anything else  → aed:sec-restore:<page> (verbatim restoration)
      // DB/CS/SR use their existing injection storage so the user sees the
      // standard pending marker on the target page. Generic types have
      // no editor insert UI, so they go through a simpler restore-only
      // channel that just appears in the per-page feedback panel.
      function doRestore(panel, btn, id, fromModal) {
        if (!panel) panel = document.getElementById('opt-tab-graveyard');
        var card = panel ? panel.querySelector('.grv-card[data-grv-id="' + id + '"]') : null;
        var pre = panel ? panel.querySelector('[data-grv-json="' + id + '"]') : null;
        if (!card || !pre) return { ok: false, reason: 'not-found' };
        // Bulk restore can call this with no btn — we suppress the
        // button-flash feedback and only surface a single rolled-up
        // status message at the call site.
        var hasBtn = !!btn;
        var sectionJson;
        try { sectionJson = JSON.parse(pre.textContent || '{}'); }
        catch (_) {
          if (hasBtn) showRestoreStatus(panel, id, fromModal, 'Could not parse the archived JSON. Try Copy JSON and re-add manually.', true);
          return { ok: false, reason: 'parse-error' };
        }
        var targetPage = card.getAttribute('data-grv-restore-page') || '/';
        var sectionType = card.getAttribute('data-grv-type') || '';
        var typeLabel = card.getAttribute('data-grv-type-label') || sectionType;

        var storageKey, entry, kindNoun;
        if (sectionType === 'designBreak') {
          storageKey = 'aed:db-inject:' + targetPage;
          entry = {
            id: 'dbi-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 8),
            afterIndex: 999,
            props: sectionJson,
            restoredFromGraveyardId: id,
          };
          kindNoun = 'design break';
        } else if (sectionType === 'contentSection') {
          storageKey = 'aed:cs-inject:' + targetPage;
          entry = {
            id: 'csi-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 8),
            afterIndex: 999,
            props: sectionJson,
            restoredFromGraveyardId: id,
          };
          kindNoun = 'content section';
        } else if (sectionType === 'statRibbon') {
          storageKey = 'aed:sr-inject:' + targetPage;
          entry = {
            id: 'sri-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 8),
            afterIndex: 999,
            props: sectionJson,
            restoredFromGraveyardId: id,
          };
          kindNoun = 'stat ribbon';
        } else if (sectionType === 'photoGallery') {
          storageKey = 'aed:pg-inject:' + targetPage;
          entry = {
            id: 'pgi-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 8),
            afterIndex: 999,
            props: sectionJson,
            restoredFromGraveyardId: id,
          };
          kindNoun = 'photo gallery';
        } else {
          // Generic types use the simpler restore-only channel.
          storageKey = 'aed:sec-restore:' + targetPage;
          entry = {
            id: 'srr-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 8),
            sectionType: sectionType,
            sectionTypeLabel: typeLabel,
            props: sectionJson,
            restoredFromGraveyardId: id,
          };
          kindNoun = typeLabel.toLowerCase();
        }

        var existing = [];
        try {
          var raw = localStorage.getItem(storageKey);
          if (raw) {
            var parsed = JSON.parse(raw);
            if (Array.isArray(parsed)) existing = parsed;
          }
        } catch (_) {}
        existing.push(entry);
        try {
          localStorage.setItem(storageKey, JSON.stringify(existing));
        } catch (_) {
          if (hasBtn) showRestoreStatus(panel, id, fromModal, 'localStorage write failed — your browser may be blocking storage.', true);
          return { ok: false, reason: 'storage-write-failed' };
        }

        if (hasBtn) {
          btn.classList.add('is-copied');
          var prev = btn.textContent;
          btn.textContent = 'Restored ✓';
          setTimeout(function () {
            btn.classList.remove('is-copied');
            btn.textContent = prev;
          }, 1400);
          showRestoreStatus(
            panel, id, fromModal,
            kindNoun + ' staged for <a href="' + targetPage + '">' + targetPage + '</a>. Open that page in the editor and Copy Patch to ship — or remove the pending entry from the per-page feedback panel to undo.'
          );
        }
        return { ok: true, kindNoun: kindNoun, targetPage: targetPage };
      }

      function showRestoreStatus(panel, id, fromModal, html, isError) {
        if (fromModal && grvModal) {
          var modalStatus = grvModal.querySelector('[data-role="modal-restore-status"]');
          if (modalStatus) {
            modalStatus.innerHTML = html;
            modalStatus.hidden = false;
            modalStatus.style.borderColor = isError ? 'var(--text-secondary)' : '';
          }
        }
        if (panel) {
          var status = panel.querySelector('[data-grv-restore-status="' + id + '"]');
          if (status) {
            status.innerHTML = html;
            status.hidden = false;
            status.style.borderColor = isError ? 'var(--text-secondary)' : '';
          }
        }
      }
      function block() {
        gate.hidden = true;
        content.hidden = true;
        denied.hidden = false;
      }

      // --- IP gate (mirrors bootstrap.js logic) -----------------------------
      gate.hidden = false;
      var forced = false;
      try { forced = localStorage.getItem('aed:force') === '1'; } catch (_) {}
      if (forced) {
        reveal();
      } else {
        var checked = false;
        function check(url, next) {
          fetch(url).then(function (r) { return r.json(); })
            .then(function (d) {
              if (checked) return;
              if (allowlist.indexOf(d.ip) > -1) { checked = true; reveal(); }
              else if (next) next();
              else if (!checked) { checked = true; block(); }
            })
            .catch(function () { if (next) next(); else if (!checked) { checked = true; block(); } });
        }
        check('https://api4.ipify.org?format=json', function () {
          check('https://api.ipify.org?format=json');
        });
      }

      // --- Selection wiring (independent groups, one per swappable part) ---
      var GROUPS = {
        nav:           { kind: 'nav',     key: 'aed:nav-variant',            valid: /^[B-G]$/, label: 'Header' },
        footer:        { kind: 'footer',  key: 'aed:footer-variant',         valid: /^[B-F]$/, label: 'Footer' },
        hero:          { kind: 'section', key: 'aed:hero-variant',           valid: /^[B-F]$/, label: 'Hero' },
        services:      { kind: 'section', key: 'aed:services-variant',       valid: /^[B-F]$/, label: 'Services' },
        contact:       { kind: 'section', key: 'aed:contact-variant',        valid: /^[B-F]$/, label: 'Contact' },
        faq:           { kind: 'section', key: 'aed:faq-variant',            valid: /^[B-F]$/, label: 'FAQ' },
        why:           { kind: 'section', key: 'aed:why-variant',            valid: /^[B-G]$/, label: 'Why' },
        cta:           { kind: 'section', key: 'aed:cta-variant',            valid: /^[B-F]$/, label: 'CTA' },
        testimonials:  { kind: 'section', key: 'aed:testimonials-variant',   valid: /^[B-F]$/, label: 'Testimonials' },
        workDetail:    { kind: 'page',    key: 'aed:work-detail-variant',    valid: /^[B-F]$/, label: 'Work detail' },
        serviceDetail: { kind: 'page',    key: 'aed:service-detail-variant', valid: /^[B-F]$/, label: 'Service detail' }
      };
      function currentFor(group) {
        try {
          var v = localStorage.getItem(GROUPS[group].key);
          return (v && GROUPS[group].valid.test(v)) ? v : 'A';
        } catch (_) { return 'A'; }
      }
      var pending = {};
      Object.keys(GROUPS).forEach(function (g) { pending[g] = currentFor(g); });
      var activeKind = 'all';
      var activeGroup = null;
      var modifiedOnly = false;
      var query = '';

      function groupIsChanged(g) {
        if (!GROUPS[g]) return false;
        var live = currentFor(g);
        return live !== 'A' || pending[g] !== live;
      }

      function groupsForKind(kind) {
        return Object.keys(GROUPS).filter(function (g) { return GROUPS[g].kind === kind; });
      }

      function shouldShowSubfilters() {
        return (activeKind === 'section' || activeKind === 'page') && groupsForKind(activeKind).length > 1;
      }

      function countCardsInGroup(g) {
        var n = 0;
        cards.forEach(function (c) { if (c.dataset.group === g) n++; });
        return n;
      }

      function renderSubfilters() {
        subfiltersEl.innerHTML = '';
        if (!shouldShowSubfilters()) {
          subfiltersEl.hidden = true;
          return;
        }
        subfiltersEl.hidden = false;

        var allBtn = document.createElement('button');
        allBtn.type = 'button';
        allBtn.className = 'opt-subfilter-pill';
        allBtn.dataset.group = '';
        allBtn.setAttribute('aria-pressed', activeGroup === null ? 'true' : 'false');
        allBtn.textContent = 'All ' + (activeKind === 'section' ? 'sections' : 'pages');
        allBtn.addEventListener('click', function () { setGroup(null); });
        subfiltersEl.appendChild(allBtn);

        groupsForKind(activeKind).forEach(function (g) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'opt-subfilter-pill';
          btn.dataset.group = g;
          btn.setAttribute('aria-pressed', activeGroup === g ? 'true' : 'false');
          if (groupIsChanged(g)) btn.dataset.modified = 'true';

          var label = document.createElement('span');
          label.textContent = GROUPS[g].label;
          btn.appendChild(label);

          var cnt = document.createElement('span');
          cnt.className = 'opt-subfilter-count';
          cnt.textContent = countCardsInGroup(g);
          btn.appendChild(cnt);

          btn.addEventListener('click', function () { setGroup(g); });
          subfiltersEl.appendChild(btn);
        });
      }

      function setKind(kind) {
        activeKind = kind;
        activeGroup = null;
        pills.forEach(function (x) {
          x.setAttribute('aria-pressed', x.dataset.filter === kind ? 'true' : 'false');
        });
        renderSubfilters();
        applyFilters();
      }

      function setGroup(group) {
        activeGroup = group;
        renderSubfilters();
        applyFilters();
      }

      function applyFilters() {
        var q = query.trim().toLowerCase();
        var visible = 0;
        cards.forEach(function (c) {
          var kindMatch = activeKind === 'all' || c.dataset.kind === activeKind;
          var groupMatch = !activeGroup || c.dataset.group === activeGroup;
          var text = (c.textContent || '').toLowerCase();
          var textMatch = !q || text.indexOf(q) !== -1;
          var modMatch = !modifiedOnly || groupIsChanged(c.dataset.group);
          var show = kindMatch && groupMatch && textMatch && modMatch;
          c.hidden = !show;
          if (show) visible++;
        });
        empty.hidden = visible > 0;
        countEl.textContent = visible + ' ' + (visible === 1 ? 'variant' : 'variants');

        var anyFilter = activeKind !== 'all' || activeGroup !== null || q !== '' || modifiedOnly;
        clearFiltersBtn.hidden = !anyFilter;
        searchClearBtn.hidden = q === '';
      }

      function clearAllFilters() {
        activeKind = 'all';
        activeGroup = null;
        modifiedOnly = false;
        query = '';
        search.value = '';
        modifiedOnlyInput.checked = false;
        pills.forEach(function (x) {
          x.setAttribute('aria-pressed', x.dataset.filter === 'all' ? 'true' : 'false');
        });
        renderSubfilters();
        applyFilters();
      }

      function paint() {
        var dirty = [];
        Object.keys(GROUPS).forEach(function (group) {
          var live = currentFor(group);
          var groupCards = cards.filter(function (c) { return c.dataset.group === group; });
          groupCards.forEach(function (c) {
            var v = c.dataset.variant;
            c.classList.toggle('is-current', v === live);
            c.setAttribute('aria-checked', v === pending[group] ? 'true' : 'false');
          });
          if (pending[group] !== live) {
            dirty.push(GROUPS[group].label + ': ' + live + ' \u2192 ' + pending[group]);
          }
        });
        applyBtn.disabled = dirty.length === 0;
        if (dirty.length) {
          status.textContent = 'Pending \u2014 ' + dirty.join('  \u00b7  ');
          status.classList.remove('is-ok');
        } else {
          var applied = Object.keys(GROUPS).map(function (g) {
            return GROUPS[g].label + ': ' + currentFor(g);
          });
          status.textContent = 'Applied \u2014 ' + applied.join('  \u00b7  ');
          status.classList.add('is-ok');
        }
      }

      // Default: collapsed. Persists across reloads; applies on mobile too.
      var COLLAPSED_KEY = 'aed:opt-toolbar-collapsed';
      function readCollapsed() {
        try {
          var v = localStorage.getItem(COLLAPSED_KEY);
          if (v === '0') return false;
          if (v === '1') return true;
        } catch (_) {}
        return true;
      }
      function setCollapsed(val) {
        toolbarEl.classList.toggle('is-collapsed', val);
        collapseBtn.setAttribute('aria-expanded', val ? 'false' : 'true');
        collapseBtn.setAttribute('title', val ? 'Expand toolbar' : 'Collapse toolbar');
        try { localStorage.setItem(COLLAPSED_KEY, val ? '1' : '0'); } catch (_) {}
      }

      function wireOptions() {
        setCollapsed(readCollapsed());
        collapseBtn.addEventListener('click', function () {
          setCollapsed(!toolbarEl.classList.contains('is-collapsed'));
        });

        cards.forEach(function (c) {
          var group = c.dataset.group;
          c.addEventListener('click', function () {
            pending[group] = c.dataset.variant;
            paint();
            renderSubfilters();
          });
        });

        pills.forEach(function (p) {
          p.addEventListener('click', function () { setKind(p.dataset.filter); });
        });

        search.addEventListener('input', function () {
          query = search.value || '';
          applyFilters();
        });
        search.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && search.value) {
            search.value = '';
            query = '';
            applyFilters();
          }
        });
        searchClearBtn.addEventListener('click', function () {
          search.value = '';
          query = '';
          search.focus();
          applyFilters();
        });

        modifiedOnlyInput.addEventListener('change', function () {
          modifiedOnly = modifiedOnlyInput.checked;
          applyFilters();
        });

        clearFiltersBtn.addEventListener('click', clearAllFilters);

        // Keyboard: "/" focuses search from anywhere outside a field
        document.addEventListener('keydown', function (e) {
          if (e.key !== '/') return;
          if (e.ctrlKey || e.metaKey || e.altKey) return;
          var t = e.target;
          if (t && /^(input|textarea|select)$/i.test(t.tagName)) return;
          if (t && t.isContentEditable) return;
          e.preventDefault();
          search.focus();
          search.select();
        });

        applyBtn.addEventListener('click', function () {
          Object.keys(GROUPS).forEach(function (group) {
            try {
              if (pending[group] === 'A') localStorage.removeItem(GROUPS[group].key);
              else localStorage.setItem(GROUPS[group].key, pending[group]);
            } catch (_) {}
          });
          location.reload();
        });
        reloadBtn.addEventListener('click', function () {
          location.reload();
        });
        defaultBtn.addEventListener('click', function () {
          Object.keys(GROUPS).forEach(function (group) {
            try { localStorage.removeItem(GROUPS[group].key); } catch (_) {}
            pending[group] = 'A';
          });
          location.reload();
        });

        // --- Dice: random variant for every group, save, reload ----------
        function randomVariantFor(group) {
          var choices = ['A'];
          var m = GROUPS[group].valid.source.match(/\[([A-Z])-([A-Z])\]/);
          if (m) {
            for (var i = m[1].charCodeAt(0); i <= m[2].charCodeAt(0); i++) {
              choices.push(String.fromCharCode(i));
            }
          }
          return choices[Math.floor(Math.random() * choices.length)];
        }
        diceBtn.addEventListener('click', function () {
          diceBtn.classList.add('is-rolling');
          setTimeout(function () {
            Object.keys(GROUPS).forEach(function (group) {
              var v = randomVariantFor(group);
              try {
                if (v === 'A') localStorage.removeItem(GROUPS[group].key);
                else localStorage.setItem(GROUPS[group].key, v);
              } catch (_) {}
            });
            location.reload();
          }, 450);
        });

        paint();
        renderSubfilters();
        applyFilters();
      }
    })();
  </script>
</Base>
