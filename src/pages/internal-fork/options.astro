    #opt-root .opt-wpv-c-tile .opt-wpv-line { height: 2px; width: 85%; opacity: 0.45; }

    /* D · Zigzag */
    #opt-root .opt-wpv-d {
      display: flex; flex-direction: column; gap: 5px;
      padding: 8px 10px;
      justify-content: center;
    }
