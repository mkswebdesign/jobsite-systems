      background: color-mix(in srgb, var(--accent) 12%, transparent);
      border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
      padding: 2px 4px;
      border-radius: 999px;
    }
    #opt-root .opt-wpv-g-h {
      grid-column: 1 / -1; grid-row: 2;
      height: 3px; width: 70%;
      background: var(--text-primary); opacity: 0.9;
      border-radius: 2px;
