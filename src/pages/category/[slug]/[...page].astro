---
import type { GetStaticPaths } from 'astro';
import Base from '../../../builder/layouts/Base.astro';
import CategoryHeader from '../../../builder/components/CategoryHeader.astro';
import ArchiveList from '../../../builder/components/ArchiveList.astro';
import ArchiveToolbar from '../../../builder/components/ArchiveToolbar.astro';
import ArchiveDrawer from '../../../builder/components/ArchiveDrawer.astro';
import RssLink from '../../../builder/components/RssLink.astro';
import { brand } from '../../../builder/lib/brand';
import { getAllAuthors, getAllCategories, getAllPosts, getAllTags } from '../../../builder/lib/posts';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const cats = await getAllCategories();
  if (cats.length === 0) return [];
  const allPosts = await getAllPosts();
  const out: any[] = [];
  for (const c of cats) {
    const id = c.data.id;
    const slug = c.data.slug;
    const matching = allPosts.filter((p) => p.data.category === id);
    /* Always emit at least one (empty) page per category so /category/<slug>/
     * resolves to an empty-state landing instead of a build-time 404. */
    if (matching.length === 0) {
      out.push({ params: { slug, page: undefined }, props: { category: c, posts: [], page: { data: [], currentPage: 1, lastPage: 1 } } });
      continue;
    }
    out.push(...paginate(matching, { pageSize: 12, params: { slug } }).map((entry) => ({
      ...entry,
      props: { ...entry.props, category: c },
    })));
  }
  return out;
};

const { page, category } = Astro.props as any;
const c = category.data;
const totalPages = page.lastPage ?? 1;
const currentPage = page.currentPage ?? 1;
const title = currentPage === 1
  ? `${c.name} — ${brand.name}`
  : `${c.name} (page ${currentPage}) — ${brand.name}`;
const description = c.description;

const categories = await getAllCategories();
const allPosts = await getAllPosts();
const authors = await getAllAuthors();

/* Scope tags to those that appear on posts within this category — avoids
 * tag chips that return zero results when clicked from inside the category. */
const inCategory = allPosts.filter((p) => p.data.category === c.id);
const counts = new Map<string, number>();
for (const p of inCategory) for (const t of p.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const scopedTags = [...counts.entries()]
  .map(([tag, count]) => ({ tag, count }))
  .sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag));

/* Per-category counts across the FULL corpus drive the segmented control's
 * counter labels — they stay stable across category/tag scope changes so a
 * user always sees how many articles each category holds. */
const categoryCounts: Record<string, number> = {};
for (const p of allPosts) {
  const id = p.data.category;
  categoryCounts[id] = (categoryCounts[id] ?? 0) + 1;
}

const rssHref = `/category/${c.slug}/rss.xml`;
---
<Base title={title} description={description} skipTarget="#main">
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title={`${c.name} — ${brand.name}`} href={rssHref} />
  </Fragment>
  <main id="main" class="container category-detail-page" data-scope-category={c.id}>
    <CategoryHeader category={category} postCount={inCategory.length} />
    <RssLink href={rssHref} label={`Subscribe to ${c.name} RSS`} />
    <ArchiveToolbar
      categories={categories}
      categoryCounts={categoryCounts}
      totalCount={allPosts.length}
      resultCount={inCategory.length}
      currentCategory={c.id}
    />
    <ArchiveList
      posts={page.data}
      page={currentPage}
      totalPages={totalPages}
      baseUrl={`/category/${c.slug}`}
    />
    <ArchiveDrawer tags={scopedTags} authors={authors} />
  </main>
</Base>
