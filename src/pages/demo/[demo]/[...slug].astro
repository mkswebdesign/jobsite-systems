  /* Trust marquee — pulls the brand's hero `trustMetrics` from the homepage
     so the modal carries the same scrolling banner the front door does.
     Renders via the shared `.hero-trust-marquee` / `.hero-trust--marquee`
     classes the brand stylesheet already styles (animation, mask gradient,
     reduced-motion handling); these modal-scoped overrides reset the
     hero-tuned spacing for the tighter modal-panel context and keep the
     track inside the panel's max-width on every viewport. */
  .demo-spd-modal__marquee.hero-trust-marquee {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin: 0 0 1.4rem;
    padding: 0.55rem 0;
    border-block: 1px solid color-mix(in srgb, var(--text-primary) 12%, transparent);

    /* Modal-scoped: drive the marquee with JS-controlled translateX on
       the inner ul instead of native scrollLeft. Earlier scroll-based
       impls stalled on hi-refresh displays — scrollLeft is rounded to
       integers and a 60 px/s feed at 144Hz produces a per-frame delta
       of ~0.42 px that the browser rounds away to zero. Transform
       handles sub-pixel motion natively and stays smooth at any rate.
       Hide overflow (rather than scroll) so the JS owns position, and
       keep cursor + user-select hints because pointer drag-to-scrub is
       wired up in the inline script. `touch-action: pan-y` preserves
       vertical page scroll on touch even when a finger lands here. */
    overflow: hidden;
    overscroll-behavior-x: contain;
    cursor: ew-resize;
    user-select: none;
    -webkit-user-select: none;
    touch-action: pan-y;
  }

  .demo-spd-modal__marquee .hero-trust.hero-trust--marquee {
    /* Cancel the brand stylesheet's CSS keyframe animation; JS translateX
       drives motion in this context. Composing both would scroll at ~2×
       the intended speed and the seam wraparound would drift over time.
       The brand rule sets `width: max-content` on this ul so the duplicated
