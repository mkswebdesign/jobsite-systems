---
/**
 * Demo catch-all route — every page under a demo's tree gets rendered here.
 *
 * URL pattern:   /demo/<demo>/                 (home)
 *                /demo/<demo>/<slug>/          (any other page)
 *                /demo/<demo>/<slug>/<sub>/    (nested — e.g. services/starter-site)
 *
 * Source tree:   arich-source/content/brands/<brand>/demos/<demo>/pages/...
 *                (loaded into the `demoPages` content collection by
 *                 demo-folder-loader.ts; entry ids are `<demo>/<slug>`)
 *
 * Two render modes:
 *   1. SECTIONS-FORMAT (page.json has a `sections` array) — full fidelity
 *      with the production homepage. Dispatches each section to its
 *      component, identical switch to src/pages/index.astro.
 *   2. NAMED-KEY FORMAT (page.json uses `header`, `intro`, `philosophy`,
 *      etc) — renders a header-only fallback so the URL exists and the
 *      demo's structure is navigable. To get rich rendering of a named-
 *      key demo page, EITHER add `sections` to the demo's page.json (the
 *      portable format) OR create a per-page demo route alongside this
 *      catch-all (mirror the production page's .astro file under
 *      src/pages/demo/[demo]/<slug>.astro and load via getEntry('demoPages',
 *      `${Astro.params.demo}/<slug>`)).
 *
 * Hidden from search via `indexable={false}` (noindex meta + robots disallow
 * + sitemap exclusion) — demos are internal staging surfaces, not public
 * brand content.
 */
import { getCollection, getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { brand } from '../../../builder/lib/brand';
import Base from '../../../builder/layouts/Base.astro';
import Hero from '../../../builder/components/sections/Hero.astro';
import ServicesGrid from '../../../builder/components/sections/ServicesGrid.astro';
import WorkGrid from '../../../builder/components/sections/WorkGrid.astro';
import Why from '../../../builder/components/sections/Why.astro';
import Capabilities from '../../../builder/components/sections/Capabilities.astro';
import Testimonials from '../../../builder/components/sections/Testimonials.astro';
import ProcessSteps from '../../../builder/components/sections/ProcessSteps.astro';
import Partnership from '../../../builder/components/sections/Partnership.astro';
import FAQ from '../../../builder/components/sections/FAQ.astro';
import FinalCta from '../../../builder/components/sections/FinalCta.astro';
import HistoryTeaser from '../../../builder/components/sections/HistoryTeaser.astro';
import DesignBreak from '../../../builder/components/sections/DesignBreak.astro';
import AboutSplit from '../../../builder/components/sections/AboutSplit.astro';
import ContentSection from '../../../builder/components/sections/ContentSection.astro';
import StatRibbon from '../../../builder/components/sections/StatRibbon.astro';
import PhotoGallery from '../../../builder/components/sections/PhotoGallery.astro';
import PhotoSlider from '../../../builder/components/sections/PhotoSlider.astro';
import VersusBlock from '../../../builder/components/sections/VersusBlock.astro';
import Divider from '../../../builder/components/sections/Divider.astro';
import { demoDisplayName } from '../../../lib/demo-names';

export async function getStaticPaths() {
  const all = await getCollection('demoPages');
  return all.map((entry) => {
    const [demo, ...slugParts] = entry.id.split('/');
    const slug = slugParts.join('/');
    // Astro maps `slug: undefined` → /demo/<demo>/ (the index path).
    // Anything else becomes /demo/<demo>/<slug>/.
    return {
      params: { demo, slug: slug === 'home' ? undefined : slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const data: any = entry.data;
const seo = data.seo || {};
const sections = Array.isArray(data.sections) ? data.sections : null;
const pageVariants = (data.variants && typeof data.variants === 'object') ? data.variants : undefined;
const demo = Astro.params.demo;
const slug = Astro.params.slug || 'home';

/* Eager-load testimonials so the per-section resolver below doesn't await
 * inside the JSX map. Demo testimonials are namespaced as `demos/<demo>/<id>`
 * by testimonials-loader.ts; the resolver translates back to natural ids
 * for demo authors and supplies a featured-fallback when none specified. */
const allTestimonials = await getCollection('testimonials');

function resolveDemoTestimonials(
  section: any,
  demoId: string | undefined,
  all: CollectionEntry<'testimonials'>[],
) {
  if (!demoId) return section;
  if (Array.isArray(section.items) && section.items.length) return section;

  const prefix = `demos/${demoId}/`;
  const inDemo = all.filter(t => t.id.startsWith(prefix));

  if (Array.isArray(section.testimonialIds) && section.testimonialIds.length) {
    return { ...section, testimonialIds: section.testimonialIds.map((id: string) => `${prefix}${id}`) };
  }
  /* Fallback: featured testimonials WITHIN this demo's namespace. The
   * Testimonials component's default-featured filter excludes demo-prefixed
   * entries to keep main-brand pages clean, so the route has to compute
   * the demo-scoped featured list itself and pass it as `items`. */
  const items = inDemo.filter(t => t.data.featured).map(t => t.data);
  return { ...section, items };
}

const demoName = demoDisplayName(demo);

// Single-pager demos: every in-content CTA on every page of a flagged
// demo opens a modal explaining this is a sample and pointing the visitor
// to the AGENCY's pricing (root /pricing/) — not the demo's fictional
// pricing page. The modal's job is "the form on this page is a prop,
// here's how to actually hire us"; agency pricing is the real answer
// to that question. Keyed by demo id so the modal applies on home AND
// every sub-page (services, pricing, about, etc.) — visitors who land
// on a sub-page need the same framing as visitors on the home.
const SINGLE_PAGER_DEMOS: Record<string, string> = {
  flinthills: '/pricing/',
  'kc-snowplowing': '/pricing/',
  'stillwater-therapy': '/pricing/',
  'anchor-counseling': '/pricing/',
  'summit-direct-care': '/pricing/',
  'meridian-surgical-group': '/pricing/',
  'cedar-mill-plumbing': '/pricing/',
  'apex-home-services': '/pricing/',
};
const singlePagerTarget = SINGLE_PAGER_DEMOS[demo] || null;

// Niche descriptor used in demo footer + modal copy
// ("This is a demo site … built to show what's possible for a {niche}.").
// Brands set `niche` in their brand.json; fall back to a generic "business"
// so a missing field doesn't read awkwardly.
const niche = (brand as any).niche || 'business';
const nichePossessive = (brand as any).nichePossessive || `your ${niche}`;

// Pull the live promo from /pricing/ so the demo modal can surface a real,
// time-bound offer ("Photo gallery free, ends in N days") instead of stale
// hard-coded copy. Reads page.json `promo.endsAt` + `featureMatch`; if no
// promo is configured or the deadline has passed, the chip silently hides.
let modalPromo: { label: string; daysRemaining: number } | null = null;
if (singlePagerTarget) {
  try {
    const pricingEntry = await getEntry('pages', 'pricing');
    const p: any = pricingEntry?.data?.promo;
    if (p?.endsAt && p?.featureMatch) {
      const days = Math.ceil((new Date(p.endsAt).getTime() - Date.now()) / 86400000);
      if (days > 0) {
        const featureName = String(p.featureMatch).replace(/^./, (c: string) => c.toUpperCase());
        modalPromo = {
          label: `${featureName} free on every plan — ends in ${days} day${days === 1 ? '' : 's'}`,
          daysRemaining: days,
        };
      }
    }
  } catch {
    // Brand has no pricing page (or schema mismatch) — drop the chip silently.
  }
}
// Pull the brand's homepage scrolling banner (hero `trustMetrics`) so the
// modal can carry the same trust strip the front door uses, instead of a
// shipped-project count we don't want to advertise. Brands without a home
// hero or without `trustMetrics` simply skip the marquee — no fallback.
let modalMarqueeMetrics: { value: string; label: string }[] | null = null;
if (singlePagerTarget) {
  try {
    const homeEntry = await getEntry('pages', 'home');
    const heroSection = (homeEntry?.data as any)?.sections?.find?.(
      (s: any) => s?.type === 'hero',
    );
    const metrics = Array.isArray(heroSection?.trustMetrics) ? heroSection.trustMetrics : null;
    if (metrics && metrics.length > 0) modalMarqueeMetrics = metrics;
  } catch {
    // Brand has no home page or schema mismatch — drop the marquee silently.
  }
}
---

<Base
  title={seo.title}
  description={seo.description}
  indexable={false}
  skipTarget="#main"
  hideHeader={true}
  hideFooter={true}
  variants={pageVariants}
>
  <!-- Demo nav — floating top pill that replaces the site header on demo pages.
       Two zones:
         LEFT  — informational badge: a SAMPLE chip + the demo's display name.
                 Clicking it lands on the demo home (lets visitors who landed
                 on a sub-page get back to the demo's start).
         RIGHT — actionable nav: "All demos" sends visitors to the /demo/
                 archive (the lobby that lists every sample); "Pricing" exits
                 the demo entirely and lands on the agency's pricing page.
                 The strategy: in-content CTAs continue to open the single-
                 pager modal that talks about THIS sample; the floating nav
                 is the "out of this demo" path — either to another demo via
                 the archive, or out to real agency content via Pricing. The
                 "↩ Exit" eyebrow telegraphs that these links leave the demo.
                 data-spd-allow opts every link out of the single-pager modal
                 interception so the meta-nav always navigates cleanly. -->
  <nav class="demo-nav" role="navigation" aria-label="Demo navigation">
    <a
      class="demo-nav__badge"
      href={`/demo/${demo}/`}
      aria-label={`${demoName} — demo, back to demo home`}
    >
      <span class="demo-nav__name">{demoName}</span>
    </a>
    <div class="demo-nav__divider" aria-hidden="true"></div>
    <div class="demo-nav__actions">
      <a class="demo-nav__link" href="/demo/" aria-label="See all demos">All demos</a>
      <a class="demo-nav__link demo-nav__link--cta" href="/pricing/" aria-label={`See ${brand.name} pricing`}>Pricing</a>
    </div>
  </nav>

  <main id="main">
    {sections ? (
      sections.map((section: any) => {
        switch (section.type) {
          case 'hero':           return <Hero {...section} />;
          case 'services':       return <ServicesGrid {...section} />;
          case 'work':           return <WorkGrid {...section} />;
          case 'why':            return <Why {...section} />;
          case 'capabilities':   return <Capabilities {...section} />;
          case 'testimonials':   return <Testimonials {...resolveDemoTestimonials(section, demo, allTestimonials)} />;
          case 'process':        return <ProcessSteps {...section} />;
          case 'partnership':    return <Partnership {...section} />;
          case 'faq':            return <FAQ {...section} />;
          case 'historyTeaser':  return <HistoryTeaser {...section} />;
          case 'designBreak':    return <DesignBreak {...section} />;
          case 'aboutSplit':     return <AboutSplit {...section} />;
          case 'contentSection': return <ContentSection {...section} />;
          case 'statRibbon':     return <StatRibbon {...section} />;
          case 'photoGallery':   return <PhotoGallery {...section} />;
          case 'photoSlider':    return <PhotoSlider {...section} />;
          case 'versusBlock':    return <VersusBlock {...section} />;
          case 'finalCta':       return <FinalCta {...section} />;
          case 'divider':        return <Divider color={section.color} />;
          default:               return null;
        }
      })
    ) : (
      <section class="container demo-fallback">
        <p class="demo-fallback__eyebrow">Named-key page</p>
        <h1>{data.header?.heading || seo.title || 'Demo page'}</h1>
        {data.header?.lead && <p class="demo-fallback__lead">{data.header.lead}</p>}
        <div class="demo-fallback__note">
          <p>This demo page uses the legacy named-key layout (it has fields like <code>header</code>, <code>intro</code>, <code>philosophy</code>, etc., but no <code>sections</code> array).</p>
          <p>To render it richly in the demo, either:</p>
          <ul>
            <li>Promote it to <code>sections</code> format by composing the same content out of section components in <code>{`demos/${demo}/pages/${slug}/page.json`}</code>, OR</li>
            <li>Create a per-page demo route at <code>{`src/pages/demo/[demo]/${slug}.astro`}</code> that mirrors the production <code>{`src/pages/${slug}.astro`}</code> file (swap <code>getEntry('pages', '${slug}')</code> for <code>getEntry('demoPages', `${'${'}Astro.params.demo${'}'}/${slug}`)</code>).</li>
          </ul>
        </div>
      </section>
    )}
  </main>

  <!-- Demo footer — replaces the agency footer on demo pages. Mirrors the
       floating nav's badge so visitors land at the bottom of the demo and
       see the same "this is a sample" framing — but here it converts:
       the CTAs ask the visitor to do something (see pricing / browse other
       samples). On the home page, the single-pager modal still intercepts
       these clicks the first time (the modal's "See pricing" primary still
       wins), but the footer also stands on its own as a destination. -->
  <footer class="demo-footer" aria-labelledby="demo-footer-title">
    <div class="demo-footer__inner">
      <div class="demo-footer__badge">
        <span class="demo-footer__name">{demoName}</span>
      </div>
      <h2 id="demo-footer-title" class="demo-footer__heading">Like what you see?</h2>
      <p class="demo-footer__lead">
        This is a demo site {brand.name} built to show what's possible for a {niche}.
        The forms above are demo props — but if you want a real site like it for
        your business, here's what it costs to build and ship.
      </p>
      <div class="demo-footer__actions">
        <a class="demo-footer__cta demo-footer__cta--primary" href="/pricing/">
          See pricing
          <span class="demo-footer__cta-arrow" aria-hidden="true">→</span>
        </a>
        <a class="demo-footer__cta demo-footer__cta--secondary" href="/demo/">
          Browse all demos
        </a>
      </div>
      <p class="demo-footer__attr">
        <span class="demo-footer__attr-label">Demo by</span>
        <a href="/" class="demo-footer__attr-link">{brand.name}</a>
      </p>
    </div>
  </footer>

  {singlePagerTarget && (
    <div class="demo-spd-modal" data-target={singlePagerTarget} data-demo={demo} hidden>
      <div class="demo-spd-modal__backdrop" data-spd-close></div>
      <div class="demo-spd-modal__panel" role="dialog" aria-modal="true" aria-labelledby="demo-spd-title">
        <div class="demo-spd-modal__stripe" aria-hidden="true"></div>
        <button type="button" class="demo-spd-modal__close" aria-label="Close" data-spd-close>×</button>

        <p class="demo-spd-modal__eyebrow">
          <span class="demo-spd-modal__eyebrow-dot" aria-hidden="true"></span>
          Demo site
        </p>

        <h2 id="demo-spd-title" class="demo-spd-modal__heading">
          This isn't a real business — <span class="demo-spd-modal__heading-accent">yours could be.</span>
        </h2>

        <p class="demo-spd-modal__body">
          Forms here go nowhere. The same site, branded for {nichePossessive}, is what {brand.name || 'we'} build, host, and maintain — month-to-month.
        </p>

        {modalPromo && (
          <div class="demo-spd-modal__promo" role="note" aria-label="Limited-time offer">
            <span class="demo-spd-modal__promo-chip">Limited time</span>
            <span class="demo-spd-modal__promo-text">{modalPromo.label}</span>
          </div>
        )}

        {modalMarqueeMetrics && (
          <div class="demo-spd-modal__marquee hero-trust-marquee" aria-label="At a glance" role="region">
            <ul class="hero-trust hero-trust--marquee" data-trust-marquee>
              {modalMarqueeMetrics.map((m) => (
                <li>
                  <span class="hero-trust-value">{m.value}</span>
                  <span class="hero-trust-label">{m.label}</span>
                </li>
              ))}
              {modalMarqueeMetrics.map((m) => (
                <li aria-hidden="true">
                  <span class="hero-trust-value">{m.value}</span>
                  <span class="hero-trust-label">{m.label}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="demo-spd-modal__actions">
          <a href={singlePagerTarget} class="demo-spd-modal__primary">
            <span>See plans &amp; pricing</span>
            <span class="demo-spd-modal__primary-arrow" aria-hidden="true">→</span>
          </a>
          <button type="button" class="demo-spd-modal__secondary" data-spd-close>Keep browsing demo</button>
        </div>
      </div>
    </div>
  )}
</Base>

{singlePagerTarget && (
  <script is:inline>
    (function () {
      const main = document.getElementById('main');
      const modal = document.querySelector('.demo-spd-modal');
      if (!main || !modal) return;
      const target = modal.getAttribute('data-target') || '/';
      const demoId = modal.getAttribute('data-demo') || 'unknown';
      // Once-per-session dismissal: ONLY the explicit "Keep browsing demo"
      // button (data-spd-close on the secondary action) sets this flag.
      // ESC / backdrop / X / primary-CTA navigations are ambiguous —
      // could be accidental, could be the visitor heading off-demo — and
      // should NOT permanently silence the modal. The previous broader
      // policy meant a single test-close (or anyone hitting ESC by reflex)
      // killed the modal for the rest of the session, making the feature
      // look broken on the second click. Scoped per-demo so different
      // samples re-prompt independently.
      const SS_KEY = 'aed:demo-spd:' + demoId + ':dismissed';
      function isDismissed() {
        try { return sessionStorage.getItem(SS_KEY) === '1'; } catch (_) { return false; }
      }
      function markDismissed() {
        try { sessionStorage.setItem(SS_KEY, '1'); } catch (_) {}
      }
      let lastFocused = null;

      function open() {
        lastFocused = document.activeElement;
        modal.hidden = false;
        document.body.style.overflow = 'hidden';
        const primary = modal.querySelector('.demo-spd-modal__primary');
        if (primary) primary.focus();
        startMarquee();
      }
      function close(opts) {
        modal.hidden = true;
        document.body.style.overflow = '';
        if (opts && opts.dismiss) markDismissed();
        if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
        stopMarquee();
      }

      // ----- Marquee auto-scroller -----
      // Drives a JS-controlled translateX on the inner ul. Earlier
      // versions used native scrollLeft on the outer container, which
      // STALLED on hi-refresh displays: at 60 px/s ÷ 144 Hz = ~0.42 px
      // per frame, the browser rounds the per-frame delta away to zero
      // and the strip appears frozen. Transform handles sub-pixel motion
      // natively and stays smooth at any refresh rate.
      //
      // The track is rendered with content duplicated (see Hero pattern):
      // we translate from 0 → -halfTrack and snap back to 0, where
      // halfTrack = first-copy width = track.scrollWidth / 2. The seam
      // is invisible at any viewport width.
      //
      // Interaction model:
      //   - hover (mouseenter)    → pause while pointer is over the strip
      //   - wheel (incl. trackpad)→ scrub by deltaX/deltaY; pause briefly
      //   - pointerdown + drag    → real drag-to-scrub (the cursor:ew-resize
      //                             promise becomes real); pause briefly
      //                             after release
      //   - touch swipe           → same as drag via pointer events
      const marquee = modal.querySelector('.demo-spd-modal__marquee');
      const track = marquee && marquee.querySelector('.hero-trust--marquee');
      const SPEED_PX_PER_SEC = 60;
      const PAUSE_AFTER_INTERACT_MS = 2500;
      let raf = 0;
      let lastTs = 0;
      let pauseUntil = 0;
      let hovering = false;
      let dragging = false;
      let dragStartX = 0;
      let dragStartOffset = 0;
      let offset = 0;          // current track translation (px, positive = scrolled right)
      let halfTrack = 0;       // single-copy width = scrollWidth / 2

      function measureTrack() {
        if (!track) return;
        halfTrack = track.scrollWidth / 2;
      }
      function applyTransform() {
        if (!track) return;
        track.style.transform = 'translate3d(' + (-offset) + 'px, 0, 0)';
      }
      function wrapOffset() {
        if (halfTrack <= 0) return;
        // Modulo to handle large jumps (drag/wheel can produce > halfTrack
        // deltas; a single subtraction would leave offset out of range).
        while (offset < 0) offset += halfTrack;
        while (offset >= halfTrack) offset -= halfTrack;
      }

      function tickMarquee(now) {
        if (!track || modal.hidden) {
          raf = 0;
          return;
        }
        if (halfTrack <= 0) measureTrack();
        if (lastTs > 0 && !hovering && !dragging && now > pauseUntil) {
          const dt = Math.min(now - lastTs, 100);
          offset += (SPEED_PX_PER_SEC * dt) / 1000;
          wrapOffset();
          applyTransform();
        }
        lastTs = now;
        raf = requestAnimationFrame(tickMarquee);
      }
      function startMarquee() {
        if (!track || raf) return;
        measureTrack();
        // If the modal was opened mid-session and never measured before,
        // start with offset = 0 the first time, then resume from wherever
        // we left off on subsequent opens (visitors who close + reopen
        // shouldn't see the strip jump back to the start).
        lastTs = 0;
        pauseUntil = 0;
        applyTransform();
        raf = requestAnimationFrame(tickMarquee);
      }
      function stopMarquee() {
        if (raf) {
          cancelAnimationFrame(raf);
          raf = 0;
        }
      }
      if (marquee && track) {
        const bumpPause = function () { pauseUntil = performance.now() + PAUSE_AFTER_INTERACT_MS; };

        // Wheel: scrub by horizontal delta when present (trackpad / shift+wheel),
        // otherwise treat vertical delta as horizontal scrub. The page is locked
        // (body overflow:hidden) while the modal is open, so vertical wheel has
        // nothing else to do — repurposing it for the marquee is the right call.
        marquee.addEventListener('wheel', function (e) {
          bumpPause();
          const delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
          offset += delta;
          wrapOffset();
          applyTransform();
        }, { passive: true });

        // Drag-to-scrub via pointer events (unifies mouse / pen / touch).
        marquee.addEventListener('pointerdown', function (e) {
          dragging = true;
          dragStartX = e.clientX;
          dragStartOffset = offset;
          bumpPause();
          try { marquee.setPointerCapture(e.pointerId); } catch (_) {}
        });
        marquee.addEventListener('pointermove', function (e) {
          if (!dragging) return;
          offset = dragStartOffset - (e.clientX - dragStartX);
          wrapOffset();
          applyTransform();
        });
        function endDrag(e) {
          if (!dragging) return;
          dragging = false;
          pauseUntil = performance.now() + PAUSE_AFTER_INTERACT_MS;
          if (e && e.pointerId != null) {
            try { marquee.releasePointerCapture(e.pointerId); } catch (_) {}
          }
        }
        marquee.addEventListener('pointerup', endDrag);
        marquee.addEventListener('pointercancel', endDrag);

        marquee.addEventListener('mouseenter', function () { hovering = true; });
        marquee.addEventListener('mouseleave', function () {
          hovering = false;
          pauseUntil = performance.now() + 250;
        });

        // Re-measure on viewport changes (the duplicated track width can
        // shift when chips reflow). Cheap to call; we throttle naturally
        // since resize fires far below the rAF rate.
        window.addEventListener('resize', measureTrack);
      }

      // Classify a link's href as IN-DEMO (sample / fictional content —
      // modal fires so the visitor knows the form they're about to engage
      // with isn't real) vs EXIT (the agency's real content — navigate
      // cleanly so the modal doesn't get in the way of the visitor leaving
      // the sample). Rule: anything inside this demo's path tree
      // (/demo/<demoId>/...) plus same-page hash/query anchors are in-demo;
      // everything else (agency root /, /pricing/, the demos index /demo/,
      // /work/, /about/, mailto:, tel:, http(s)://...) is an exit. The
      // previous "intercept everything" policy meant the demo nav's
      // "Pricing" link popped a modal whose primary CTA also pointed to
      // /pricing/ — redundant friction. Path-based classify removes that
      // without per-link attrs.
      const demoHomePath = '/demo/' + demoId + '/';
      function isDemoInternal(href) {
        if (!href) return false;
        if (href.charAt(0) === '#') return true;       // same-page hash jumps
        if (href.charAt(0) === '?') return true;       // same-page query-only
        if (href === demoHomePath) return true;
        if (href === demoHomePath.slice(0, -1)) return true;  // /demo/<id>
        if (href.startsWith(demoHomePath)) return true;
        return false;
      }

      // Explicit "open this modal" hook — `href="#demo-spd-modal"` (or any
      // element with [data-spd-open]) ALWAYS pops the demo modal, even after
      // the session has been dismissed. Used for in-demo CTAs whose entire
      // job is to surface the demo framing (e.g. a Walk-Through "How it
      // works" button on a sample brand site, where the answer to "how
      // does this work?" IS the modal's content). Runs before the dismissal
      // bailout on purpose — these triggers don't respect the session opt-out.
      document.addEventListener('click', function (e) {
        const t = e.target && e.target.closest && e.target.closest('a[href="#demo-spd-modal"], [data-spd-open]');
        if (!t) return;
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        e.preventDefault();
        e.stopPropagation();
        open();
      }, true);

      // Capture phase so we run before any other click handler — the
      // anchor-headings / scrollspy addons attach their own listeners
      // and would otherwise smooth-scroll a hash link before this fires.
      document.addEventListener('click', function (e) {
        // Once dismissed for this session, every link navigates freely.
        // We bail out fast so this handler stays cheap on repeat clicks.
        if (isDismissed()) return;
        const a = e.target.closest && e.target.closest('a[href]');
        if (!a) return;
        // Modal's own buttons/links — let them navigate freely. This is
        // load-bearing: the modal's primary CTA needs to actually go to
        // /pricing/ when clicked. Without this bypass, the modal would
        // intercept itself and we'd ping-pong forever. We do NOT mark
        // dismissed on the primary CTA — if the visitor back-buttons
        // into the demo, the modal firing again is appropriate (they
        // saw the message but never explicitly opted out).
        if (modal.contains(a)) return;
        // Modifier-clicks / non-primary buttons: leave them alone so
        // power users can still cmd-click to open in a new tab.
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        const href = a.getAttribute('href') || '';
        if (!href) return;
        // Exit links — anywhere outside the demo's path tree. Navigate
        // cleanly; the modal would only re-route to /pricing/ which is
        // often where the visitor was already heading.
        if (!isDemoInternal(href)) return;
        // Explicit per-link opt-out kept as an escape hatch for the rare
        // case where an in-demo link genuinely needs to navigate (e.g.
        // an anchor that triggers its own JS interaction).
        if (a.hasAttribute('data-spd-allow')) return;
        e.preventDefault();
        e.stopPropagation();
        open();
      }, true);

      // Only the explicit "Keep browsing demo" secondary button counts as
      // a dismissal — that's the unambiguous "I understand the framing,
      // stop showing me this" gesture. The X button, backdrop, and ESC
      // simply close the modal without setting the flag, so the next
      // in-demo link click re-prompts as expected.
      modal.addEventListener('click', function (e) {
        const t = e.target;
        if (!t || !t.closest) return;
        const closer = t.closest('[data-spd-close]');
        if (!closer) return;
        const dismiss = closer.classList.contains('demo-spd-modal__secondary');
        close({ dismiss: dismiss });
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !modal.hidden) close({ dismiss: false });
      });
    })();
  </script>
)}

