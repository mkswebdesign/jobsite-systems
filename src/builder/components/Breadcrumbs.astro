---
/**
 * Breadcrumbs — small muted nav row with › separators.
 * Props: items[] of { label, href? }. The last item is rendered as plain text
 * (the current page); earlier items are <a> when href is provided.
 * Used by all blog routes (archive, category, tag, post, search).
 */
interface Crumb { label: string; href?: string; }
interface Props { items: Crumb[]; }
const { items } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((it, i) => (
      <li>
        {it.href && i < items.length - 1
          ? <a href={it.href}>{it.label}</a>
          : <span aria-current={i === items.length - 1 ? 'page' : undefined}>{it.label}</span>}
        {i < items.length - 1 && <span class="breadcrumbs__sep" aria-hidden="true">›</span>}
      </li>
    ))}
  </ol>
</nav>
