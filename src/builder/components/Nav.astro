<script is:inline>
  /* ------------------------------------------------------------
   * Mega-menu toggle (Variant G)
   * - Desktop: hover + focus-within already open the panel via CSS.
   *   The toggle button adds click/tap support (touch laptops, tablets)
   *   and lets a user "pin" the panel open.
   * - Mobile: the CSS keeps the panel collapsed until data-expanded.
   *   The toggle button is the only way to open it in the drawer.
   * ------------------------------------------------------------ */
  (function () {
    var toggles = document.querySelectorAll('.nav-mega-toggle');
    if (!toggles.length) return;

    function setExpanded(scope, btn, expanded) {
      if (!scope || !btn) return;
      scope.setAttribute('data-expanded', expanded ? 'true' : 'false');
      btn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
    }

    function closeAll(exceptScope) {
      document.querySelectorAll('.nav-mega-scope[data-expanded="true"]').forEach(function (s) {
        if (s === exceptScope) return;
        var b = s.querySelector('.nav-mega-toggle');
        setExpanded(s, b, false);
      });
    }

    toggles.forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var scope = btn.closest('.nav-mega-scope');
        if (!scope) return;
        var isOpen = scope.getAttribute('data-expanded') === 'true';
        closeAll(scope);
        setExpanded(scope, btn, !isOpen);
      });
    });

    // Click outside any scope → close all
    document.addEventListener('click', function (e) {
      var t = e.target;
      if (t && t.closest && t.closest('.nav-mega-scope')) return;
      closeAll(null);
    });

    // Escape closes every open panel + returns focus to the first toggle that was open
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      var open = document.querySelector('.nav-mega-scope[data-expanded="true"]');
      if (!open) return;
      var btn = open.querySelector('.nav-mega-toggle');
      closeAll(null);
      if (btn) btn.focus();
    });

    // When the mobile drawer closes, collapse any expanded accordions so
    // they don't silently stay open the next time the drawer is opened.
    var navLinks = document.getElementById('navLinks');
    if (navLinks) {
      var observer = new MutationObserver(function () {
        if (!navLinks.classList.contains('open')) closeAll(null);
      });
      observer.observe(navLinks, { attributes: true, attributeFilter: ['class'] });
    }
  })();

  (function () {
    var nav = document.querySelector('nav.nav');
    if (!nav) return;
    var lastY = window.scrollY;
    var ticking = false;
    function isCapsule() { return document.documentElement.getAttribute('data-nav-variant') === 'C'; }
    function onScroll() {
      var y = window.scrollY;
      if (!isCapsule()) { nav.classList.remove('aed-nav-hidden'); lastY = y; ticking = false; return; }
      var delta = y - lastY;
      if (y < 40) {
        nav.classList.remove('aed-nav-hidden');
      } else if (delta > 6) {
        nav.classList.add('aed-nav-hidden');
      } else if (delta < -6) {
        nav.classList.remove('aed-nav-hidden');
