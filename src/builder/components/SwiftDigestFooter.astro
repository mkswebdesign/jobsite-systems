---
/**
 * SwiftDigestFooter — four-band editorial footer
 *
 * Four horizontal bands separated by 1px hairlines:
 *   1. Brand block + newsletter signup
 *   2. Four link columns (Read / Sections / Newsroom / Connect)
 *   3. Utility row — theme toggle + back to top
 *   4. Bottom bar — signature block (© + studio credit) + legal links + email pill
 *
 * Theme integration:
 *   The theme buttons (.sd-footer__theme-btn) forward clicks to the nav's
 *   #themeToggle .theme-opt buttons — the same pattern the drawer uses in
 *   SwiftDigestNav. theme.js owns persistence + toast; this footer only
 *   mirrors aria-pressed via a MutationObserver on <html data-theme>.
 *
 * Newsletter form is currently client-side stubbed (shows confirmation
 * state on submit). TODO: wire to a real subscriber endpoint.
 */
import { brand, site } from '../lib/brand';

const f: any = site.footer ?? {};
const contactEmail: string = f.contact?.email ?? brand.contact?.email ?? 'hello@swiftdigest.com';
const copyrightText: string =
  f.copyright ?? `© ${new Date().getFullYear()} ${brand.name} · Independent newsroom, reader-funded.`;
---
<footer class="sd-footer" role="contentinfo">
  <div class="sd-footer__inner">
    {/* ===== Band 1 — Brand + Newsletter ===== */}
    <div class="sd-footer__band sd-footer__band--brand">
      <div class="sd-footer__brand-block">
        <a class="sd-footer__wordmark" href="/" aria-label="Swift Digest home">
          <span>Swift<span class="accent">Digest</span></span>
        </a>
        <p class="sd-footer__tagline-line">Independent news, faster.</p>
        <p class="sd-footer__mission">
          An independent newsroom delivering daily reporting and sharp analysis — built for readers who want signal over noise.
        </p>
      </div>

      <div class="sd-footer__newsletter">
        <h2 class="sd-footer__nl-heading">The Morning Brief</h2>
        <p class="sd-footer__nl-sub">One email. Five minutes. Everything that actually matters before 8 a.m.</p>
        <form class="sd-footer__nl-form" data-sd-newsletter>
          <label class="visually-hidden" for="sd-footer-email">Email address</label>
          <input
            id="sd-footer-email"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            aria-describedby="sd-footer-nl-note"
          />
          <button type="submit">Subscribe</button>
        </form>
        <p class="sd-footer__nl-note" id="sd-footer-nl-note">
          Free forever. Unsubscribe in one click. No tracking pixels.
        </p>
      </div>
    </div>

    {/* ===== Band 2 — Four Link Columns ===== */}
    <div class="sd-footer__band sd-footer__band--cols">
      <div class="sd-footer__col">
        <h3 class="sd-footer__col-heading">Read</h3>
        <ul>
          <li><a href="/archive/">Latest</a></li>
          <li><a href="/category/">Categories</a></li>
          <li><a href="/archive/">Topics</a></li>
          <li><a href="/archive/">Archive</a></li>
          <li><a href="/search/">Search</a></li>
        </ul>
      </div>

      <div class="sd-footer__col">
        <h3 class="sd-footer__col-heading">Sections</h3>
        <ul>
          <li><a href="/category/politics/">Politics</a></li>
          <li><a href="/category/technology/">Technology</a></li>
          <li><a href="/category/business/">Business</a></li>
          <li><a href="/category/culture/">Culture</a></li>
          <li><a href="/category/world/">World</a></li>
          <li><a href="/category/science/">Science</a></li>
        </ul>
      </div>

      <div class="sd-footer__col">
        <h3 class="sd-footer__col-heading">Newsroom</h3>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/editorial-standards/">Editorial standards</a></li>
          <li><a href="/corrections/">Corrections</a></li>
          <li><a href="/faq/">FAQ</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/careers/">Careers</a></li>
        </ul>
      </div>

      <div class="sd-footer__col sd-footer__col--connect">
        <h3 class="sd-footer__col-heading">Connect</h3>
        <ul>
          <li>
            <a href="/rss.xml" class="sd-footer__social">
              <svg class="sd-footer__rss-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 11a9 9 0 0 1 9 9"/>
                <path d="M4 4a16 16 0 0 1 16 16"/>
                <circle cx="5" cy="19" r="1.5" fill="currentColor"/>
              </svg>
              RSS feed
            </a>
          </li>
          <li>
            <a href="#" class="sd-footer__social" rel="me noopener" aria-label="Swift Digest on X">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
              Twitter / X
            </a>
          </li>
          <li>
            <a href="#" class="sd-footer__social" rel="me noopener" aria-label="Swift Digest on Mastodon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M21.58 13.913c-.29 1.469-2.592 3.121-5.238 3.428-1.379.16-2.737.307-4.185.246-2.368-.103-4.236-.541-4.236-.541 0 .227.014.444.043.647.31 2.272 2.317 2.408 4.22 2.47 1.92.063 3.63-.46 3.63-.46l.08 1.671s-1.345.69-3.74.811c-1.32.067-2.96-.034-4.872-.524-4.144-1.063-4.857-5.305-4.965-9.605C2.282 11.3 2.286 9.997 2.286 8.91c0-4.402 3.066-5.694 3.066-5.694C6.898 2.55 9.555 2.246 12.318 2.227h.068c2.762.019 5.421.323 6.967 1.024 0 0 3.066 1.292 3.066 5.694 0 0 .039 3.247-.413 4.968zM18.286 9.34c0-1.094-.295-1.962-.882-2.604-.605-.642-1.397-.973-2.382-.973-1.14 0-2.003.41-2.578 1.232l-.524.844-.523-.844c-.575-.822-1.439-1.232-2.578-1.232-.984 0-1.777.331-2.382.973-.587.642-.882 1.51-.882 2.604v5.341h2.165V9.51c0-1.087.473-1.638 1.42-1.638 1.046 0 1.57.654 1.57 1.945v2.823h2.156V9.817c0-1.291.524-1.945 1.57-1.945.946 0 1.42.551 1.42 1.638v5.171h2.165z"/>
              </svg>
              Mastodon
            </a>
          </li>
          <li>
            <a href="#" class="sd-footer__social" rel="me noopener" aria-label="Swift Digest on Bluesky">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.038.415-.054-.138.022-.276.04-.415.054-3.911.58-7.386 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078-.139-.014-.277-.032-.415-.054.14.016.279.034.415.054 2.67.296 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.205-.659-.298-1.664-.621-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8z"/>
              </svg>
              Bluesky
            </a>
          </li>
          <li>
            <a href="#" class="sd-footer__social" rel="me noopener" aria-label="Swift Digest on Apple News">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.146 0C5.443 0 0 5.443 0 12.146 0 18.85 5.443 24 12.146 24c6.704 0 12.147-5.15 12.147-11.854C24.293 5.443 18.85 0 12.146 0zM7.18 6.243h6.61c2.262 0 3.967 1.78 3.967 3.93 0 1.706-1.075 3.078-2.706 3.522l2.928 4.062H15.71l-2.706-3.78h-3.485v3.78H7.18V6.243zm2.34 2.115v3.522h3.967c1.038 0 1.78-.742 1.78-1.78 0-1-.742-1.742-1.78-1.742z"/>
              </svg>
              Apple News
            </a>
          </li>
        </ul>
      </div>
    </div>

    {/* ===== Band 3 — Utility Row ===== */}
    <div class="sd-footer__band sd-footer__band--util">
      <div class="sd-footer__theme" id="sdFooterTheme" role="group" aria-label="Theme">
        <button type="button" class="sd-footer__theme-btn" data-mode="light" aria-pressed="false">Light</button>
        <button type="button" class="sd-footer__theme-btn" data-mode="dark" aria-pressed="false">Dark</button>
        <button type="button" class="sd-footer__theme-btn" data-mode="vibrant" aria-pressed="false">Vibrant</button>
      </div>
      <a href="#top" class="sd-footer__top" data-sd-back-to-top>
        Back to top <span aria-hidden="true">↑</span>
      </a>
    </div>

    {/* ===== Band 4 — Bottom Bar (signature + legal + email) ===== */}
    <div class="sd-footer__band sd-footer__band--bottom">
      <div class="sd-footer__signature">
        <p class="sd-footer__copy">
          © {new Date().getFullYear()} <span class="sd-footer__copy-strong">Swift Digest</span> · Independent newsroom, reader-funded.
        </p>
        <p class="sd-footer__credit">
          Designed &amp; built by{' '}
          <a href="https://mkswebdesign.com/#footsies" target="_blank" rel="noopener noreferrer" class="sd-footer__credit-link sd-footer__credit-link--studio">
            MKS Web Design
            <svg class="sd-footer__credit-arrow" width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3.5 8.5 8.5 3.5M4.5 3.5h4v4"/>
            </svg>
          </a>
          <span class="sd-footer__credit-sep" aria-hidden="true">·</span>
          <a href="https://gomks.com/#footsies" target="_blank" rel="noopener noreferrer" class="sd-footer__credit-link sd-footer__credit-link--platform">
            on gomks
          </a>
        </p>
      </div>
      <nav class="sd-footer__legal" aria-label="Legal">
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
        <a href="/cookies/">Cookies</a>
        <a href="/ethics/">Ethics</a>
      </nav>
      <a class="sd-footer__email-pill" href={`mailto:${contactEmail}`}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2"/>
          <path d="m3 7 9 6 9-6"/>
        </svg>
        {contactEmail}
      </a>
    </div>
  </div>
</footer>

<script>
  (function () {
    /* ----- Theme buttons forward to nav's #themeToggle, mirror state ----- */
    const group = document.getElementById('sdFooterTheme');
    if (group) {
      const btns = group.querySelectorAll<HTMLButtonElement>('.sd-footer__theme-btn');
      const sync = () => {
        const current = document.documentElement.getAttribute('data-theme') || 'vibrant';
        btns.forEach((b) => {
          b.setAttribute('aria-pressed', b.dataset.mode === current ? 'true' : 'false');
        });
      };
      btns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const mode = btn.dataset.mode;
          if (!mode) return;
          const target = document.querySelector<HTMLButtonElement>(
            '#themeToggle .theme-opt[data-mode="' + mode + '"]'
          );
          if (target) target.click();
          sync();
        });
      });
      sync();
      new MutationObserver(sync).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      });
    }

    /* ----- Back to top: smooth-scroll, respect reduced motion ----- */
    const topLink = document.querySelector<HTMLAnchorElement>('[data-sd-back-to-top]');
    if (topLink) {
      topLink.addEventListener('click', (e) => {
        e.preventDefault();
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
      });
    }

    /* ----- Newsletter stub (TODO: wire to real endpoint) ----- */
    const form = document.querySelector<HTMLFormElement>('[data-sd-newsletter]');
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const input = form.querySelector<HTMLInputElement>('input[type="email"]');
        if (!input || !input.value || !input.checkValidity()) {
          input?.focus();
          return;
        }
        form.classList.add('is-submitted');
        const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (btn) {
          btn.disabled = true;
          btn.textContent = '✓ Subscribed';
        }
        if (input) {
          input.disabled = true;
          input.value = '';
          input.placeholder = 'Check your inbox to confirm';
        }
      });
    }
  })();
</script>
