---
import { site } from '../../lib/brand';
import SectionHeading from '../SectionHeading.astro';

interface Props {
  sectionLabel: string;
  heading: string;
  subtext?: string;
  useSkillsCarousel?: boolean;
  /** `carousel` (default) renders the looping chip rows + click-to-open modal.
   *  `grouped` renders the categorized groups inline as the section's primary
   *  surface (no carousel, no modal). */
  layout?: 'carousel' | 'grouped';
}

const { sectionLabel, heading, subtext, useSkillsCarousel = true, layout = 'carousel' } = Astro.props;
const rows = useSkillsCarousel && site.skillsCarousel.enabled ? site.skillsCarousel.rows : [];
const isGrouped = layout === 'grouped';

/* Per-row modal group titles + bodies. Each brand provides these in
 * `site.json -> skillsCarousel.groupTitles` / `groupBodies` (one entry per
 * row). When a brand omits them, the modal renders only the row items —
 * better than shipping cross-brand default copy. The previous shared
 * landscape-themed defaults leaked into helping-systems' "What's Included"
 * modal until caught in audit; keeping them per-brand prevents recurrence. */
const groupTitles = site.skillsCarousel.groupTitles ?? [];
const groupBodies = site.skillsCarousel.groupBodies ?? [];

/* Resolve the secondary CTA from the brand's actual nav so a brand that
 * has swapped /pricing/ for /partnership/ doesn't ship a stale "See pricing"
 * link that bounces through a 301. Look for either href in the primary nav
 * and use the matching label; fall back to the legacy "/pricing/ → See pricing"
 * pair so brands that haven't authored either still render something. */
const secondaryNavMatch = (site.nav as any)?.primary?.find?.(
  (n: any) => n?.href === '/partnership/' || n?.href === '/pricing/',
);
const secondaryCta = secondaryNavMatch
  ? { label: secondaryNavMatch.alternateLabel ?? secondaryNavMatch.label, href: secondaryNavMatch.href }
  : { label: 'See pricing', href: '/pricing/' };
---

<section
  class="section"
  id="capabilities"
  data-section-type="capabilities"
  data-section-label="Capabilities"
  data-section-variants="A:Default,B:Minimal,C:Featured,D:Drift"
>
  <div class="container">
    <SectionHeading label={sectionLabel} heading={heading} subtext={subtext} />
    {rows.length > 0 && !isGrouped && (
      <div class="skills-carousel-wrapper reveal" data-reveal-delay="300" data-capabilities-trigger>
        {rows.map((row, i) => (
          <div
            class="skills-carousel-track"
            data-direction={row.direction}
            style={`--track-delay:-${(i * 180) / Math.max(rows.length, 1) | 0}s`}
          >
            <div class="skills-carousel-inner">
              {[...row.items, ...row.items].map((item, j) => (
                <button
                  type="button"
                  class="skill-item"
                  aria-hidden={j >= row.items.length ? 'true' : undefined}
                  tabindex={j >= row.items.length ? -1 : undefined}
                  data-capabilities-open
                  aria-haspopup="dialog"
                  aria-controls="capabilities-modal"
                >
                  <span class="skill-icon">&#10003;</span>
                  <span class="skill-name">{item}</span>
                </button>
              ))}
            </div>
          </div>
        ))}
        <p class="skills-hint" aria-hidden="true">Tap or click any chip to see everything that's included</p>
      </div>
    )}
    {rows.length > 0 && isGrouped && (
      <div class="capabilities-grouped reveal" data-reveal-delay="200">
        <div class="capabilities-grouped-grid">
          {rows.map((row, i) => (
            <div class="capabilities-group capabilities-group--inline">
              <h4>{groupTitles[i] ?? `Group ${i + 1}`}</h4>
              {groupBodies[i] && <p>{groupBodies[i]}</p>}
              <ul>
                {row.items.map(item => <li>{item}</li>)}
              </ul>
            </div>
          ))}
        </div>
        <div class="capabilities-grouped-cta">
          {(site.nav as any).cta && (
            <a href={(site.nav as any).cta.href} class="btn btn-primary">{(site.nav as any).cta.label}</a>
          )}
          <a href={secondaryCta.href} class="btn btn-secondary">{secondaryCta.label}</a>
        </div>
      </div>
    )}
  </div>

  {rows.length > 0 && !isGrouped && (
    <div class="capabilities-modal" id="capabilities-modal" role="dialog" aria-modal="true" aria-labelledby="capabilities-modal-title" hidden>
      <div class="capabilities-modal-backdrop" data-capabilities-close></div>
      <div class="capabilities-modal-panel" role="document">
        <button type="button" class="capabilities-modal-close" aria-label="Close" data-capabilities-close>
          <svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 5l10 10M15 5L5 15"/></svg>
        </button>
        <div class="capabilities-modal-header">
          <p class="capabilities-modal-eyebrow">{sectionLabel}</p>
          <h3 id="capabilities-modal-title">{heading}</h3>
          {subtext && <p class="capabilities-modal-lead">{subtext}</p>}
        </div>
        <div class="capabilities-modal-groups">
          {rows.map((row, i) => (
            <div class="capabilities-group">
              <h4>{groupTitles[i] ?? `Group ${i + 1}`}</h4>
              {groupBodies[i] && <p>{groupBodies[i]}</p>}
              <ul>
                {row.items.map(item => <li>{item}</li>)}
              </ul>
            </div>
          ))}
        </div>
        <div class="capabilities-modal-cta">
          {(site.nav as any).cta && (
            <a href={(site.nav as any).cta.href} class="btn btn-primary">{(site.nav as any).cta.label}</a>
          )}
          <a href={secondaryCta.href} class="btn btn-secondary">{secondaryCta.label}</a>
        </div>
      </div>
    </div>
  )}
</section>

<style is:global>
  /* Reset only the native button chrome; decorations.css supplies the chip look. */
  button.skill-item { appearance: none; font: inherit; color: inherit; text-align: left; cursor: pointer }
  button.skill-item:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px }
  .skills-hint { margin: 1.25rem auto 0; text-align: center; font-size: 0.8125rem; color: var(--text-muted); letter-spacing: 0.02em }

  .capabilities-modal { position: fixed; inset: 0; z-index: 10050; display: flex; align-items: center; justify-content: center; padding: 1.5rem }
  .capabilities-modal[hidden] { display: none }
  .capabilities-modal-backdrop { position: absolute; inset: 0; background: color-mix(in srgb, #000 65%, transparent); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); opacity: 0; transition: opacity 0.25s ease }
  .capabilities-modal.is-open .capabilities-modal-backdrop { opacity: 1 }
  .capabilities-modal-panel { position: relative; max-width: 820px; width: 100%; max-height: calc(100vh - 3rem); overflow-y: auto; padding: 2.25rem 2rem 2rem; background: var(--bg-card); border: 1px solid color-mix(in srgb, var(--accent) 22%, var(--border)); border-radius: var(--radius-lg, 18px); box-shadow: 0 32px 80px -24px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(var(--accent-rgb), 0.05); transform: translateY(12px) scale(0.98); opacity: 0; transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.28s ease }
  .capabilities-modal.is-open .capabilities-modal-panel { transform: translateY(0) scale(1); opacity: 1 }
  .capabilities-modal-close { position: absolute; top: 0.85rem; right: 0.85rem; width: 36px; height: 36px; display: inline-flex; align-items: center; justify-content: center; background: transparent; border: 1px solid var(--border); border-radius: 999px; color: var(--text-secondary); cursor: pointer; transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease }
  .capabilities-modal-close:hover { background: var(--bg-card-hover, var(--bg-secondary)); color: var(--text-primary); border-color: var(--border-light) }
  .capabilities-modal-header { margin-bottom: 1.5rem; padding-right: 2.5rem }
  .capabilities-modal-eyebrow { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--accent); margin: 0 0 0.5rem }
  #capabilities-modal-title { font-size: clamp(1.4rem, 3vw, 1.75rem); font-weight: 800; letter-spacing: -0.02em; margin: 0 0 0.6rem; line-height: 1.2 }
  .capabilities-modal-lead { font-size: 0.95rem; line-height: 1.6; color: var(--text-secondary); margin: 0 }
  .capabilities-modal-groups { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; margin-bottom: 1.75rem }
  .capabilities-group { padding: 1.15rem 1.15rem 1rem; border: 1px solid var(--border); border-radius: 14px; background: color-mix(in srgb, var(--bg-primary) 55%, transparent); transition: border-color 0.2s ease, transform 0.2s ease }
  .capabilities-group:hover { border-color: color-mix(in srgb, var(--accent) 35%, var(--border)); transform: translateY(-2px) }
  .capabilities-group h4 { font-size: 0.95rem; font-weight: 700; margin: 0 0 0.35rem; color: var(--text-primary); display: flex; align-items: center; gap: 0.45rem }
  .capabilities-group h4::before { content: ''; width: 8px; height: 8px; border-radius: 999px; background: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 20%, transparent) }
  .capabilities-group p { font-size: 0.8rem; line-height: 1.55; color: var(--text-muted); margin: 0 0 0.75rem }
  .capabilities-group ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.3rem 0.4rem }
  .capabilities-group li { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.02em; padding: 0.28rem 0.6rem; border-radius: 999px; background: color-mix(in srgb, var(--accent) 9%, transparent); color: var(--text-secondary); border: 1px solid color-mix(in srgb, var(--accent) 14%, var(--border)) }
  .capabilities-modal-cta { display: flex; gap: 0.75rem; flex-wrap: wrap; padding-top: 1.25rem; border-top: 1px solid var(--border) }
  .capabilities-modal-cta .btn { flex: 1 1 auto; min-width: 160px; text-align: center }

  /* Inline grouped layout — used when section is rendered with layout: 'grouped'.
     Reuses the .capabilities-group chip styling from the modal but at section-
     width with a more comfortable card padding and a centered CTA row. */
  .capabilities-grouped { margin-top: 2.5rem }
  .capabilities-grouped-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem }
  .capabilities-group--inline { padding: 1.5rem 1.5rem 1.25rem; border-radius: 16px }
  .capabilities-group--inline h4 { font-size: 1rem; margin-bottom: 0.5rem }
  .capabilities-group--inline p { font-size: 0.85rem; line-height: 1.6; margin-bottom: 1rem }
  .capabilities-group--inline li { font-size: 0.75rem; padding: 0.32rem 0.7rem }
  .capabilities-grouped-cta { display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap; margin-top: 2rem }
  .capabilities-grouped-cta .btn { min-width: 200px; text-align: center }
  @media (max-width: 820px) {
    .capabilities-grouped-grid { grid-template-columns: 1fr; gap: 0.85rem }
    .capabilities-group--inline { padding: 1.25rem 1.25rem 1rem }
    .capabilities-grouped-cta .btn { min-width: 0; flex: 1 1 auto }
  }

  @media (max-width: 640px) {
    .capabilities-modal { padding: 0.75rem }
    .capabilities-modal-panel { padding: 1.5rem 1.15rem 1.35rem; border-radius: 14px }
    .capabilities-modal-groups { grid-template-columns: 1fr; gap: 0.75rem }
    .capabilities-modal-cta { flex-direction: column }
  }
  @media (prefers-reduced-motion: reduce) {
    .capabilities-modal-backdrop, .capabilities-modal-panel { transition: none }
  }
</style>

<script>
  (function () {
    const trigger = document.querySelector<HTMLElement>('[data-capabilities-trigger]');
    const modal = document.getElementById('capabilities-modal');
    if (!trigger || !modal) return;

    // Escape any ancestor stacking context / containing block (transforms, filters,
    // will-change, contain, backdrop-filter on parents can trap a position:fixed
    // descendant inside its section). Re-parenting to <body> guarantees the modal
    // renders above everything, regardless of where the section lives in the tree.
    if (modal.parentElement !== document.body) {
      document.body.appendChild(modal);
    }

    const focusableSelector = 'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';
    let lastFocus: HTMLElement | null = null;

    const open = () => {
      lastFocus = document.activeElement as HTMLElement | null;
      modal.hidden = false;
      requestAnimationFrame(() => modal.classList.add('is-open'));
      document.body.style.overflow = 'hidden';
      const first = modal.querySelector<HTMLElement>(focusableSelector);
      first?.focus();
    };
    const close = () => {
      modal.classList.remove('is-open');
      document.body.style.overflow = '';
      const onEnd = () => {
        modal.hidden = true;
        modal.removeEventListener('transitionend', onEnd);
      };
      modal.addEventListener('transitionend', onEnd);
      setTimeout(() => { if (!modal.hidden && !modal.classList.contains('is-open')) modal.hidden = true; }, 400);
      lastFocus?.focus();
    };

    trigger.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-capabilities-open]');
      if (btn) { e.preventDefault(); open(); }
    });
    modal.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('[data-capabilities-close]')) { e.preventDefault(); close(); }
    });
    document.addEventListener('keydown', (e) => {
      if (modal.hidden) return;
      if (e.key === 'Escape') { e.preventDefault(); close(); return; }
      if (e.key === 'Tab') {
        const focusables = Array.from(modal.querySelectorAll<HTMLElement>(focusableSelector)).filter(el => !el.hasAttribute('disabled'));
        if (!focusables.length) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });
  })();
</script>
