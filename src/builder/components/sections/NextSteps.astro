---
import { site } from '../../lib/brand';
import Icon from '../Icon.astro';

type Step = { num: string; title: string; body: string };
type Aside = {
  label?: string;
  links?: Array<{ iconKey?: string; label: string; href: string }>;
  home?: { label: string; href: string };
};

interface Props {
  /** Eyebrow label above the steps. Defaults to brand's site.nextSteps.sectionLabel. */
  sectionLabel?: string;
  /** Step list override. When omitted, reads from site.nextSteps.steps. */
  steps?: Step[];
  /** Side-panel override. Pass `null` to suppress the aside entirely (forces variant B layout).
   *  When omitted, reads from site.nextSteps.aside. */
  aside?: Aside | null;
  /** Optional container spacing tweak for reuse on pages that already have a hero above. */
  tightTop?: boolean;
}

const ns = site.nextSteps;
const sectionLabel = Astro.props.sectionLabel ?? ns?.sectionLabel ?? 'What happens next';
const steps: Step[] = Astro.props.steps ?? ns?.steps ?? [];
const asideProp = Astro.props.aside;
const aside: Aside | null =
  asideProp === null ? null : (asideProp ?? ns?.aside ?? null);
const hasAside = !!aside && ((aside.links && aside.links.length > 0) || !!aside.home);
const tightTop = Astro.props.tightTop ?? true;
---

{steps.length > 0 && (
  <section
    class="section next-steps"
    data-section-type="next-steps"
    data-section-label="What happens next"
    data-section-variants="A:Panel,B:Centered"
    data-has-aside={hasAside ? 'true' : 'false'}
    style={tightTop ? 'padding-top:0' : undefined}
  >
    <div class="container">
      <div class={'next-steps-panel scale-reveal' + (hasAside ? '' : ' next-steps-panel--solo')}>
        <div class="next-steps-main">
          <span class="next-steps-eyebrow">{sectionLabel}</span>
          <ol class="next-steps-list">
            {steps.map(s => (
              <li class="next-steps-item">
                <span class="next-steps-num">{s.num}</span>
                <div class="next-steps-body">
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>

        {hasAside && aside && (
          <div class="next-steps-aside">
            {aside.label && <span class="next-steps-eyebrow">{aside.label}</span>}
            {aside.links && aside.links.length > 0 && (
              <ul class="next-steps-links">
                {aside.links.map(l => (
                  <li>
                    <a href={l.href} class="next-steps-link">
                      {l.iconKey && (
                        <span class="next-steps-link-icon" aria-hidden="true"><Icon name={l.iconKey} size={20} /></span>
                      )}
                      <span>{l.label}</span>
                      <span class="next-steps-link-arrow" aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
            {aside.home && (
              <a href={aside.home.href} class="btn btn-secondary next-steps-home">{aside.home.label}</a>
            )}
          </div>
        )}
      </div>
    </div>
  </section>
)}

<style is:global>
  .next-steps-panel {
    max-width: 1080px;
    margin: 3rem auto 0;
    padding: 3rem 3rem 2.75rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-light);
    background: linear-gradient(135deg, var(--bg-card), var(--bg-primary));
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  .next-steps-panel--solo { grid-template-columns: 1fr; max-width: 760px; }
  .next-steps-panel::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, var(--accent), var(--accent-hover));
    z-index: 2;
  }
  .next-steps-panel::after {
    content: '';
    position: absolute; inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background: radial-gradient(ellipse 55% 45% at 0% 0%, rgba(var(--accent-rgb),0.10), transparent 60%);
  }
  .next-steps-eyebrow {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }
  .next-steps-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1.25rem; }
  .next-steps-item { display: flex; gap: 1rem; align-items: flex-start; }
  .next-steps-num {
    flex-shrink: 0; width: 38px; height: 38px; border-radius: 50%;
    background: var(--accent-glow);
    border: 1.5px solid rgba(var(--accent-rgb),0.4);
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 0.75rem; font-weight: 800; color: var(--accent); letter-spacing: -0.02em;
  }
  .next-steps-body h3 { font-size: 1rem; font-weight: 700; color: var(--text-primary); margin: 0 0 0.3rem; line-height: 1.3; }
  .next-steps-body p { font-size: 0.9375rem; line-height: 1.6; color: var(--text-secondary); margin: 0; }
  .next-steps-aside {
    padding: 1.75rem;
    border-radius: calc(var(--radius-lg) - 4px);
    background: rgba(var(--accent-rgb),0.03);
    border: 1px solid rgba(var(--accent-rgb),0.12);
  }
  .next-steps-links { list-style: none; padding: 0; margin: 0 0 1.5rem; display: flex; flex-direction: column; gap: 0.25rem; }
  .next-steps-link {
    display: flex; align-items: center; gap: 0.875rem;
    padding: 0.75rem 0.25rem;
    border-bottom: 1px dashed rgba(var(--accent-rgb),0.15);
    color: var(--text-primary); font-weight: 600; font-size: 0.9375rem;
    transition: color var(--transition), gap var(--transition);
  }
  .next-steps-links li:last-child .next-steps-link { border-bottom: none; }
  .next-steps-link:hover { color: var(--accent); gap: 1rem; }
  .next-steps-link-icon {
    width: 32px; height: 32px; border-radius: 8px;
    background: var(--accent-glow); color: var(--accent);
    display: inline-flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    transition: background var(--transition);
  }
  .next-steps-link:hover .next-steps-link-icon { background: rgba(var(--accent-rgb),0.18); }
  .next-steps-link-arrow { margin-left: auto; color: var(--text-muted); transition: transform var(--transition), color var(--transition); }
  .next-steps-link:hover .next-steps-link-arrow { color: var(--accent); transform: translateX(3px); }
  .next-steps-home { width: 100%; }
  @media (max-width: 860px) {
    .next-steps-panel { grid-template-columns: 1fr; gap: 2rem; padding: 2.25rem 1.75rem; }
  }
</style>
