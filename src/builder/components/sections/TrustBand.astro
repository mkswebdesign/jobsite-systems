---
/**
 * Brand-driven trust band — a thin, single-line strip with 3-4 icon+text
 * pills and an optional "Learn more" link. Renders only when the active
 * brand declares `brand.trustBand` in its brand.json. Brands without the
 * field render nothing — the import is cheap and conditional rendering
 * keeps the band brand-specific without forcing every brand to opt in.
 *
 * Used on:
 *   - Home (immediately below the hero) — primary trust framing for
 *     prospective clients arriving cold from search.
 *   - /pricing/ — reduces the "is this risky for my practice?" objection
 *     at the moment-of-purchase scroll.
 *   - /services/lead-forms/ — the page where PHI / form-handling matters
 *     most; the band reinforces the non-PHI-by-design guarantee.
 *
 * Schema (brand.json):
 *   trustBand: {
 *     items: [{ iconKey: "shield" | "lock" | "check" | ..., text: string }],
 *     cta?: { label: string, href: string }
 *   }
 */
import { brand } from '../../lib/brand';
import Icon from '../Icon.astro';

interface Props {
  /** Optional inline override — if provided, takes precedence over brand.json. */
  items?: Array<{ iconKey: string; text: string }>;
  cta?: { label: string; href: string };
}

const tb = (brand as any).trustBand;
const items = Astro.props.items ?? tb?.items ?? [];
const cta = Astro.props.cta ?? tb?.cta ?? null;
---

{items.length > 0 && (
  <section class="trust-band" data-section-type="trust-band" data-section-label="Trust band" data-section-variants="A:Default" aria-label="Trust signals">
    <div class="container trust-band__inner">
      <ul class="trust-band__list" role="list">
        {items.map((it: { iconKey: string; text: string }) => (
          <li class="trust-band__item">
            <span class="trust-band__icon" aria-hidden="true"><Icon name={it.iconKey} size={16} /></span>
            <span class="trust-band__text">{it.text}</span>
          </li>
        ))}
      </ul>
      {cta && (
        <a class="trust-band__cta" href={cta.href}>
          <span>{cta.label}</span>
          <span aria-hidden="true" class="trust-band__cta-arrow">→</span>
        </a>
      )}
    </div>
  </section>
)}

<style is:global>
  /* Trust band — thin, single-line strip with subtle background. Brand-
     accent-tinted on the icon glyphs so the strip reads as part of the
     brand rather than a generic disclaimer. Falls back to flex-wrap on
     narrow viewports so the four-pill row doesn't horizontal-scroll. */
  .trust-band {
    padding: 0.85rem 0;
    background: color-mix(in srgb, var(--accent) 6%, var(--bg-secondary, transparent));
    border-block: 1px solid color-mix(in srgb, var(--accent) 14%, transparent);
  }
  .trust-band__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.6rem 1.6rem;
  }
  .trust-band__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 1.4rem;
  }
  .trust-band__item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-secondary);
    line-height: 1.3;
  }
  .trust-band__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--accent-text, var(--accent));
    flex: none;
  }
  .trust-band__text {
    white-space: nowrap;
  }
  .trust-band__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.55rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent-text, var(--accent));
    text-decoration: none;
    border-radius: 6px;
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .trust-band__cta:hover {
    color: var(--accent-hover, var(--accent));
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }
  .trust-band__cta-arrow {
    transition: transform 0.18s ease;
  }
  .trust-band__cta:hover .trust-band__cta-arrow {
    transform: translateX(2px);
  }

  /* On narrow viewports, allow text to wrap inside each pill (rather than
     the strip horizontal-scrolling). Drop the cta below the list. */
  @media (max-width: 640px) {
    .trust-band__list { gap: 0.5rem 1rem; }
    .trust-band__item { font-size: 0.78rem; }
    .trust-band__text { white-space: normal; }
  }
</style>
