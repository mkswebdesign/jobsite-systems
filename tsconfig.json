{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "workers"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@content/*": ["../arich-source/content/*"]
    },
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false
  }
}
